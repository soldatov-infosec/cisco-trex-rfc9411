+            // The close timer also covers alerts whose ACK never arrives.
+            break;
+        }
+        progress |= before_read != t.session.input_pending();
+        auto &rx = m_flow->m_tcp.m_socket.so_rcv;
+        size_t retained = t.rx_bytes + t.session.input_pending();
+#ifdef TREX_SIM
+        if (tls_invariant_fault == 5) {
+            tls_invariant_fault = -1;
+            retained = size_t(rx.sb_cc) + 1;
+        }
+#endif
+        if (retained > rx.sb_cc) {
+            tls_fail(astf_tls::Failure::TRANSPORT);
+            break;
+        }
+        if (retained < rx.sb_cc) {
+            rx.sb_cc = retained;
+            // Includes ACK callbacks which release TLS output backpressure.
+            // Ensure TCP emits a window update even without new application TX.
+            m_flow->m_tcp.t_flags |= TF_ACKNOW;
+        }
+        // SSL has accepted this entire immutable profile buffer: no write
+        // retry can refer to it now. Nonblocking sends may advance while TCP
+        // retains ciphertext; its fixed slot/byte limits provide backpressure.
+        // Blocking sends also fence ciphertext from preceding nonblocking sends.
+        if (t.plain && t.offset == t.plain->len() &&
+            (get_tx_mode_none_blocking() || (!t.queued && !t.session.pending()))) {
+            t.plain = nullptr;
+            next();
+            progress = true;
+        }
+        if (t.closing && !t.close_done && t.session.sent_close() && !t.queued && !t.session.pending()) {
+            t.close_done = true;
+            if (t.close_timer.is_running()) m_pctx->m_ctx->m_timer_w.timer_stop(&t.close_timer);
+            tcp_udp_close();
+            break;
+        }
+    } while (progress && !blocked && !t.terminal && --budget);
+    if (!t.terminal && !t.close_done && (blocked || (progress && !budget))) {
+        INC_STAT(m_pctx, m_flow->m_tg_id, tcps_tls_yields);
+        m_pctx->m_ctx->m_timer_w.timer_start(&t.work_timer,
+            blocked ? h2_retry_delay(t.tx_retry_shift) : 1);
+    }
+    t.pumping = false;
+    h2_schedule_timer();
+    if (!get_interrupt() && (m_flags & taCONNECTED)) m_api->tx_tcp_output(m_pctx, m_flow);
+}
