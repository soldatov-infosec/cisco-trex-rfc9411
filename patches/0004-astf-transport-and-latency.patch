+                  m_cmd_rx_bytes < m_cmd_rx_bytes_wm))) {
+                tls_fail(astf_tls::Failure::APPLICATION);
+                break;
+            }
+            if (t.session.peer_closed() && (m_flags & taDO_WAIT_FOR_CLOSE)) t.closing = true;
+            if (t.closing && !t.close_done && !t.close_timer.is_running()) {
+                m_pctx->m_ctx->m_timer_w.timer_start(&t.close_timer,
+                    std::max<htw_ticks_t>(1, tw_time_usec_to_ticks(uint64_t(t.close_timeout_ms) * 1000)));
+            }
+            if (t.closing && !t.plain) t.session.shutdown();
+        }
+        if(t.session.failed() && !tls_begin_alert_drain()) break;
+        while (t.queued < tx_limit && t.count < t.buffers.size()) {
+            const uint8_t *wire = nullptr;
+            const size_t available=t.session.peek(&wire);
+            const size_t credit=std::min<size_t>(t.descriptors[0].size() * 2048, tx_limit - t.queued);
+            size_t n=t.http2 ? astf_http2::tx_copy_size(available,credit,t.queued)
+                             : std::min(available,credit);
+            if (!n) break;
+            auto index = (t.head + t.count) % t.buffers.size();
+            CMbufBuffer *b = &t.buffers[index];
+            size_t copied=tls_copy_wire(m_flow->m_tcp.mbuf_socket,*b,wire,n,bool(t.http2));
+            if(copied!=n) {
+                INC_STAT(m_pctx, m_flow->m_tg_id, tcps_nombuf);
+                if(!t.http2 || t.draining_alert) {
+                    tls_fail(astf_tls::Failure::RESOURCE);
+                    t.pumping = false;
+                    return;
+                }
+                blocked=true; // Uncopied ciphertext remains intact in the BIO.
+                if(!copied)break;
+                n=copied;
+            }
+            t.session.consume(n);
+            t.remaining[index] = n;
+            ++t.count;
+            m_q.add_buffer(b);
+            uint32_t add = std::min<uint32_t>(m_api->get_tx_sbspace(m_flow), n);
+            m_api->tx_sbappend(m_flow, add);
+            m_q.subtract_bytes(add);
+            t.queued += n;
+            t.tx_retry_shift=0;
+            progress = true;
+            if(blocked)break;
+        }
+        if(t.draining_alert) {
+            if(!t.session.pending() && !t.queued) tls_fail();
