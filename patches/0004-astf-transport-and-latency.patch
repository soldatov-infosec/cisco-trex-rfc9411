+    // The read call is synchronous; no buffer address is retained by this adapter.
+    static uint8_t *scratch() { static thread_local uint8_t bytes[16384]; return bytes; }
+};
+#endif
+
+CEmulApp::~CEmulApp() {
+    force_stop_timer();
+    close_emul_addon();
+    if (m_udp_rtt_deadline_ns) {
+        INC_UDP_STAT(m_pctx, m_flow->m_tg_id, udps_rtt_aborted);
+    }
+    if (m_http) {
+        const auto &t=*m_http;
+        bool clean=t.http_eof && (!t.transactions || !t.transactions->pending()) && !t.aborted && !m_flow->m_tcp.m_socket.so_error;
+#ifdef TREX_TLS
+        if (m_tls) clean=clean && !m_tls->error_reported && !m_tls->session.failed() &&
+            m_tls->close_done && m_tls->session.peer_closed();
+#endif
+        if (clean && t.parser.done() && !t.http_error && m_http_syn_started && t.http_received &&
+            t.http_first_ns>=m_http_syn_ns && t.http_last_ns>=t.http_first_ns) {
+            auto &tp=m_flow->m_tcp;
+            tcp_latency_add(&tp.t_stat->tcps_ttfb, t.http_first_ns-m_http_syn_ns);
+            tcp_latency_add(&tp.t_stat->tcps_ttlb, t.http_last_ns-m_http_syn_ns);
+            if (tp.t_stat_ex) {
+                tcp_latency_add(&tp.t_stat_ex->tcps_ttfb, t.http_first_ns-m_http_syn_ns);
+                tcp_latency_add(&tp.t_stat_ex->tcps_ttlb, t.http_last_ns-m_http_syn_ns);
+            }
+        } else if (!t.http_error) INC_STAT(m_pctx, m_flow->m_tg_id, tcps_http_aborted);
+        delete m_http;
+    }
+#ifdef TREX_TLS
+    // Commit one sample per successful HTTP/2 connection. Keep response RX
+    // timestamps: FIN, GOAWAY, close_notify and delayed destruction add no time.
+    const astf_http2::Session *h2=m_h2?&m_h2->session:
+        (m_tls && m_tls->http2?m_tls->http2.get():nullptr);
+    bool h2_clean=h2 && (m_h2?(!m_h2->terminal && m_h2->closed):
+        (m_tls && !m_tls->error_reported && !m_tls->session.failed() &&
+         m_tls->close_done && m_tls->session.peer_closed()));
+    uint64_t first=0,last=0;
+    if(h2 && h2_clean && !m_flow->m_tcp.m_socket.so_error && m_http_syn_started &&
+       h2->response_times(first,last) && first>=m_http_syn_ns && last>=first) {
+        for(auto base:{m_flow->m_tcp.t_stat,m_flow->m_tcp.t_stat_ex}) {
+            if(!base)continue;
+            auto stats=static_cast<tcpstat_int_t *>(base);
+            tcp_transaction_add(&stats->tcps_http2_ttfb,first-m_http_syn_ns);
+            tcp_transaction_add(&stats->tcps_http2_ttlb,last-m_http_syn_ns);
+            tcp_latency_add(&stats->tcps_ttfb,first-m_http_syn_ns);
+            tcp_latency_add(&stats->tcps_ttlb,last-m_http_syn_ns);
+        }
+    }
+    if (m_h2) {
+        if(m_h2->work_timer.is_running()) m_pctx->m_ctx->m_timer_w.timer_stop(&m_h2->work_timer);
+        delete m_h2;
+    }
+    tls_stop_timers();
+    if (m_tls) {
+        astf_cost::Probe cost_probe(astf_cost::APP_FREE);
+        delete m_tls;
+    }
+#endif
+}
