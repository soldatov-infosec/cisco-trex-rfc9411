+                t.http2->set_pacing_clock(h2_clock_ns());
+                if(t.session.peer_closed() && !t.http2->eof()) {tls_fail(astf_tls::Failure::APPLICATION);break;}
+                if(t.queued<tx_limit && (t.session.write_retry_pending() || !t.session.pending())) {
+                    const uint8_t *data=nullptr;
+                    size_t nbytes=std::min(t.http2->output(&data,uint64_t(now_sec()*1000000000.0)),t.write_chunk);
+                    if(nbytes) {
+                        INC_STAT(m_pctx,m_flow->m_tg_id,tcps_tls_write_calls);
+                        size_t written=t.session.write(data,nbytes);
+                        if(written) INC_STAT(m_pctx,m_flow->m_tg_id,tcps_tls_write_success);
+                        t.http2->consume(written);
+                        INC_STAT_CNT(m_pctx,m_flow->m_tg_id,tcps_tls_sndbyte,written);
+                        progress|=written!=0;
+                    }
+                }
+                if(t.http2->failed()) {tls_fail(astf_tls::Failure::APPLICATION);break;}
+                if(t.http2->finished()) {force_stop_timer();t.closing=true;}
+            }
