+    if (t.work_timer.is_running()) m_pctx->m_ctx->m_timer_w.timer_stop(&t.work_timer);
+    t.pumping = true;
+    // A small TCP window cannot hold an entire record: preserve partial-read
+    // window credit there. Framing has observed all input even before enable.
+    if(!t.draining_alert) t.session.coalesce_reads(m_flow->m_tcp.m_socket.so_rcv.sb_hiwat >= 18437);
+    unsigned budget = t.work_budget;
+    bool blocked = false;
+    bool progress;
+    do {
+        progress = false;
+        // Batch already available segments, but bound work independently of
+        // the outer SSL budget. A full BIO must be drained before more input.
+        const size_t before_read = t.session.input_pending();
+        if(!t.draining_alert) {
+            unsigned feed_budget = 16;
+            while (t.rx_head && feed_budget--) {
+                auto m = t.rx_head;
+                size_t left = m->data_len - t.rx_offset;
+                astf_rx::Stamp stamp;
+                if(t.rx_times) {
+                    if(!t.rx_times->size()) {tls_fail(astf_tls::Failure::RESOURCE);break;}
+                    left=std::min(left,t.rx_times->front().size);stamp=t.rx_times->front().time;
+                }
+                size_t n = t.session.feed(rte_pktmbuf_mtod(m, uint8_t *) + t.rx_offset, left,stamp);
+                if(n && t.rx_times)t.rx_times->consume(n,stamp);
+                t.rx_offset += n;
+                t.rx_bytes -= n;
+                progress |= n != 0;
+                if (t.rx_offset == m->data_len) {
+                    t.rx_head = m->next;
+                    if (!t.rx_head) t.rx_tail = nullptr;
+                    m->next = nullptr;
+                    rte_pktmbuf_free(m);
+                    t.rx_offset = 0;
+                    progress = true;
+                }
+                // n == 0 is backpressure. ACK/output progress will resume this FIFO.
+                if (!n) break;
+            }
+            if (t.tcp_eof && !t.rx_head && !t.eof_delivered) {
+                t.session.eof();
+                t.eof_delivered = true;
+            }
