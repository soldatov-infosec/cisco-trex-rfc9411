new file mode 100644
--- /dev/null
+++ b/src/44bsd/rx_timestamp.h
@@ -0,0 +1,57 @@
+#ifndef TREX_RX_TIMESTAMP_H
+#define TREX_RX_TIMESTAMP_H
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+namespace astf_rx {
+// First wire byte and latest arrival needed for this byte range. Zero is valid.
+struct Stamp {
+    uint64_t first, last;
+    Stamp(uint64_t a=0,uint64_t b=0):first(a),last(b) {}
+};
+struct Span {
+    size_t size;
+    Stamp time;
+    Span(size_t n,Stamp t):size(n),time(t) {}
+};
+// Allocated only for measured TLS flows. Adjacent equal stamps coalesce;
+// storage follows retained ciphertext, never total connection lifetime.
+class Queue {
+    std::deque<Span> spans;
+    size_t bytes=0;
+public:
+    void append(size_t n,Stamp t) {
+        if(!n)return;
+        if(!spans.empty() && spans.back().time.first==t.first && spans.back().time.last==t.last)
+            spans.back().size+=n;
+        else spans.emplace_back(n,t);
+        bytes+=n;
+    }
+    size_t size() const {return bytes;}
+    const Span &front() const {return spans.front();}
+    bool consume(size_t n,Stamp &t) {
+        if(!n || n>bytes)return false;
+        t=spans.front().time;bytes-=n;
+        while(n) {
+            auto &s=spans.front();size_t used=std::min(n,s.size);
+            t.last=std::max(t.last,s.time.last);s.size-=used;n-=used;
+            if(!s.size)spans.pop_front();
+        }
+        return true;
+    }
+};
+// Keep metadata with the exact bytes selected by the existing overlap policy.
+struct Payload : std::vector<uint8_t> {
+    std::vector<Span> times;
+    void append_times(const Payload &other,size_t skip) {
+        for(const auto &s:other.times) {
+            if(skip>=s.size) {skip-=s.size;continue;}
+            times.emplace_back(s.size-skip,s.time);skip=0;
+        }
+    }
+};
+}
+#endif
