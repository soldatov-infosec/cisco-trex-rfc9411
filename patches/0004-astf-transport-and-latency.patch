+            if (t.session.handshake_can_progress()) t.session.handshake();
+            if (t.session.failed() && !tls_begin_alert_drain()) break;
+        }
+        if (!t.draining_alert && t.session.ready() && !t.started) {
+            force_stop_timer();
+            t.started = true;
+            INC_STAT(m_pctx, m_flow->m_tg_id, tcps_tls_handshakes);
+            if (t.session.resumed()) { INC_STAT(m_pctx, m_flow->m_tg_id, tcps_tls_resumed); }
+            else { INC_STAT(m_pctx, m_flow->m_tg_id, tcps_tls_full_handshakes); }
+            const auto version_index = astf_tls::parameter_index(astf_tls::versions,t.session.negotiated_version());
+            const auto cipher_index = astf_tls::parameter_index(astf_tls::ciphers,t.session.negotiated_cipher());
+            const auto group_index = astf_tls::parameter_index(astf_tls::groups,t.session.negotiated_group());
+            const auto peer_signature_index = astf_tls::parameter_index(astf_tls::signatures,t.session.peer_signature());
+            for (auto base_stats : {m_flow->m_tcp.t_stat,m_flow->m_tcp.t_stat_ex}) {
+                if (!base_stats) continue;
+                auto stats=static_cast<tcpstat_int_t *>(base_stats);
+                ++stats->tcps_tls_version_counts[version_index];
+                ++stats->tcps_tls_cipher_counts[cipher_index];
+                ++stats->tcps_tls_group_counts[group_index];
+                ++stats->tcps_tls_peer_signature_counts[peer_signature_index];
+            }
+            process_cmd(m_program->get_index(m_cmd_index));
+            progress = true;
+        }
