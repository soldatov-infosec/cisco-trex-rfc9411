+/* Allocate only from the existing NUMA mbuf pool. TLS TX descriptor vectors
+ * are reserved once per flow. A depleted pool aborts this flow, not the DP core. */
+static size_t tls_copy_wire(uint8_t socket, CMbufBuffer &buffer, const uint8_t *data, size_t len,
+                            bool partial=false) {
+    astf_cost::Probe cost_probe(astf_cost::WIRE_COPY);
+    const size_t original_len = len;
+    const uint32_t block_size=partial ? 4096 : 2048;
+    buffer.Create(block_size);
+    while (len) {
+        uint16_t n = std::min<size_t>(block_size, len);
+        auto m = tls_alloc_wire(socket, n,partial);
+        if (!m) {
+            if (!partial) buffer.Delete();
+            cost_probe.bytes(partial ? original_len-len : 0);
+            return partial ? original_len-len : 0;
+        }
+        auto dst = rte_pktmbuf_append(m, n);
+        if (!dst) { rte_pktmbuf_free(m); buffer.Delete(); return 0; }
+        memcpy(dst, data, n);
+        CMbufObject object;
+        object.m_type = MO_CONST;
+        object.m_mbuf = m;
+        buffer.Add_mbuf(object);
+        data += n; len -= n;
+    }
+    cost_probe.bytes(original_len);
+    return original_len;
+}
