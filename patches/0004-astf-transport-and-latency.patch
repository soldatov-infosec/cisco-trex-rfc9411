+#ifdef TREX_TLS
+void CEmulAppProgram::prepare_tls_buffers() {
+    if (!m_tls_context) return;
+    // Build transactionally. Never mutate the published map from a DP flow.
+    std::map<CMbufBuffer *, std::vector<uint8_t>> prepared;
+    for (auto &cmd : m_cmds) {
+        if (cmd.m_cmd != tcTX_BUFFER) continue;
+        auto buffer = cmd.u.m_tx_cmd.m_buf;
+        if (prepared.count(buffer)) continue;
+        auto &bytes = prepared[buffer];
+        bytes.resize(buffer->len());
+        uint32_t offset = 0;
+        while (offset < buffer->len()) {
+            CBufMbufRef ref;
+            buffer->get_by_offset(offset, ref);
+            size_t n = std::min<size_t>(ref.get_mbuf_size(), buffer->len() - offset);
+            if (!n) throw std::runtime_error("Empty TLS profile mbuf");
+            memcpy(bytes.data() + offset, rte_pktmbuf_mtod(ref.m_mbuf, const uint8_t *) + ref.m_offset, n);
+            offset += n;
+        }
+    }
+    m_tls_plaintext.swap(prepared);
+}
