diff --git a/src/44bsd/netinet/tcp_latency.h b/src/44bsd/netinet/tcp_latency.h
new file mode 100644
--- /dev/null
+++ b/src/44bsd/netinet/tcp_latency.h
@@ -0,0 +1,62 @@
+/* ASTF connection latency, measured in nanoseconds. */
+#ifndef TREX_TCP_LATENCY_H
+#define TREX_TCP_LATENCY_H
+#include <stdint.h>
+
+struct tcp_latency_stats {
+    uint64_t count, sum_ns, sum_carry, min_ns, max_ns;
+};
+
+static inline void tcp_latency_add(struct tcp_latency_stats *s, uint64_t ns) {
+    if (!s->count || ns < s->min_ns) s->min_ns = ns;
+    if (!s->count || ns > s->max_ns) s->max_ns = ns;
+    ++s->count;
+    uint64_t old = s->sum_ns;
+    s->sum_ns += ns;
+    s->sum_carry += s->sum_ns < old;
+}
+
+static inline struct tcp_latency_stats tcp_latency_merge(
+        struct tcp_latency_stats a, struct tcp_latency_stats b) {
+    if (!a.count) return b;
+    if (!b.count) return a;
+    a.count += b.count;
+    uint64_t old = a.sum_ns;
+    a.sum_ns += b.sum_ns;
+    a.sum_carry += b.sum_carry + (a.sum_ns < old);
+    if (b.min_ns < a.min_ns) a.min_ns = b.min_ns;
+    if (b.max_ns > a.max_ns) a.max_ns = b.max_ns;
+    return a;
+}
+static inline double tcp_latency_average_ns(struct tcp_latency_stats s) {
+    return s.count ? ((double)s.sum_carry * 18446744073709551616.0 + (double)s.sum_ns) / s.count : 0;
+}
+#define TCP_TXN_BUCKETS 32
+struct tcp_transaction_latency {
+    struct tcp_latency_stats values;
+    uint64_t buckets[TCP_TXN_BUCKETS];
+};
+static inline void tcp_transaction_add(struct tcp_transaction_latency *s, uint64_t ns) {
+    tcp_latency_add(&s->values,ns);
+    uint64_t us=ns/1000 + (ns%1000!=0), bound=1;
+    unsigned i=0;
+    while (i+1<TCP_TXN_BUCKETS && us>bound) { ++i; bound<<=1; }
+    ++s->buckets[i];
+}
+/* Approximate percentile: bucket upper bound, capped at observed maximum.
+ * Bucket 31 includes all remaining values. This is not an exact quantile. */
+static inline double tcp_transaction_percentile_ms(const struct tcp_transaction_latency *s, unsigned percent) {
+    uint64_t count=s->values.count;
+    if (!count) return 0;
+    uint64_t rank=(count/100)*percent + ((count%100)*percent+99)/100, seen=0;
+    for (unsigned i=0;i<TCP_TXN_BUCKETS;++i) {
+        seen+=s->buckets[i];
+        if (seen>=rank) {
+            uint64_t upper=i==31 ? s->values.max_ns : (UINT64_C(1)<<i)*1000;
+            if (upper>s->values.max_ns) upper=s->values.max_ns;
+            return (double)upper/1e6;
+        }
+    }
+    return (double)s->values.max_ns/1e6;
+}
+#endif
