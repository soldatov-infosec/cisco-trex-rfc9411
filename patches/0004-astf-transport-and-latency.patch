+void CEmulApp::http_syn() {
+    // Program metadata exists before TCP connects and before the TLS flow is
+    // allocated. Retransmitted SYNs must retain the first timestamp (even zero).
+    if (!m_http_syn_started && m_program && (m_program->m_http.enabled || m_program->m_http2.enabled)) {
+        m_http_syn_ns=uint64_t(now_sec()*1000000000.0);
+        m_http_syn_started=true;
+    }
+}
+
+bool CEmulApp::http_event(void *owner, bool complete) {
+    auto app=static_cast<CEmulApp *>(owner);
+    auto &h=*app->m_http;
+    if (!h.transactions) return true;
+    if (!complete) return h.transactions->first(h.now_ns);
+    uint64_t first,last;
+    // For close-delimited bodies EOF can arrive later than the last data byte.
+    if (!h.transactions->complete(h.http_last_ns,first,last)) return false;
+    auto &tp=app->m_flow->m_tcp;
+    tcp_transaction_add(&tp.t_stat->tcps_http_req_ttfb,first);
+    tcp_transaction_add(&tp.t_stat->tcps_http_req_ttlb,last);
+    if (tp.t_stat_ex) {
+        tcp_transaction_add(&tp.t_stat_ex->tcps_http_req_ttfb,first);
+        tcp_transaction_add(&tp.t_stat_ex->tcps_http_req_ttlb,last);
+    }
+    return true;
+}
+
+bool CEmulApp::http_rx(const uint8_t *data, size_t len, bool eof) {
+    if (!m_http) return true;
+    auto &t=*m_http;
+    t.now_ns=m_rx_time.first;
+    if (len) {
+        t.http_last_ns=std::max(t.http_last_ns,m_rx_time.last);
+        if (!t.http_received) { t.http_first_ns=m_rx_time.first; t.http_received=true; }
+    }
+    uint32_t before=t.parser.completed();
+    bool ok=eof ? t.parser.eof() : t.parser.feed(data,len);
+    if (eof) t.http_eof=true;
+    INC_STAT_CNT(m_pctx, m_flow->m_tg_id, tcps_http_responses, t.parser.completed()-before);
+    if (!ok && !t.http_error) {
+        t.http_error=true;
+        INC_STAT(m_pctx, m_flow->m_tg_id, tcps_http_errors);
+        if (t.parser.failure()==astf_http::Error::STATUS) {
+            INC_STAT(m_pctx, m_flow->m_tg_id, tcps_http_bad_status);
+        } else if (t.parser.failure()==astf_http::Error::TRUNCATED) {
+            INC_STAT(m_pctx, m_flow->m_tg_id, tcps_http_truncated);
+        } else if (t.parser.failure()==astf_http::Error::CONTENT) {
+            INC_STAT(m_pctx, m_flow->m_tg_id, tcps_http_bad_content);
+        } else if (t.parser.failure()==astf_http::Error::TRANSACTION) {
+            INC_STAT(m_pctx, m_flow->m_tg_id, tcps_http_transaction_errors);
+        } else {
+            INC_STAT(m_pctx, m_flow->m_tg_id, tcps_http_framing);
+        }
+    }
+    return ok;
+}
+
+bool CEmulApp::needs_rx_timestamps() const {
+    return m_program && (m_program->m_http.enabled ||
+           (m_program->m_http2.enabled && !m_program->m_http2.server));
+}
+bool CEmulApp::needs_rx_payload() const {
+#ifdef TREX_TLS
+    if (m_tls || m_h2) return true;
+#endif
+    return m_http != nullptr;
+}
+
+void CEmulApp::payload_fail(bool resource) {
+#ifdef TREX_TLS
+    if (m_h2) {h2_fail();return;}
+    if (m_tls) { tls_fail(resource ? astf_tls::Failure::RESOURCE : astf_tls::Failure::TRANSPORT); return; }
+#endif
+    if (m_http) m_http->aborted=true;
+    force_stop_timer();
+    set_disconnect(true);
+}
+
+void CEmulApp::rx_reassembled(const uint8_t *data, size_t len) {
+#ifdef TREX_TLS
+    if (m_tls) { tls_rx_reassembled(data,len); return; }
+    if (m_h2) {
+        m_flow->m_tcp.m_socket.so_rcv.sb_cc+=len;
+        h2_rx(data,len);m_api->rx_drain(m_flow);h2_pump();return;
+    }
+#endif
+    // Feed contiguous plaintext directly; no additional mbuf allocation/copy.
+    if (m_http && !m_http->aborted && !http_rx(data,len)) { payload_fail(false); return; }
+    m_flow->m_tcp.m_socket.so_rcv.sb_cc += len;
+    if (get_rx_enabled() && !(m_http && (m_http->aborted || m_http->http_error))) {
+        m_cmd_rx_bytes += m_api->rx_drain(m_flow);
+        if (m_state==te_WAIT_RX) check_rx_condition();
+    }
+}
+
+void so_rx_timestamp(struct socket *so) {
+    auto app=reinterpret_cast<tcp_socket *>(so)->m_app;
+    if(app && app->needs_rx_timestamps()) {
+        uint64_t now=uint64_t(now_sec()*1000000000.0);
+        app->m_rx_time=astf_rx::Stamp(now,now);
+    }
+}
+
+void so_http_syn(struct socket *so) {
+    auto app=reinterpret_cast<tcp_socket *>(so)->m_app;
+    if (app) app->http_syn();
+}
+
+int so_requires_tls_ack_output(struct socket *so) {
+#ifdef TREX_TLS
+    auto app = reinterpret_cast<tcp_socket *>(so)->m_app;
+    return app && (app->is_tls() || app->m_h2);
+#else
+    return 0;
+#endif
+}
