+                (t.session.write_retry_pending() || !t.session.pending())) {
+                size_t nbytes = std::min<size_t>(t.plain->len() - t.offset, t.write_chunk);
+                INC_STAT(m_pctx, m_flow->m_tg_id, tcps_tls_write_calls);
+                size_t written = t.session.write(t.plain_data + t.offset, nbytes);
+                if (written) INC_STAT(m_pctx, m_flow->m_tg_id, tcps_tls_write_success);
+                t.offset += written;
+                INC_STAT_CNT(m_pctx, m_flow->m_tg_id, tcps_tls_sndbyte, written);
+                progress |= written != 0;
+            }
+            if (t.session.peer_closed() &&
+                ((t.plain && t.offset < t.plain->len() && !t.session.can_write()) ||
