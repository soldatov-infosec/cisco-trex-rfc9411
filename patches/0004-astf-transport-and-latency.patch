+        // plaintext record, its AEAD overhead and small control records.
+        // Further ciphertext stays in the BIO until ACKs release TX storage.
+        const uint32_t tx_limit=t.http2 ? std::min<uint32_t>(18432,h2_tx_limit(m_flow->m_tcp)) : 65536;
+        if (t.started && !t.draining_alert) {
+            size_t n = t.session.read_can_progress() ? t.session.read(t.scratch(), 16384) : 0;
+            if (n) {
+                const auto saved=m_rx_time;
+                if(t.rx_times)m_rx_time=t.session.plaintext_time();
+                if (t.http2)t.http2->set_pacing_clock(h2_clock_ns());
+                if (t.http2 && !t.http2->input(t.scratch(),n,m_rx_time.first,m_rx_time.last)) {
+                    m_rx_time=saved;
+                    tls_fail(astf_tls::Failure::APPLICATION); break;
+                }
+                if (m_http && !http_rx(t.scratch(), n)) { m_rx_time=saved;tls_fail(astf_tls::Failure::APPLICATION); break; }
+                m_rx_time=saved;
+                INC_STAT_CNT(m_pctx, m_flow->m_tg_id, tcps_tls_rcvbyte, n);
+                /* TCP counts ciphertext; ASTF receive watermarks count plaintext. */
+                if (get_rx_enabled()) {
+                    m_cmd_rx_bytes += n;
+                    if (m_state == te_WAIT_RX) check_rx_condition();
+                }
+                progress = true;
+            }
+            if (m_http && t.session.peer_closed() && !m_http->http_eof && !http_rx(nullptr,0,true)) {
+                tls_fail(astf_tls::Failure::APPLICATION); break;
+            }
