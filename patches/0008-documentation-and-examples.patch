+++ b/scripts/astf/tls_openssl3_compat.cnf
@@ -0,0 +1,11 @@
+# Optional compatibility policy for migrating an OpenSSL 3.0 default-provider
+# workload to a newer OpenSSL. Keeps classical groups and X25519 preference.
+# Select explicitly through OPENSSL_CONF when starting TRex. This file is not
+# a replacement for a site's custom provider/FIPS policy; merge that policy.
+openssl_conf = initialization
+[initialization]
+ssl_conf = tls_configuration
+[tls_configuration]
+system_default = classical_groups
+[classical_groups]
+Groups = X25519:P-256:X448:P-521:P-384:ffdhe2048:ffdhe3072:ffdhe4096:ffdhe6144:ffdhe8192
diff --git a/scripts/astf/udp_imix_rtt.py b/scripts/astf/udp_imix_rtt.py
new file mode 100644
--- /dev/null
+++ b/scripts/astf/udp_imix_rtt.py
@@ -0,0 +1,86 @@
+from trex.astf.api import *
+import argparse
+
+UDP_REQ_BASE = 'x'
+UDP_RESP_BASE = 'y'
+FCS = 4
+ETHER_HEADER = 14
+IP_HEADER = 20
+UDP_HEADER = 8
+FRAME_HEADERS = FCS + ETHER_HEADER + IP_HEADER + UDP_HEADER
+
+
+class Prof1():
+    def __init__(self):
+        pass  # tunables
+
+    def create_profile(self, ramp_up, frame_size, delay, flow_size, timeout_ms):
+        if not 64 <= frame_size <= 1518:
+            raise ValueError("frame_size_b must be 64..1518 for untagged IPv4/MTU 1500")
+        if flow_size < 2 or flow_size % 2:
+            raise ValueError("flow_size must be positive and even (request/response pairs)")
+
+        # client commands
+        udp_req = UDP_REQ_BASE * (frame_size - FRAME_HEADERS)
+        prog_c = ASTFProgram(stream=False)
+        for i in range(0, int(flow_size / 2)):
+            prog_c.udp_request(udp_req, timeout_ms=timeout_ms)
+
+        udp_resp = UDP_RESP_BASE * (frame_size - FRAME_HEADERS)
+        prog_s = ASTFProgram(stream=False)
+        for i in range(0, int(flow_size / 2)):
+            prog_s.recv_msg(1)
+            if delay: prog_s.delay(delay)
+            prog_s.send_msg(udp_resp)
+
+        # ip generator
+        ip_gen_c = ASTFIPGenDist(ip_range=["10.0.0.1", "10.0.255.199"], distribution="rand")
+        ip_gen_s = ASTFIPGenDist(ip_range=["48.0.0.1", "48.1.255.199"], distribution="rand")
+        ip_gen = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset="1.0.0.0"),
+                           dist_client=ip_gen_c,
+                           dist_server=ip_gen_s)
+
+        # template
+        assoc = ASTFAssociationRule(port=53)
+        temp_c = ASTFTCPClientTemplate(program=prog_c, ip_gen=ip_gen, port=53)
+        temp_s = ASTFTCPServerTemplate(program=prog_s, assoc=assoc)
+        template = ASTFTemplate(client_template=temp_c, server_template=temp_s, tg_name="udp_rtt")
+        # UDP does not use the TCP socket buffer settings.
+        c_glob_info = ASTFGlobalInfo()
+        if ramp_up: c_glob_info.scheduler.rampup_sec = ramp_up
+        s_glob_info = ASTFGlobalInfo()
+        # profile
+        profile = ASTFProfile(default_ip_gen=ip_gen,
+                              default_c_glob_info=c_glob_info,
+                              default_s_glob_info=s_glob_info,
+                              templates=template)
+        return profile
+
+    def get_profile(self, tunables, **kwargs):
+        parser = argparse.ArgumentParser(description='Argparser for {}'.format(os.path.basename(__file__)),
+                                         formatter_class=argparse.ArgumentDefaultsHelpFormatter)
+        parser.add_argument('--frame_size_b',
+                            type=int,
+                            default=64,
+                            help='Frame size with FCS, bytes')
+        parser.add_argument('--delay',
+                            type=int,
+                            default=None,
+                            help='Server response delay (usec)')
+        parser.add_argument('--flow_size',
+                            type=int,
+                            default=2,
+                            help='Flow size (packets)')
+        parser.add_argument('--ramp_up',
+                            type=int,
+                            default=0,
+                            help='Ramp up period (sec)')
+        parser.add_argument("--timeout_ms", type=int, default=1000, help="UDP response deadline (ms)")
+        args, unknown = parser.parse_known_args(tunables)
+        if unknown:
+            raise Exception('unrecognized arguments {0}\n{1}'.format(unknown, parser.format_usage()))
+        return self.create_profile(args.ramp_up, args.frame_size_b, args.delay, args.flow_size, args.timeout_ms)
+
+
+def register():
+    return Prof1()
