@@ -0,0 +1,63 @@
+"""Native ASTF TLS. Paths are local to the TRex server (not the API client)."""
+import argparse
+from trex.astf.api import *
+
+
+class Profile:
+    def get_profile(self, tunables, **kwargs):
+        parser = argparse.ArgumentParser(description=__doc__)
+        parser.add_argument('--version', choices=['1.2', '1.3'], default='1.3')
+        parser.add_argument('--cert', default='/tmp/trex-cert.pem')
+        parser.add_argument('--key', default='/tmp/trex-key.pem')
+        parser.add_argument('--ca', default='/tmp/trex-cert.pem')
+        parser.add_argument('--psk', help='16..64 bytes encoded as hex; lab traffic only')
+        parser.add_argument('--resumption', action='store_true', help='Enable certificate session tickets and bounded client cache')
+        parser.add_argument('--h2', action='store_true', help='Scripted single-stream HTTP/2 exchange between TRex endpoints')
+        args = parser.parse_args(tunables)
+        c = dict(version=args.version, resumption=args.resumption, alpn='h2' if args.h2 else 'http/1.1')
+        s = dict(c)
+        if args.psk:
+            c.update(psk_identity='trex', psk_hex=args.psk)
+            s.update(psk_identity='trex', psk_hex=args.psk)
+        else:
+            c.update(sni='localhost', ca=args.ca)
+            s.update(cert=args.cert, key=args.key)
+        client = ASTFProgram(tls=c)
+        server = ASTFProgram(side='s', tls=s)
+        if args.h2:
+            def frame(kind, flags, stream, payload=b''):
+                return len(payload).to_bytes(3, 'big') + bytes([kind, flags]) + stream.to_bytes(4, 'big') + payload
+            settings = frame(4, 0, 0)
+            ack = frame(4, 1, 0)
+            preface = b'PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n' + settings
+            # HPACK static indices: GET, https, /. Literal :authority=localhost.
+            headers = frame(1, 5, 1, b'\x82\x87\x84\x01\x09localhost')
+            response = frame(1, 4, 1, b'\x88') + frame(0, 1, 1, b'hello\n')
+            client.send(preface)
+            client.recv(len(settings) + len(ack))
+            client.send(ack + headers)
+            client.recv(len(response))
+            server.recv(len(preface))
+            server.send(settings + ack)
+            server.recv(len(ack) + len(headers))
+            server.send(response)
+        else:
+            request = b'GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n'
+            response = b'HTTP/1.1 200 OK\r\nContent-Length: 6\r\nConnection: close\r\n\r\nhello\n'
+            client.send(request)
+            client.recv(len(response))
+            server.recv(len(request))
+            server.send(response)
+        client.add_stats('A', 1)
+        server.add_stats('A', 1)
+        ip_gen = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset='1.0.0.0'),
+                          dist_client=ASTFIPGenDist(ip_range=['16.0.0.1', '16.0.0.254'], distribution='seq'),
+                          dist_server=ASTFIPGenDist(ip_range=['48.0.0.1', '48.0.0.254'], distribution='seq'))
+        template = ASTFTemplate(
+            client_template=ASTFTCPClientTemplate(program=client, ip_gen=ip_gen, port=443, cps=1),
+            server_template=ASTFTCPServerTemplate(program=server, assoc=ASTFAssociationRule(port=443)))
+        return ASTFProfile(default_ip_gen=ip_gen, templates=template)
+
+
+def register():
+    return Profile()
