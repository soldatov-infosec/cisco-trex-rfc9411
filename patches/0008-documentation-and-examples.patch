+++ b/scripts/astf/https_verified.py
@@ -0,0 +1,52 @@
+"""TLS policy, optional mTLS and validated HTTP/1.1 with SYN-based latency."""
+import argparse
+from trex.astf.api import *
+
+class Profile:
+    def get_profile(self, tunables, **kwargs):
+        parser = argparse.ArgumentParser(description=__doc__)
+        parser.add_argument('--version', choices=['1.2','1.3'], default='1.3')
+        parser.add_argument('--cert', required=True)
+        parser.add_argument('--key', required=True)
+        parser.add_argument('--ca', required=True)
+        parser.add_argument('--sni', default='localhost')
+        parser.add_argument('--client-cert')
+        parser.add_argument('--client-key')
+        parser.add_argument('--client-ca')
+        parser.add_argument('--cipher-suite')
+        parser.add_argument('--groups', nargs='+')
+        parser.add_argument('--signature-algorithms', nargs='+')
+        parser.add_argument('--responses', type=int, default=10)
+        parser.add_argument('--body-size', type=int, default=16384)
+        args=parser.parse_args(tunables)
+        if not 1 <= args.responses <= 1000000 or not 0 <= args.body_size <= 1048576:
+            parser.error('responses must be 1..1000000; body-size must be 0..1048576')
+        mtls=[args.client_cert,args.client_key,args.client_ca]
+        if any(mtls) and not all(mtls):
+            parser.error('mTLS needs --client-cert, --client-key and --client-ca')
+        policy=dict(version=args.version, resumption=False)
+        for name in ('cipher_suite','groups','signature_algorithms'):
+            value=getattr(args,name)
+            if value is not None: policy[name]=value
+        ct=dict(policy,sni=args.sni,ca=args.ca)
+        st=dict(policy,cert=args.cert,key=args.key)
+        if all(mtls):
+            ct.update(cert=args.client_cert,key=args.client_key)
+            st.update(require_client_cert=True,ca=args.client_ca)
+        client=ASTFProgram(tls=ct,http=dict(responses=args.responses,expected_status=200,transactions=True,**({'body_contains':'x'} if args.body_size else {})))
+        server=ASTFProgram(side='s',tls=st)
+        request=('GET / HTTP/1.1\r\nHost: '+args.sni+'\r\n\r\n').encode('ascii')
+        response=('HTTP/1.1 200 OK\r\nContent-Length: %d\r\n\r\n' % args.body_size).encode('ascii')+b'x'*args.body_size
+        client.set_var('n',args.responses); client.set_label('request')
+        client.http_request_start(); client.send(request); client.recv(len(response)); client.jmp_nz('n','request')
+        server.set_var('n',args.responses); server.set_label('response')
+        server.recv(len(request)); server.send(response); server.jmp_nz('n','response')
+        ip=ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset='1.0.0.0'),
+                    dist_client=ASTFIPGenDist(ip_range=['16.0.0.1','16.0.0.254'],distribution='seq'),
+                    dist_server=ASTFIPGenDist(ip_range=['48.0.0.1','48.0.0.254'],distribution='seq'))
+        template=ASTFTemplate(client_template=ASTFTCPClientTemplate(program=client,ip_gen=ip,port=443,cps=1),
+                              server_template=ASTFTCPServerTemplate(program=server,assoc=ASTFAssociationRule(port=443)))
+        return ASTFProfile(default_ip_gen=ip,templates=template)
+
+def register():
+    return Profile()
diff --git a/scripts/astf/tcp_https_16KB_ecdsa.py b/scripts/astf/tcp_https_16KB_ecdsa.py
new file mode 100644
--- /dev/null
+++ b/scripts/astf/tcp_https_16KB_ecdsa.py
@@ -0,0 +1,143 @@
+"""TLS 1.3 throughput profile for native TLS v4.1; ECDSA lab certificate defaults.
+Certificate paths refer to the TRex server filesystem.
+"""
+# Direct execution delegates before importing the ASTF API. The runner finds it.
+if __name__ == '__main__':
+    import sys
+    from pathlib import Path
+    from run_https_stats import main
+    sys.argv[1:1] = ['--profile', str(Path(__file__).resolve())]
+    sys.exit(main())
+
+from trex.astf.api import *
+import argparse
+import os
+
+
+class Prof1():
+    def __init__(self):
+        self.p1_src_start_ip = '16.0.0.1'
+        self.p1_src_end_ip = '16.0.255.199'
+
+        self.p1_dst_start_ip = '48.0.0.1'
+        self.p1_dst_end_ip = '48.1.255.199'
+
+        self.http_req = ('GET /index.html HTTP/1.1\r\n' \
+                         'Host: {host}\r\n' \
+                         'Connection: Keep-Alive\r\n' \
+                         'User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 5.1; SV1; .NET CLR 1.1.4322; .NET CLR 2.0.50727)\r\n' \
+                         'Accept: */*\r\n' \
+                         'Accept-Language: en-us\r\n' \
+                         'Accept-Encoding: gzip, deflate, compress\r\n' \
+                         '\r\n'
+                         .format(host=self.p1_dst_start_ip))
+
+        self.http_response_template = 'HTTP/1.1 200 OK\r\n' \
+                                      'Server: Microsoft-IIS/6.0\r\n' \
+                                      'Content-Type: text/html\r\n' \
+                                      'Content-Length: {0}\r\n' \
+                                      '\r\n' \
+                                      '<html><pre>{1}</pre></html>'
+
+        self.response_body_tags_bytes = 24
+
+
+    def create_profile(self, resp_size, delay, flow_size, ramp_up, args):
+
+        http_response = self.http_response_template.format(resp_size, '*' * ( resp_size - self.response_body_tags_bytes ))
+        client_tls = dict(version=args.tls_version, alpn='http/1.1',
+                          sni=args.sni, ca=args.ca, verify=True,
+                          resumption=False, cipher_suite=args.cipher_suite)
+        server_tls = dict(version=args.tls_version, alpn='http/1.1',
+                          cert=args.cert, key=args.key,
+                          resumption=False, cipher_suite=args.cipher_suite)
+        # One TLS session carries all flow_size HTTP transactions.
+        # client commands
+        prog_c = ASTFProgram(tls=client_tls)
+        prog_c.set_var("i", flow_size)
+        prog_c.set_label("a:")
+        prog_c.send(self.http_req)
+        prog_c.recv(len(http_response))
+        prog_c.jmp_nz("i", "a:")
+        # implicit  close
+
+        # server commands
+        prog_s = ASTFProgram(side='s', tls=server_tls)
+        prog_s.set_var("i", flow_size)
+        prog_s.set_label("a:")
+        prog_s.recv(len(self.http_req))
+        if delay: prog_s.delay(delay)
+        prog_s.send(http_response)
+        prog_s.jmp_nz("i", "a:")
+        prog_s.wait_for_peer_close()
+
+        # ip generator
+        ip_gen_c = ASTFIPGenDist(ip_range=[self.p1_src_start_ip, self.p1_src_end_ip], distribution="rand")
+        ip_gen_s = ASTFIPGenDist(ip_range=[self.p1_dst_start_ip, self.p1_dst_end_ip], distribution="rand")
+        ip_gen = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset="1.0.0.0"),
+                           dist_client=ip_gen_c,
+                           dist_server=ip_gen_s)
+
+        # template
+        temp_c = ASTFTCPClientTemplate(program=prog_c, ip_gen=ip_gen, port=443, cps=1)
+        temp_s = ASTFTCPServerTemplate(program=prog_s, assoc=ASTFAssociationRule(port=443))
+        template = ASTFTemplate(client_template=temp_c, server_template=temp_s)
+
+        # Set rx/tx buffer to 64K. TCP window size also will be 64K
+        c_glob_info = ASTFGlobalInfo()
+        c_glob_info.tcp.rxbufsize = 65535
+        c_glob_info.tcp.txbufsize = 65535
+        if ramp_up: c_glob_info.scheduler.rampup_sec = ramp_up
+        s_glob_info = ASTFGlobalInfo()
+        s_glob_info.tcp.rxbufsize = 65535
+        s_glob_info.tcp.txbufsize = 65535
+
+        # profile
+        return ASTFProfile(default_ip_gen=ip_gen,
+                           default_c_glob_info=c_glob_info,
+                           default_s_glob_info=s_glob_info,
+                           templates=template)
+
+    def get_profile(self, tunables, **kwargs):
+        parser = argparse.ArgumentParser(description='Argparser for {}'.format(os.path.basename(__file__)), 
+                                         formatter_class=argparse.ArgumentDefaultsHelpFormatter)
+        parser.add_argument('--response_size_kb',
+                            type=int,
+                            default=16,
+                            help='The response size in KB')
+        parser.add_argument('--delay',
+                            type=int,
+                            default=None,
+                            help='Server response delay (usec)')
+        parser.add_argument('--flow_size',
+                            type=int,
+                            default=10,
+                            help='Flow size (transactions)')
+        parser.add_argument('--ramp_up',
+                            type=int,
+                            default=0,
+                            help='Ramp up period (sec)')
+        parser.add_argument('--tls_version', choices=['1.3'], default='1.3')
+        parser.add_argument('--cipher_suite', choices=['TLS_AES_128_GCM_SHA256', 'TLS_AES_256_GCM_SHA384', 'TLS_CHACHA20_POLY1305_SHA256'], default='TLS_AES_128_GCM_SHA256')
+        parser.add_argument('--cert', default='/tmp/trex-ecdsa/cert.pem')
+        parser.add_argument('--key', default='/tmp/trex-ecdsa/key.pem')
+        parser.add_argument('--ca', default='/tmp/trex-ecdsa/cert.pem')
+        parser.add_argument('--sni', default='localhost', help='Must match certificate SAN')
+        parser.add_argument('--resumption', action='store_true',
+                            help='Rejected: this benchmark requires full handshakes')
+        args, unknown = parser.parse_known_args(tunables)
+        if args.resumption:
+            parser.error('This full-handshake profile disables resumption (RFC 9411)')
+        if unknown:
+            raise Exception('unrecognized arguments {0}\n{1}'.format(unknown, parser.format_usage()))
+        if args.response_size_kb < 1 or args.flow_size < 1:
+            parser.error('response_size_kb and flow_size must be positive')
+        if args.ramp_up < 0 or (args.delay is not None and args.delay < 0):
+            parser.error('delay and ramp_up must be nonnegative')
+        resp_size = args.response_size_kb * 1024
+        return self.create_profile(resp_size, args.delay, args.flow_size, args.ramp_up, args)
+
+
+def register():
+    return Prof1()
+
diff --git a/scripts/astf/tls_openssl3_compat.cnf b/scripts/astf/tls_openssl3_compat.cnf
