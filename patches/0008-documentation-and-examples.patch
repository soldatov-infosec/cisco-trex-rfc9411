@@ -0,0 +1,29 @@
+"""Validated HTTP/1.1 over ordinary TCP, with SYN-based TTFB/TTLB."""
+import argparse
+from trex.astf.api import *
+
+class Profile:
+    def get_profile(self, tunables, **kwargs):
+        parser=argparse.ArgumentParser(description=__doc__)
+        parser.add_argument('--responses',type=int,default=10)
+        parser.add_argument('--body-size',type=int,default=16384)
+        args=parser.parse_args(tunables)
+        if not 1<=args.responses<=1000000 or not 0<=args.body_size<=1048576:
+            parser.error('responses must be 1..1000000; body-size must be 0..1048576')
+        c=ASTFProgram(http={'responses':args.responses,'expected_status':200,'transactions':True,**({'body_contains':'x'} if args.body_size else {})})
+        s=ASTFProgram(side='s')
+        request=b'GET / HTTP/1.1\r\nHost: localhost\r\n\r\n'
+        response=('HTTP/1.1 200 OK\r\nContent-Length: %d\r\n\r\n' % args.body_size).encode('ascii')+b'x'*args.body_size
+        c.set_var('n',args.responses); c.set_label('request')
+        c.http_request_start(); c.send(request); c.recv(len(response)); c.jmp_nz('n','request')
+        s.set_var('n',args.responses); s.set_label('response')
+        s.recv(len(request)); s.send(response); s.jmp_nz('n','response')
+        ip=ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset='1.0.0.0'),
+                    dist_client=ASTFIPGenDist(ip_range=['16.0.0.1','16.0.0.254'],distribution='seq'),
+                    dist_server=ASTFIPGenDist(ip_range=['48.0.0.1','48.0.0.254'],distribution='seq'))
+        template=ASTFTemplate(client_template=ASTFTCPClientTemplate(program=c,ip_gen=ip,port=80,cps=1),
+                              server_template=ASTFTCPServerTemplate(program=s,assoc=ASTFAssociationRule(port=80)))
+        return ASTFProfile(default_ip_gen=ip,templates=template)
+
+def register():
+    return Profile()
