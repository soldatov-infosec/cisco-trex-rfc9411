new file mode 100644
--- /dev/null
+++ b/src/astf/astf_cost_metrics.h
@@ -0,0 +1,172 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef TREX_ASTF_COST_METRICS_H
+#define TREX_ASTF_COST_METRICS_H
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+// One DP writer, concurrent CP readers. Independent relaxed counters are not
+// a transactional snapshot. No heap allocations or locked RMW in probes.
+namespace astf_cost {
+enum Metric { FLOW_CREATE_C, FLOW_CREATE_S, FLOW_FREE_C, FLOW_FREE_S,
+    HANDSHAKE_C, HANDSHAKE_S, READ_C, READ_S, WRITE_C, WRITE_S,
+    FEED_C, FEED_S, SHUTDOWN_C, SHUTDOWN_S, WIRE_COPY, MBUF_ALLOC,
+    APP_CREATE, APP_FREE, PUMP, RX_BATCH, HS_RESULT_C, HS_RESULT_S,
+    HS_POST_C, HS_POST_S, HS_SSL_C, HS_SSL_S,
+    HS_STATE_BASE, COUNT = HS_STATE_BASE + 128 };
+inline std::string name(unsigned i) {
+    static const char *names[] = {"flow_create_client", "flow_create_server",
+        "flow_free_client", "flow_free_server", "handshake_client", "handshake_server",
+        "read_client", "read_server", "write_client", "write_server",
+        "feed_client", "feed_server", "shutdown_client", "shutdown_server",
+        "wire_copy", "mbuf_alloc", "app_create", "app_free", "pump", "rx_batch",
+        "handshake_result_client", "handshake_result_server",
+        "handshake_post_client", "handshake_post_server", "handshake_ssl_client", "handshake_ssl_server"};
+    static_assert(sizeof(names)/sizeof(names[0]) == HS_STATE_BASE, "metric names");
+    if (i < HS_STATE_BASE) return names[i];
+    unsigned state = (i-HS_STATE_BASE) % 64;
+    return std::string("handshake_state_") + ((i-HS_STATE_BASE)/64 ? "server_" : "client_") + std::to_string(state);
+}
+struct Snapshot {
+    uint64_t calls, bytes, samples, sampled_ns, max_sampled_ns;
+    std::array<uint64_t, 32> histogram;
+};
+// First successful negotiation on each side; immutable after release publication.
+// Later differing tuples are counted instead of silently overwriting evidence.
+struct Negotiation {
+    uint32_t version=0, cipher=0, group=0, signature=0, signature_type=0;
+    char group_name[80]={0};
+    bool operator==(const Negotiation &o) const {
+        return version==o.version && cipher==o.cipher && group==o.group && signature==o.signature && signature_type==o.signature_type;
+    }
+};
+class Metrics {
+    struct Counter {
+        std::atomic<uint64_t> calls{0}, bytes{0}, samples{0}, ns{0}, maximum{0};
+        std::array<std::atomic<uint64_t>, 32> histogram;
+        uint32_t random = 1; // DP-only sampling state
+        Counter() { for (auto &v : histogram) v.store(0, std::memory_order_relaxed); }
+    };
+    std::array<Counter, COUNT> counters;
+    struct StateLabel { char text[96]={0}; std::atomic<bool> ready{false}; } state_labels[128];
+    struct Negotiated {
+        Negotiation first;
+        std::atomic<bool> ready{false};
+        std::atomic<uint64_t> completed{0}, different{0};
+    } negotiated[2];
+    int shift_ = 8;
+    bool config_valid_ = true;
+    static void add(std::atomic<uint64_t> &v, uint64_t n) {
+        v.store(v.load(std::memory_order_relaxed) + n, std::memory_order_relaxed);
+    }
+public:
+    // Read once at DP object construction, before traffic. Invalid values
+    // disable collection and are explicitly reported by RPC.
+    Metrics() {
+        const char *v = std::getenv("TREX_ASTF_COST_SHIFT");
+        if (v) {
+            if (!std::strcmp(v, "off")) shift_ = -1;
+            else {
+                char *end = nullptr;
+                long n = std::strtol(v, &end, 10);
+                if (!*v || *end || n < 0 || n > 20) { shift_ = -1; config_valid_ = false; }
+                else shift_ = static_cast<int>(n);
+            }
+        }
+        for (unsigned i=0; i<COUNT; ++i) {
+            uint32_t seed = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(this)) ^ (0x9e3779b9u * (i+1));
+            counters[i].random = seed ? seed : i+1;
+        }
+    }
+    void state_label(unsigned index, const char *text) {
+        if (index>=128 || !text) return;
+        auto &s=state_labels[index];
+        if (!s.ready.load(std::memory_order_relaxed)) {
+            std::strncpy(s.text,text,sizeof(s.text)-1);
+            s.ready.store(true,std::memory_order_release);
+        }
+    }
+    const char *state_label(unsigned index) const {
+        if(index>=128 || !state_labels[index].ready.load(std::memory_order_acquire)) return "";
+        return state_labels[index].text;
+    }
+    void observe(bool server, const Negotiation &value) {
+        auto &n=negotiated[server ? 1 : 0];
+        if (!n.ready.load(std::memory_order_relaxed)) {
+            n.first=value;
+            n.ready.store(true, std::memory_order_release);
+        } else if (!(n.first==value)) add(n.different, 1);
+        add(n.completed, 1);
+    }
+    bool negotiation(bool server, Negotiation &value, uint64_t &completed, uint64_t &different) const {
+        const auto &n=negotiated[server ? 1 : 0];
+        if (!n.ready.load(std::memory_order_acquire)) return false;
+        value=n.first;
+        completed=n.completed.load(std::memory_order_relaxed);
+        different=n.different.load(std::memory_order_relaxed);
+        return true;
+    }
+    bool enabled() const { return shift_ >= 0; }
+    bool config_valid() const { return config_valid_; }
+    int shift() const { return shift_; }
+    bool select(Metric m) {
+        auto &x = counters[m].random;
+        x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+        return (x & ((1u << shift_) - 1)) == 0;
+    }
+    void finish(Metric m, uint64_t bytes, bool sampled, uint64_t ns) {
+        auto &c = counters[m];
+        add(c.calls, 1);
+        if (bytes) add(c.bytes, bytes);
+        if (!sampled) return;
+        add(c.samples, 1); add(c.ns, ns);
+        if (ns > c.maximum.load(std::memory_order_relaxed)) c.maximum.store(ns, std::memory_order_relaxed);
+        unsigned bin=0; uint64_t n=ns;
+        while (n > 1 && bin < 31) { n >>= 1; ++bin; }
+        add(c.histogram[bin], 1);
+    }
+    Snapshot snapshot(Metric m) const {
+        const auto &c = counters[m];
+        Snapshot s{c.calls.load(std::memory_order_relaxed), c.bytes.load(std::memory_order_relaxed),
+            c.samples.load(std::memory_order_relaxed), c.ns.load(std::memory_order_relaxed),
+            c.maximum.load(std::memory_order_relaxed), {}};
+        for (unsigned i=0;i<32;++i) s.histogram[i]=c.histogram[i].load(std::memory_order_relaxed);
+        return s;
+    }
+};
+// Function-local TLS in an inline function is shared across translation units.
+inline Metrics *&current() { static thread_local Metrics *p = nullptr; return p; }
+class Binding {
+    Metrics *previous;
+public:
+    explicit Binding(Metrics *p): previous(current()) { current() = p && p->enabled() ? p : nullptr; }
+    ~Binding() { current() = previous; }
+    Binding(const Binding &) = delete;
+    Binding &operator=(const Binding &) = delete;
+};
+class Probe {
+    Metrics *owner;
+    Metric metric;
+    uint64_t started=0, bytes_=0;
+    bool sampled=false;
+    static uint64_t now() {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+public:
+    explicit Probe(Metric m): owner(current()), metric(m) {
+        if (owner && (sampled=owner->select(m))) started=now();
+    }
+    void bytes(uint64_t n) { bytes_=n; }
+    ~Probe() {
+        if (owner) owner->finish(metric, bytes_, sampled, sampled ? now()-started : 0);
+    }
+    Probe(const Probe &) = delete;
+    Probe &operator=(const Probe &) = delete;
+};
+}
+#endif
diff --git a/src/astf/astf_scheduler.h b/src/astf/astf_scheduler.h
new file mode 100644
--- /dev/null
+++ b/src/astf/astf_scheduler.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef TREX_ASTF_SCHEDULER_H
+#define TREX_ASTF_SCHEDULER_H
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+// DP-owned policy. Only snapshot() may be called by the control plane.
+// Diagnostics are monotonic per DP instance, not per profile/run; RPC readers
+// must use baseline deltas. Independent relaxed counters are not one transaction.
+class CAstfScheduler {
+public:
+    enum Counter { RECOVERIES, RECOVERED, STRETCHES, STRETCH_US, MAX_LAG_US,
+                   WAITS, WAIT_US, BATCH_YIELDS, RX_POLLS, COUNT };
+    static constexpr double recovery_seconds() { return 0.010; }
+    static constexpr double service_seconds() { return 0.0001; }
+    static constexpr unsigned batch_nodes() { return 32; }
+    CAstfScheduler() { for (auto &v : stats) v.store(0, std::memory_order_relaxed); }
+    void begin() { recovering = false; }
+    bool should_stretch(double now, double lag, double threshold, bool automatic) {
+        if (lag > 0) {
+            auto us = micros(lag);
+            if (us > stats[MAX_LAG_US].load(std::memory_order_relaxed))
+                stats[MAX_LAG_US].store(us, std::memory_order_relaxed);
+        }
+        if (lag <= threshold) {
+            if (recovering) add(RECOVERED);
+            recovering = false;
+            return false;
+        }
+        if (automatic) {
+            if (!recovering) { recovering = true; started = now; add(RECOVERIES); }
+            // Limit both continuous recovery work and queued time debt. A
+            // single event cannot be preempted; bounds apply between events.
+            if (lag <= recovery_seconds() && now - started < recovery_seconds())
+                return false;
+        }
+        recovering = false;
+        add(STRETCHES); add(STRETCH_US, micros(lag));
+        return true;
+    }
+    void waited(double seconds) { add(WAITS); if (seconds > 0) add(WAIT_US, micros(seconds)); }
+    void yielded() { add(BATCH_YIELDS); }
+    void polled_rx() { add(RX_POLLS); }
+    std::array<uint64_t, COUNT> snapshot() const {
+        std::array<uint64_t, COUNT> result{};
+        for (unsigned i=0;i<COUNT;++i) result[i]=stats[i].load(std::memory_order_relaxed);
+        return result;
+    }
+private:
+    static uint64_t micros(double seconds) { return static_cast<uint64_t>(seconds * 1000000.0); }
+    void add(Counter c, uint64_t value=1) {
+        // Single DP writer; the CP only loads. No locked RMW in packet work.
+        stats[c].store(stats[c].load(std::memory_order_relaxed)+value, std::memory_order_relaxed);
+    }
+    bool recovering = false;
+    double started = 0;
+    std::array<std::atomic<uint64_t>, COUNT> stats;
+};
+#endif
