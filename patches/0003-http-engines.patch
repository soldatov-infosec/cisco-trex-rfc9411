+#ifndef ASTF_HTTP2_H
+#define ASTF_HTTP2_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string>
+#include <memory>
+#include <vector>
+namespace astf_http2 {
+struct Config {
+    bool enabled=false, server=false, secure=true;
+    uint32_t requests=10, concurrency=1, body_size=16384, timeout_ms=30000;
+    // Optional cyclic response sizes, indexed by client stream ID (1, 3, ...).
+    // Shared immutable program configuration; no per-request allocation.
+    std::vector<uint32_t> body_sizes;
+    uint32_t response_size(int32_t stream_id) const {
+        return body_sizes.empty()?body_size:body_sizes[(uint32_t(stream_id-1)/2)%body_sizes.size()];
+    }
+    // Client-only pacing; positive intervals require sequential streams.
+    uint32_t request_interval_ms=0, final_hold_ms=0;
+    uint32_t max_body_size=1073741824, max_header_size=16384;
+    uint16_t status=200, expected_status=200;
+    std::string authority="localhost", path="/";
+};
+enum class Event { REQUEST, RESPONSE, RESET, GOAWAY, ERROR };
+using Callback = void (*)(void *, Event, uint64_t, uint64_t);
+// One session per TCP flow, owned and driven by its DP core. No socket I/O.
+class Session {
+public:
+    Session(const Config &, Callback, void *);
+    ~Session();
+    Session(const Session &)=delete;
+    Session &operator=(const Session &)=delete;
+    bool input(const uint8_t *, size_t, uint64_t now_ns);
+    bool input(const uint8_t *, size_t, uint64_t first_ns, uint64_t last_ns);
+    size_t output(const uint8_t **, uint64_t now_ns);
+    void consume(size_t);
+    // Next pacing wakeup, or zero. Caller also maintains the absolute session deadline.
+    uint64_t next_wakeup_ns() const;
+    // Separate scheduler time from RX timestamps (simulator clocks may differ).
+    void set_pacing_clock(uint64_t now_ns);
+    bool failed() const;
+    bool finished() const;
+    bool eof();
+    // Absolute software RX times for a complete, validated client connection.
+    // Control frames and connection shutdown do not extend this sample.
+    bool response_times(uint64_t &first_ns, uint64_t &last_ns) const;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> p;
+};
+}
+#endif
