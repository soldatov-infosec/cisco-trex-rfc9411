+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Cold-path checks; actual compiler/loader checks are performed by Waf."""
+import importlib.util
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+
+spec = importlib.util.spec_from_file_location('astf_tls_build',
+    Path(__file__).resolve().parents[2]/'linux_dpdk/astf_tls_build.py')
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+class Conf:
+    def __init__(self, prefix):
+        self.options = SimpleNamespace(aws_lc_prefix=prefix, tls_backend='aws-lc')
+        self.env = {'RPATH_ASTF_TLS': ['/stale/path']}
+        self.checked = None
+        self.checks = {}
+    def fatal(self, message):
+        raise ValueError(message)
+    def msg(self, *args):
+        pass
+    def check_cxx(self, **kwargs):
+        self.checked = kwargs
+        self.checks[kwargs["uselib_store"]] = kwargs
+
+class PrefixTests(unittest.TestCase):
+    def test_only_aws_lc_is_allowed(self):
+        conf = Conf(None)
+        with self.assertRaisesRegex(ValueError, 'needs --aws-lc-prefix'):
+            module.configure(conf)
+        self.assertEqual(conf.env['RPATH_ASTF_TLS'], [])
+        self.assertIsNone(conf.checked)
+        conf.options.tls_backend = 'openssl'
+        with self.assertRaisesRegex(ValueError, 'only AWS-LC'):
+            module.configure(conf)
+
+    def test_incomplete_prefix_cannot_fall_back_to_system(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp); conf = Conf(temp)
+            with self.assertRaisesRegex(ValueError, 'ssl.h'): module.configure(conf)
+            (root/'include/openssl').mkdir(parents=True)
+            (root/'include/openssl/ssl.h').touch()
+            (root/'lib').mkdir(); (root/'lib64').mkdir()
+            (root/'lib/libssl.so').touch(); (root/'lib64/libcrypto.so').touch()
+            with self.assertRaisesRegex(ValueError, 'shared'): module.configure(conf)
+            self.assertIsNone(conf.checked)
+            (root/'lib/libcrypto.so').touch(); module.configure(conf)
+            tls_check = conf.checks['ASTF_TLS']
+            self.assertIn('ASTF_HTTP2', conf.checks)
+            selected = str(root.resolve()/'lib')
+            self.assertEqual(tls_check['libpath'], [selected])
+            self.assertEqual(tls_check['rpath'], [selected])
+            self.assertEqual(tls_check['includes'], [str(root.resolve()/'include')])
+            self.assertEqual(tls_check['uselib_store'], 'ASTF_TLS')
+            self.assertTrue(tls_check['mandatory'])
+            self.assertTrue(tls_check['execute'])
+            self.assertIn('OPENSSL_IS_AWSLC', tls_check['fragment'])
+            self.assertIn('awslc_version_string()', tls_check['fragment'])
+
+class BuildFlagTests(unittest.TestCase):
+    def test_public_flag_and_option_destination(self):
+        import ast
+        import contextlib
+        import io
+        import optparse
+        for name in ('linux', 'linux_dpdk'):
+            tree = ast.parse((Path(__file__).resolve().parents[2]/name/'ws_main.py').read_text())
+            calls = [node for node in ast.walk(tree) if isinstance(node, ast.Call)
+                     and isinstance(node.func, ast.Attribute) and node.func.attr == 'add_option'
+                     and node.args and isinstance(node.args[0], ast.Constant)
+                     and node.args[0].value == '--rfc9411']
+            self.assertEqual(len(calls), 1, name)
+            call = calls[0]
+            parser = optparse.OptionParser()
+            parser.add_option(*[ast.literal_eval(v) for v in call.args],
+                              **{v.arg: ast.literal_eval(v.value) for v in call.keywords})
+            self.assertFalse(parser.parse_args([])[0].rfc9411)
+            self.assertTrue(parser.parse_args(['--rfc9411'])[0].rfc9411)
+            with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit):
+                parser.parse_args(['--with-tls'])
+            attrs = [n.attr for n in ast.walk(tree) if isinstance(n, ast.Attribute)]
+            self.assertIn('rfc9411', attrs)
+            self.assertNotIn('with_tls', attrs)
+
+if __name__ == '__main__': unittest.main()
