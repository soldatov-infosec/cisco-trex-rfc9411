+This is a test client, never part of the TRex TLS datapath. Certificates must
+exist on the TRex server. Only this test's uniquely named profiles are removed.
+"""
+import argparse
+import time
+import uuid
+from trex.astf.api import (ASTFClient, ASTFProgram, ASTFProfile, ASTFTemplate,
+                          ASTFTCPClientTemplate, ASTFTCPServerTemplate,
+                          ASTFAssociationRule, ASTFIPGen, ASTFIPGenGlobal,
+                          ASTFIPGenDist)
+
+
+def profile(args, version, stage, port, bad_body=False):
+    options = dict(version=version, resumption=True)
+    client_tls=dict(options, sni='localhost', ca=args.cert)
+    server_tls=dict(options, cert=args.cert, key=args.key)
+    if stage == 'https':
+        for policy in (client_tls,server_tls):
+            policy.update(groups=['P-256'], signature_algorithms=['rsa_pss_rsae_sha256'],
+                          cipher_suite='ECDHE-RSA-AES128-GCM-SHA256' if version=='1.2' else 'TLS_AES_128_GCM_SHA256')
+        client_tls.update(cert=args.cert,key=args.key)
+        server_tls.update(require_client_cert=True,ca=args.cert)
+    c = ASTFProgram(tls=None if stage=='http' else client_tls, http={'responses':3,'transactions':True,'body_contains':'OK'} if stage in ('https','http') else None)
+    if bad_body: c.http['body_contains']='EXPECTED-ORIGIN-CONTENT'
+    s = ASTFProgram(side='s', tls=None if stage in ('handshake','http') else server_tls)
+    request = b'GET / HTTP/1.1\r\nHost: localhost\r\n\r\n'
+    response = b'HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nOK'
+    if stage in ('https','http'):
+        c.set_var('n',3); c.set_label('request'); c.http_request_start()
+        s.set_var('n',3); s.set_label('response')
+    c.send(request)
+    if stage == 'handshake':
+        s.recv(1 << 30)  # Plain TCP server deliberately never sends ServerHello.
+        c.recv(len(response))
+    else:
+        s.recv(len(request))
+        if stage == 'bulk':
+            s.set_send_blocking(False)
+            s.set_var('n', 128)
+            s.set_label('send')
+            s.send(b'x' * 65536)
+            s.jmp_nz('n', 'send')
+            c.recv(128 * 65536)
+        else:
+            if stage == 'delay':
+                s.delay(30000000)
+            s.send(response)
+            c.recv(len(response))
+        if stage in ('https','http'):
+            c.jmp_nz('n','request'); s.jmp_nz('n','response')
+        if stage == 'bulk':
+            s.delay(30000000)
+            c.delay(30000000)
+    c.add_stats('A', 1)
+    s.add_stats('A', 1)
+    ip = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset='1.0.0.0'),
+                  dist_client=ASTFIPGenDist(ip_range=['16.0.0.1', '16.0.0.254'], distribution='seq'),
+                  dist_server=ASTFIPGenDist(ip_range=['48.0.0.1', '48.0.0.254'], distribution='seq'))
+    template = ASTFTemplate(client_template=ASTFTCPClientTemplate(program=c, ip_gen=ip, port=port, cps=1),
+                            server_template=ASTFTCPServerTemplate(program=s, assoc=ASTFAssociationRule(port=port)))
+    return ASTFProfile(default_ip_gen=ip, templates=template)
+
+
+def wait_active(client, pid, stage):
+    until = time.monotonic() + 20
+    while time.monotonic() < until:
+        stats = client.get_traffic_stats(skip_zero=False, pid_input=pid)
+        c, s = stats['client'], stats['server']
+        if c['m_active_flows'] and s['m_active_flows']:
+            if stage == 'handshake' and c['tcps_tls_attempts'] and not c['tcps_tls_handshakes']:
+                return stats
+            if stage != 'handshake' and c['tcps_tls_handshakes'] and s['tcps_tls_handshakes']:
+                if stage != 'bulk' or s['tcps_tls_sndbyte'] >= 65536:
+                    return stats
+        time.sleep(0.05)
+    raise AssertionError('No active TLS flow at requested stage: ' + stage)
+
+
+def remove_profile(client, pid):
+    # Blocking clear can miss its transient state when the existing client
+    # deletes the event queue on profile removal. Check final server and client
+    # state instead; this also puts a deadline on removal.
+    client.clear_profile(block=False, pid_input=pid)
+    until = time.monotonic() + 15
+    while time.monotonic() < until:
+        if pid not in client.get_profiles() and pid not in client.get_profiles_state():
+            return
+        time.sleep(0.05)
+    raise AssertionError('Profile removal timeout: ' + pid)
+
+
+def check_transactions(counters, expected):
+    assert counters['tcps_http_responses']==expected,counters
+    assert counters['tcps_http_bad_content']==counters['tcps_http_transaction_errors']==0,counters
+    for prefix in ('tcps_http_req_ttfb','tcps_http_req_ttlb'):
+        assert counters[prefix+'_count']==expected,counters
+        assert sum(counters[prefix+'_bucket_'+str(i)] for i in range(32))==expected,counters
+        assert 0<=counters[prefix+'_min_ms']<=counters[prefix+'_avg_ms']<=counters[prefix+'_max_ms'],counters
+        assert counters[prefix+'_p50_ms']<=counters[prefix+'_p95_ms']<=counters[prefix+'_p99_ms']<=counters[prefix+'_max_ms'],counters
+    print('HTTP transactions:',{k:v for k,v in counters.items() if k.startswith('tcps_http_req_') and '_bucket_' not in k},flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--server', default='localhost')
+    parser.add_argument('--cert', required=True)
+    parser.add_argument('--key', required=True)
+    parser.add_argument('--ipv6', action='store_true')
+    parser.add_argument('--iterations', type=int, default=3)
+    args = parser.parse_args()
+    assert 1 <= args.iterations <= 100
+    client = ASTFClient(server=args.server, sync_timeout=15, async_timeout=15)
+    prefix = 'tls_validation_' + uuid.uuid4().hex[:8]
+    pid, keep = prefix, prefix + '_keep'
+    owned = set()
+    client.connect()
+    try:
+        client.acquire()  # Do not forcibly take ports from another client.
+        assert client.get_global_cfg()['sched_max_stretch'] == 0.0
+        baseline_scheduler = [cpu['scheduler'] for cpu in client.get_util_stats()['cpu']]
+        assert baseline_scheduler and all(row['scope'] == 'dp_lifetime' for row in baseline_scheduler)
+        client.load_profile(profile(args, '1.3', 'delay', 444), pid_input=keep)
+        owned.add(keep)
+        client.start(mult=1, ipv6=args.ipv6, pid_input=keep)
+        wait_active(client, keep, 'delay')
+        for version in ('1.2', '1.3'):
+            for iteration in range(args.iterations):
+                for stage in ('handshake', 'delay', 'bulk'):
+                    client.load_profile(profile(args, version, stage, 443), pid_input=pid)
+                    owned.add(pid)
+                    client.start(mult=3, ipv6=args.ipv6, pid_input=pid)
+                    wait_active(client, pid, stage)
+                    started = time.monotonic()
+                    client.stop(pid_input=pid)
+                    assert time.monotonic() - started < 15
+                    after = client.get_traffic_stats(skip_zero=False, pid_input=pid)
+                    assert after['client']['m_active_flows'] == after['server']['m_active_flows'] == 0
+                    remove_profile(client, pid)
+                    owned.remove(pid)
+                    survivor = client.get_traffic_stats(skip_zero=False, pid_input=keep)
+                    assert survivor['client']['m_active_flows'] > 0
+                    assert survivor['client']['tcps_tls_errors'] == survivor['server']['tcps_tls_errors'] == 0
+                    print(version, iteration, stage, 'stop/remove OK; other profile remains active', flush=True)
+            # Same ID after repeated removal must still complete new HTTPS flows.
+            client.load_profile(profile(args, version, 'https', 443), pid_input=pid)
+            owned.add(pid)
+            client.start(mult=3, duration=2, ipv6=args.ipv6, pid_input=pid)
+            client.wait_on_traffic(timeout=30, profile_id=pid)
+            stats = client.get_traffic_stats(skip_zero=False, pid_input=pid)
+            for side in ('client', 'server'):
+                counters = stats[side]
+                assert counters['tcps_tls_handshakes'] >= 2
+                assert counters['tcps_tls_resumed'] >= 1
+                assert counters['tcps_tls_errors'] == 0
+                assert counters['user_counter_A'] == counters['tcps_tls_handshakes']
+                assert counters['m_active_flows'] == 0
+            for side in ('client','server'):
+                values=stats[side]
+                n=values['tcps_tls_handshakes']
+                assert values['tcps_tls_full_handshakes']+values['tcps_tls_resumed']==n,values
+                for prefix in ('tcps_tls_version_','tcps_tls_cipher_','tcps_tls_group_','tcps_tls_peer_signature_'):
+                    assert sum(v for k,v in values.items() if k.startswith(prefix))==n,values
+                assert values['tcps_tls_version_tls12' if version=='1.2' else 'tcps_tls_version_tls13']==n,values
+                assert values['tcps_tls_cipher_ecdhe_rsa_aes128_gcm_sha256' if version=='1.2' else 'tcps_tls_cipher_tls_aes_128_gcm_sha256']==n,values
+                assert values['tcps_tls_peer_signature_none']==values['tcps_tls_resumed'],values
+                assert values['tcps_tls_peer_signature_rsa_pss_rsae_sha256']==values['tcps_tls_full_handshakes'],values
+                print('Negotiated TLS',side,{k:v for k,v in values.items() if k.startswith(('tcps_tls_version_','tcps_tls_cipher_','tcps_tls_group_','tcps_tls_peer_signature_')) and v},flush=True)
+            counters=stats['client']
+            assert counters['tcps_http_errors']==counters['tcps_http_aborted']==0, counters
+            assert counters['tcps_ttfb_count']==counters['tcps_ttlb_count']==counters['tcps_tls_handshakes'], counters
+            check_transactions(counters,counters['tcps_tls_handshakes']*3)
+            assert 0 < counters['tcps_ttfb_min_ms'] <= counters['tcps_ttfb_avg_ms'] <= counters['tcps_ttfb_max_ms'], counters
+            assert counters['tcps_ttlb_avg_ms'] >= counters['tcps_ttfb_avg_ms'], counters
+            print('HTTP latency:', {key:value for key,value in counters.items() if key.startswith(('ttfb','ttlb','tcps_http'))}, flush=True)
+            remove_profile(client, pid)
+            owned.remove(pid)
+            print(version, 'reload, HTTPS and session resumption OK', flush=True)
+        client.load_profile(profile(args,'1.3','https',443,bad_body=True),pid_input=pid)
+        owned.add(pid)
+        client.start(mult=3,duration=2,ipv6=args.ipv6,pid_input=pid)
+        client.wait_on_traffic(timeout=30,profile_id=pid)
+        bad=client.get_traffic_stats(skip_zero=False,pid_input=pid)['client']
+        assert bad['tcps_http_bad_content']>0,bad
+        assert bad['tcps_http_responses']==bad['tcps_http_req_ttfb_count']==bad['tcps_http_req_ttlb_count']==bad['tcps_ttfb_count']==bad['tcps_ttlb_count']==0,bad
+        print('HTTPS substituted 200 OK body rejected:',bad['tcps_http_bad_content'],flush=True)
+        remove_profile(client,pid); owned.remove(pid)
+        # Plain HTTP exercises the same counters through the actual RPC API.
+        client.load_profile(profile(args,'1.3','http',80),pid_input=pid)
+        owned.add(pid)
+        client.start(mult=3,duration=2,ipv6=args.ipv6,pid_input=pid)
+        client.wait_on_traffic(timeout=30,profile_id=pid)
+        stats=client.get_traffic_stats(skip_zero=False,pid_input=pid)
+        counters=stats['client']
+        assert counters['tcps_tls_attempts']==0, counters
+        assert counters['tcps_http_errors']==counters['tcps_http_aborted']==0, counters
+        assert counters['tcps_ttfb_count']==counters['tcps_ttlb_count']==counters['tcps_connects']>0, counters
+        check_transactions(counters,counters['tcps_connects']*3)
+        assert 0<counters['tcps_ttfb_min_ms']<=counters['tcps_ttfb_avg_ms']<=counters['tcps_ttfb_max_ms'], counters
+        assert counters['tcps_ttlb_avg_ms']>=counters['tcps_ttfb_avg_ms'], counters
+        print('Plain HTTP RPC latency:',{key:value for key,value in counters.items() if key.startswith(('ttfb','ttlb','tcps_http'))},flush=True)
+        remove_profile(client,pid); owned.remove(pid)
+        utilization = client.get_util_stats()['cpu']
+        import os
+        for cpu in utilization:
+            tls = cpu.get('tls_cost', {})
+            expected = os.environ.get('TREX_TLS_EXPECT_BACKEND')
+            if expected:
+                assert tls.get('tls_backend') == expected, tls
+                assert tls.get('tls_backend_version'), tls
+            print('TLS backend:', tls.get('tls_backend'), tls.get('tls_backend_version'), flush=True)
+        after_scheduler = [cpu['scheduler'] for cpu in utilization]
+        assert len(after_scheduler) == len(baseline_scheduler)
+        for before, after in zip(baseline_scheduler, after_scheduler):
+            for key in before:
+                if key != 'scope':
+                    assert after[key] >= before[key], (key, before, after)
+        assert sum(row['wait_us'] for row in after_scheduler) > sum(row['wait_us'] for row in baseline_scheduler)
+        print('ASTF scheduler diagnostics:', after_scheduler, flush=True)
+    finally:
+        try:
+            for current in list(owned):
+                if current in client.get_profiles():
+                    client.stop(pid_input=current)
+                    remove_profile(client, current)
+        finally:
+            client.disconnect()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/tls/interop_peer.cpp b/tests/tls/interop_peer.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/interop_peer.cpp
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Test-only TCP transport for the native TLS engine. Never linked into TRex.
+#include "44bsd/tls/astf_tls.h"
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+#include <cerrno>
+#include <chrono>
+#include <csignal>
+#include <iostream>
+#include <stdexcept>
+using namespace astf_tls;
+static void require(bool ok,const char *what) { if(!ok) throw std::runtime_error(what); }
+int main(int argc,char **argv) {
+    try {
+        require(argc==8,"role version cert key ca port expected-result");
+        signal(SIGPIPE,SIG_IGN);
+        bool server=std::string(argv[1])=="server", reject=std::string(argv[7])=="reject";
+        int fd=socket(AF_INET,SOCK_STREAM,0); require(fd>=0,"socket");
+        sockaddr_in addr{}; addr.sin_family=AF_INET; addr.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
+        addr.sin_port=htons(std::stoi(argv[6]));
+        if(server) {
+            require(bind(fd,reinterpret_cast<sockaddr *>(&addr),sizeof(addr))==0,"bind");
+            require(listen(fd,1)==0,"listen"); socklen_t n=sizeof(addr);
+            require(getsockname(fd,reinterpret_cast<sockaddr *>(&addr),&n)==0,"getsockname");
+            std::cout<<"LISTEN "<<ntohs(addr.sin_port)<<std::endl;
+            pollfd p{fd,POLLIN,0}; require(poll(&p,1,10000)>0,"accept timeout");
+            int connection=accept(fd,nullptr,nullptr); close(fd); fd=connection;
+            require(fd>=0,"accept");
+        } else require(connect(fd,reinterpret_cast<sockaddr *>(&addr),sizeof(addr))==0,"connect");
+        require(fcntl(fd,F_SETFL,O_NONBLOCK)==0,"nonblocking");
+        Config config; config.server=server; config.version=argv[2];
+        if(server) { config.cert=argv[3]; config.key=argv[4]; }
+        else { config.ca=argv[5]; config.sni="localhost"; }
+        Flow flow(std::make_shared<Context>(config));
+        const std::string payload=server ? "HTTP/1.1 200 OK\r\nContent-Length: 8\r\nConnection: close\r\n\r\nTLS-OK!\n"
+            : "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n";
+        std::string received; size_t sent=0, start=0, end=0; uint8_t input[4096]; bool eof=false;
+        auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(10);
+        while(std::chrono::steady_clock::now()<deadline) {
+            if(start==end && !eof) {
+                ssize_t n=recv(fd,input,sizeof(input),0);
+                if(n>0) { start=0; end=n; }
+                else if(n==0) eof=true;
+                else require(errno==EAGAIN || errno==EWOULDBLOCK || errno==EINTR,"recv");
+            }
+            if(start<end) start+=flow.feed(input+start,end-start);
+            if(eof && start==end) flow.eof();
+            if(!flow.ready()) flow.handshake();
+            if(flow.ready()) {
+                char plain[4096]; size_t n=flow.read(plain,sizeof(plain)); received.append(plain,n);
+                require(received.size()<1024*1024,"excessive response");
+                if((!server || received.find("\r\n\r\n")!=std::string::npos) && sent<payload.size())
+                    sent+=flow.write(payload.data()+sent,payload.size()-sent);
+                if((server && sent==payload.size()) || flow.peer_closed()) flow.shutdown();
+            }
+            if(flow.failed()) {
+                close(fd);
+                require(reject && flow.failure()==Failure::VERIFY,"unexpected TLS failure");
+                require(received.empty(),"plaintext before verification failure");
+                std::cout<<"VERIFY-REJECT OK\n"; return 0;
+            }
+            const uint8_t *wire=nullptr; size_t n=flow.peek(&wire);
+            if(n) {
+                ssize_t written=send(fd,wire,n,0);
+                if(written>0) flow.consume(written);
+                else require(errno==EAGAIN || errno==EWOULDBLOCK || errno==EINTR,"send");
+            }
+            if(flow.sent_close() && !flow.pending() && (server || flow.peer_closed())) {
+                require(!reject && sent==payload.size(),"incomplete exchange");
+                require(server ? received.find("GET / ")==0 : received.find("HTTP/1.")==0,"HTTP response");
+                require(server || received.find("200 OK")!=std::string::npos,"HTTP status");
+                close(fd); std::cout<<"EXCHANGE OK\n"; return 0;
+            }
+            pollfd p{fd,short(POLLIN | (flow.pending()?POLLOUT:0)),0}; poll(&p,1,1);
+        }
+        close(fd); throw std::runtime_error("TLS deadline");
+    } catch(const std::exception &e) { std::cerr<<e.what()<<'\n'; return 1; }
+}
