+#ifdef TREX_TLS
+// Adversarial packets enter the normal TCP input/reassembly/ASTF path.
+class TlsWireFault : public CTxRxCallback {
+public:
+    enum Mode { OVERLAP, CONFLICT, FIN_RECORD, RST_RECORD, ZERO_WINDOW, ACTIVE_STOP };
+    CClientServerTcp &sim;
+    Mode mode;
+    unsigned injected=0;
+    uint64_t plaintext_at_fault=0;
+    double reopen=0;
+    uint32_t random;
+    explicit TlsWireFault(CClientServerTcp &s, Mode m, uint32_t seed=1):sim(s),mode(m),random(seed) {}
+    uint32_t draw() { random^=random<<13; random^=random>>17; random^=random<<5; return random; }
+    int on_rx(int, rte_mbuf_t *) override { return 0; }
+    static void checksum(rte_mbuf_t *m) {
+        auto bytes=rte_pktmbuf_mtod(m,uint8_t *);
+        auto ip=reinterpret_cast<IPHeader *>(bytes+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(bytes+14+ip->getHeaderLength());
+        unsigned len=ip->getTotalLength()-ip->getHeaderLength();
+        tcp->setChecksum(0);
+        uint32_t sum=len+6;
+        for(unsigned i=26;i<34;i+=2) sum+=(bytes[i]<<8)|bytes[i+1];
+        auto p=tcp->getPointer();
+        for(unsigned i=0;i<len;i+=2) sum+=(p[i]<<8)|((i+1<len)?p[i+1]:0);
+        while(sum>>16) sum=(sum&0xffff)+(sum>>16);
+        tcp->setChecksum(uint16_t(~sum));
+        ip->updateCheckSum();
+    }
+    static rte_mbuf_t *copy(rte_mbuf_t *m) {
+        auto result=utl_rte_pktmbuf_deepcopy(tcp_pktmbuf_get_pool(0,2047),m);
+        assert(result && result->next==nullptr);
+        return result;
+    }
+    static void slice(rte_mbuf_t *m,unsigned offset,unsigned length) {
+        auto bytes=rte_pktmbuf_mtod(m,uint8_t *);
+        auto ip=reinterpret_cast<IPHeader *>(bytes+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(bytes+14+ip->getHeaderLength());
+        unsigned header=14+ip->getHeaderLength()+tcp->getHeaderLength();
+        memmove(bytes+header,bytes+header+offset,length);
+        tcp->setSeqNumber(tcp->getSeqNumber()+offset);
+        ip->setTotalLength(header-14+length);
+        int rc=rte_pktmbuf_trim(m,m->pkt_len-header-length); assert(rc==0);
+        checksum(m);
+    }
+    void deliver(rte_mbuf_t *m,int dir,double when) {
+        sim.m_sim.add_event(new CTcpSimEventRx(&sim,m,dir^1,when));
+    }
+    int on_tx(int dir,rte_mbuf_t *m) override {
+        if(!sim.m_c_ctx.get_tcpstat()->m_sts.tcps_tls_handshakes ||
+           !sim.m_s_ctx.get_tcpstat()->m_sts.tcps_tls_handshakes) return 0;
+        auto bytes=rte_pktmbuf_mtod(m,uint8_t *);
+        auto ip=reinterpret_cast<IPHeader *>(bytes+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(bytes+14+ip->getHeaderLength());
+        unsigned len=ip->getTotalLength()-ip->getHeaderLength()-tcp->getHeaderLength();
+        double now=sim.m_sim.get_time();
+        if(mode==ZERO_WINDOW) {
+            if(dir!=1 || tcp->getResetFlag() || tcp->getFinFlag()) return 0;
+            if(!reopen) reopen=now+6.0;
+            if(now>=reopen) return 0;
+            auto update=copy(m);
+            // Remove payload from the window update; retain its current ACK.
+            slice(update,0,0);
+            auto utcp=reinterpret_cast<TCPHeader *>(rte_pktmbuf_mtod(update,uint8_t *)+14+ip->getHeaderLength());
+            utcp->setWindowSize(512); checksum(update);
+            deliver(update,dir,reopen+0.00001*injected++);
+            tcp->setWindowSize(0); checksum(m);
+            return 0;
+        }
+        if(injected || dir!=0 || len<96) return 0;
+        ++injected;
+        plaintext_at_fault = sim.m_c_ctx.get_tcpstat()->m_sts.tcps_tls_sndbyte;
+        if(mode==ACTIVE_STOP) {
+            sim.m_sim.add_event(new CTcpSimEventStop(now+0.0001));
+        } else if(mode==OVERLAP || mode==CONFLICT) {
+            auto head=copy(m), middle=copy(m), duplicate=copy(m);
+            slice(head,0,len/2);
+            slice(middle,1+draw()%(len/3),len/2);
+            if(mode==CONFLICT) {
+                auto p=rte_pktmbuf_mtod(middle,uint8_t *);
+                p[middle->pkt_len-1]^=1; checksum(middle);
+            }
+            slice(m,len/2,len-len/2);
+            deliver(middle,dir,now+0.01);
+            deliver(head,dir,now+0.04+double(draw()%100)/100000.0);
+            deliver(duplicate,dir,now+0.06);
+        } else if(mode==FIN_RECORD) {
+            slice(m,0,len/2);
+            tcp->setFinFlag(true); checksum(m);
+        } else {
+            auto reset=copy(m);
+            slice(reset,len/2,0);
+            auto rtcp=reinterpret_cast<TCPHeader *>(rte_pktmbuf_mtod(reset,uint8_t *)+14+ip->getHeaderLength());
+            rtcp->setResetFlag(true); checksum(reset);
+            slice(m,0,len/2);
+            deliver(reset,dir,now+0.04);
+        }
+        return 0;
+    }
+};
