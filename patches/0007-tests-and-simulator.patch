+++ b/tests/tls/make_ecdsa_cert.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+# Dedicated lab certificate; refuses to overwrite an existing directory.
+set -eu
+umask 077
+out=${1:-/tmp/trex-ecdsa}
+mkdir "$out"
+openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -sha256 -nodes \
+  -keyout "$out/key.pem" -out "$out/cert.pem" -days 365 \
+  -subj /CN=localhost -addext subjectAltName=DNS:localhost
+openssl x509 -in "$out/cert.pem" -noout -subject -dates
+printf 'Created ECDSA P-256 lab certificate in %s; SNI localhost\n' "$out"
diff --git a/tests/tls/mbuf_pool_test.cpp b/tests/tls/mbuf_pool_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/mbuf_pool_test.cpp
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Real DPDK pools: unlike the simulator, their capacity is finite.
+#include "44bsd/tls/astf_tls_mbuf.h"
+#include <rte_eal.h>
+#include <rte_errno.h>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+CRteMemPool CGlobalInfo::m_mem_pool[MAX_SOCKETS_SUPPORTED];
+// Makes a regression to the fatal allocator an explicit test failure.
+void CRteMemPool::dump_in_case_of_error(FILE *, rte_mempool_t *) {
+    std::fprintf(stderr, "FAIL: entered fatal allocator\n");
+    std::abort();
+}
+static void check(bool ok, const char *message) {
+    if (!ok) { std::fprintf(stderr, "FAIL: %s (%s)\n", message, rte_strerror(rte_errno)); std::exit(1); }
+}
+int main(int argc, char **argv) {
+    check(rte_eal_init(argc, argv) >= 0, "EAL initialization");
+    for (unsigned socket = 0; socket < 2; ++socket) {
+        const uint16_t capacity[] = {64,128,256,512,1024,2048,4096,9216};
+        rte_mempool_t *pools[8];
+        for (unsigned i = 0; i < 8; ++i) {
+            char name[32];
+            std::snprintf(name, sizeof(name), "tls-%u-%u", socket, i);
+            pools[i] = rte_pktmbuf_pool_create(name, 7, 0, 0,
+                capacity[i] + RTE_PKTMBUF_HEADROOM, SOCKET_ID_ANY);
+            check(pools[i] != nullptr, "create finite pool");
+        }
+        auto &p = CGlobalInfo::m_mem_pool[socket];
+        p.m_small_mbuf_pool = pools[0];
+        p.m_mbuf_pool_128 = pools[1]; p.m_mbuf_pool_256 = pools[2];
+        p.m_mbuf_pool_512 = pools[3]; p.m_mbuf_pool_1024 = pools[4];
+        p.m_mbuf_pool_2048 = pools[5]; p.m_mbuf_pool_4096 = pools[6];
+        p.m_mbuf_pool_9k = pools[7];
+        for (uint16_t size : {1,64,65,128,129,256,257,512,513,1024,1025,2048}) {
+            unsigned first = 0;
+            while (capacity[first] < size) ++first;
+            // Small allocations have their own pool. Others may fall back
+            // through larger pools, including the existing 4K -> 9K fallback.
+            unsigned end = size <= 64 ? 1 : 8;
+            std::vector<rte_mbuf_t *> held;
+            for (unsigned i = first; i < end; ++i) {
+                for (unsigned n = 0; n < 7; ++n) {
+                    auto m = astf_tls::alloc_mbuf(socket, size);
+                    check(m && m->pool == pools[i], "allocation/fallback pool");
+                    check(rte_pktmbuf_append(m, size) != nullptr, "payload capacity");
+                    held.push_back(m);
+                }
+                check(rte_mempool_avail_count(pools[i]) == 0, "pool actually exhausted");
+            }
+            for (unsigned i = 0; i < 32; ++i)
+                check(astf_tls::alloc_mbuf(socket, size) == nullptr, "exhaustion returns null");
+            for (unsigned i = 0; i < 8; ++i)
+                if (i < first || i >= end)
+                    check(rte_mempool_avail_count(pools[i]) == 7, "other pools unaffected");
+            auto recovered_pool = held.back()->pool;
+            rte_pktmbuf_free(held.back()); held.pop_back();
+            auto recovered = astf_tls::alloc_mbuf(socket, size);
+            check(recovered && recovered->pool == recovered_pool, "allocation recovers after free");
+            rte_pktmbuf_free(recovered);
+            for (auto m : held) rte_pktmbuf_free(m);
+            for (auto pool : pools)
+                check(rte_mempool_avail_count(pool) == 7, "all mbufs returned");
+        }
+        // H2 output must stop at its TX pool rather than consuming RX pools.
+        for(uint16_t size:{1,64,65,128,129,256,512,1024,1025,2048,4096}) {
+            unsigned selected=1; // Never borrow the TCP header pool either.
+            while(capacity[selected]<size)++selected;
+            if(size>1024)selected=6;
+            std::vector<rte_mbuf_t *> held;
+            for(unsigned n=0;n<7;++n) {
+                auto m=astf_tls::alloc_h2_mbuf(socket,size);
+                check(m && m->pool==pools[selected],"HTTP/2 TX pool selection");
+                check(rte_pktmbuf_append(m,size)!=nullptr,"HTTP/2 block capacity");
+                held.push_back(m);
+            }
+            check(astf_tls::alloc_h2_mbuf(socket,size)==nullptr,"HTTP/2 pressure is nonfatal");
+            for(unsigned i=0;i<8;++i)
+                if(i!=selected)check(rte_mempool_avail_count(pools[i])==7,"other pools untouched");
+            rte_pktmbuf_free(held.back());held.pop_back();
+            auto recovered=astf_tls::alloc_h2_mbuf(socket,size);
+            check(recovered && recovered->pool==pools[selected],"HTTP/2 retry recovers");
+            rte_pktmbuf_free(recovered);
+            for(auto m:held)rte_pktmbuf_free(m);
+            for(auto pool:pools)check(rte_mempool_avail_count(pool)==7,"H2 buffers returned");
+        }
+        for (auto pool : pools) rte_mempool_free(pool);
+        p = CRteMemPool{};
+    }
+    check(rte_eal_cleanup() == 0, "EAL cleanup");
+    std::puts("TLS real DPDK pool exhaustion/recovery: PASS");
+    std::puts("HTTP/2 TX exhaustion/recovery, 2K/9K RX reserve isolation: PASS");
+}
diff --git a/tests/tls/protocol_test.cpp b/tests/tls/protocol_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/protocol_test.cpp
@@ -0,0 +1,231 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Independent OpenSSL peer: does not use astf_tls::Flow or Context.
+#include "44bsd/tls/astf_tls.h"
+#ifdef OPENSSL_IS_AWSLC
+#include "44bsd/tls/astf_tls_bio.h"
+#endif
+#include <openssl/err.h>
+#include <algorithm>
+#include <cassert>
+#include <cstring>
+#include <iostream>
+using namespace astf_tls;
+
+struct Peer {
+    SSL_CTX *ctx;
+    SSL *ssl = nullptr;
+    SSL_SESSION *ticket = nullptr;
+    BIO *wire = nullptr;
+    int hellos = 0, updates = 0;
+    Peer(bool server, const char *version, const char *cert, const char *key) {
+        ctx = SSL_CTX_new(TLS_method()); assert(ctx);
+        int v = !strcmp(version,"1.3") ? TLS1_3_VERSION : TLS1_2_VERSION;
+        assert(SSL_CTX_set_min_proto_version(ctx,v));
+        assert(SSL_CTX_set_max_proto_version(ctx,v));
+        assert(SSL_CTX_use_certificate_chain_file(ctx,cert)==1);
+        assert(SSL_CTX_use_PrivateKey_file(ctx,key,SSL_FILETYPE_PEM)==1);
+        assert(SSL_CTX_load_verify_locations(ctx,cert,nullptr)==1);
+        SSL_CTX_set_verify(ctx,server ? SSL_VERIFY_NONE : SSL_VERIFY_PEER,nullptr);
+        assert(SSL_CTX_set1_groups_list(ctx,server ? "P-256" : "X25519:P-256"));
+        SSL_CTX_set_msg_callback(ctx, [](int write, int, int type, const void *buf,
+                                       size_t len, SSL *, void *arg) {
+            auto p = static_cast<Peer *>(arg);
+            if (!write && type==SSL3_RT_HANDSHAKE && len) {
+                unsigned char msg = *static_cast<const unsigned char *>(buf);
+                if (msg==SSL3_MT_CLIENT_HELLO) ++p->hellos;
+                if (msg==SSL3_MT_KEY_UPDATE) ++p->updates;
+            }
+        });
+        SSL_CTX_set_msg_callback_arg(ctx,this);
+        if (!server) {
+            SSL_CTX_set_session_cache_mode(ctx,SSL_SESS_CACHE_CLIENT|SSL_SESS_CACHE_NO_INTERNAL);
+            SSL_CTX_sess_set_new_cb(ctx, [](SSL *ssl, SSL_SESSION *session) {
+                auto peer=static_cast<Peer *>(SSL_get_app_data(ssl));
+                SSL_SESSION_free(peer->ticket); peer->ticket=session; return 1;
+            });
+        }
+        reset(server);
+    }
+    void reset(bool server) {
+        SSL_free(ssl); BIO_free(wire);
+        ssl=SSL_new(ctx); assert(ssl); SSL_set_app_data(ssl,this);
+        BIO *inside=nullptr;
+#ifdef OPENSSL_IS_AWSLC
+        assert(transport::create(&inside,128,&wire,128)==1);
+#else
+        assert(BIO_new_bio_pair(&inside,128,&wire,128)==1);
+#endif
+        SSL_set_bio(ssl,inside,inside);
+        if (server) SSL_set_accept_state(ssl);
+        else {
+            SSL_set_connect_state(ssl);
+            assert(SSL_set1_host(ssl,"localhost"));
+            assert(SSL_set_tlsext_host_name(ssl,"localhost"));
+        }
+    }
+    ~Peer() { SSL_SESSION_free(ticket); SSL_free(ssl); BIO_free(wire); SSL_CTX_free(ctx); }
+    void check(int rc) {
+        if (rc>0) return;
+        int e=SSL_get_error(ssl,rc);
+        if (e!=SSL_ERROR_WANT_READ && e!=SSL_ERROR_WANT_WRITE && e!=SSL_ERROR_ZERO_RETURN) {
+            ERR_print_errors_fp(stderr); assert(false);
+        }
+    }
+    void handshake() { ERR_clear_error(); int rc=SSL_do_handshake(ssl); check(rc); }
+    size_t read(char *b,size_t len) { size_t n=0; ERR_clear_error(); int rc=SSL_read_ex(ssl,b,len,&n); check(rc); return n; }
+    size_t write(const char *b,size_t len) { size_t n=0; ERR_clear_error(); int rc=SSL_write_ex(ssl,b,len,&n); check(rc); return n; }
+    void shutdown() { ERR_clear_error(); int rc=SSL_shutdown(ssl); if(rc<0) check(rc); }
+};
+static void move(Flow &flow,Peer &peer) {
+    const uint8_t *buf=nullptr;
+    size_t n=std::min<size_t>(flow.peek(&buf),17), accepted=0;
+    if (n) { BIO_write_ex(peer.wire,buf,n,&accepted); flow.consume(accepted); }
+#ifdef OPENSSL_IS_AWSLC
+    const uint8_t *wire=nullptr;
+    size_t available=transport::peek(peer.wire,&wire);
+    if (available) transport::consume(peer.wire,flow.feed(wire,std::min<size_t>(available,19)));
+#else
+    char *wire=nullptr;
+    int available=BIO_nread0(peer.wire,&wire);
+    if (available>0) {
+        n=flow.feed(wire,std::min(available,19));
+        BIO_nread(peer.wire,&wire,int(n));
+    }
+#endif
+}
+static void test(bool server,const char *version,const char *cert,const char *key,bool automatic=true) {
+    Config cfg; cfg.server=server; cfg.version=version; cfg.bio_capacity=128;
+    if(server) { cfg.cert=cert; cfg.key=key; } else { cfg.sni="localhost"; cfg.ca=cert; }
+    auto ctx=std::make_shared<Context>(cfg);
+    assert(SSL_CTX_set1_groups_list(ctx->ctx,server ? "P-256" : "X25519:P-256"));
+    if(!automatic) { SSL_CTX_clear_mode(ctx->ctx,SSL_MODE_AUTO_RETRY); SSL_CTX_set_read_ahead(ctx->ctx,1); }
+    Flow flow(ctx); flow.coalesce_reads(true); Peer peer(!server,version,cert,key);
+    for(int i=0;i<200000;++i) {
+        flow.handshake(); peer.handshake(); move(flow,peer);
+        char byte;
+        if(flow.ready()) assert(flow.read(&byte,1)==0);
+        if(SSL_is_init_finished(peer.ssl)) assert(peer.read(&byte,1)==0);
+        assert(!flow.failed());
+        if(flow.ready() && SSL_is_init_finished(peer.ssl) && !flow.pending() && !BIO_ctrl_pending(peer.wire)) break;
+        assert(i!=199999);
+    }
+    if(!server && cfg.version=="1.3") assert(peer.hellos==2); // HelloRetryRequest actually occurred.
+    for(int round=0;round<4;++round) {
+        // Put Flow into a real WANT_WRITE before the peer's KeyUpdate arrives.
+        std::string bulk(2048, char('a' + round)), received;
+        assert(flow.write(bulk.data(), bulk.size()) == 0);
+        assert(flow.write_blocks_read());
+        if(cfg.version=="1.3") {
+            assert(SSL_key_update(peer.ssl,SSL_KEY_UPDATE_REQUESTED)==1);
+            peer.handshake();
+        }
+        size_t accepted = 0;
+        for (int i = 0; i < 200000; ++i) {
+            move(flow, peer);
+            char b[257];
+            if (flow.write_blocks_read()) {
+                size_t pending = flow.input_pending();
+                assert(flow.read(b, sizeof(b)) == 0);
+                assert(flow.input_pending() == pending);
+            }
+            received.append(b, peer.read(b, sizeof(b)));
+            if (!accepted) accepted = flow.write(bulk.data(), bulk.size());
+            assert(!flow.failed());
+            if (accepted && received == bulk) break;
+            assert(i != 199999);
+        }
+        assert(accepted == bulk.size() && !flow.write_retry_pending());
+        const char request[]="post-handshake request";
+        const char response[]="post-handshake response";
+        size_t sent=0, replied=0; std::string got, answer;
+        for(int i=0;i<200000;++i) {
+            if(sent<sizeof(request)-1) sent+=peer.write(request+sent,sizeof(request)-1-sent);
+            move(flow,peer);
+            char b[7]; got.append(b,flow.read(b,sizeof(b)));
+            if(got==request && replied<sizeof(response)-1) replied+=flow.write(response+replied,sizeof(response)-1-replied);
+            move(flow,peer); answer.append(b,peer.read(b,sizeof(b)));
+            assert(!flow.failed());
+            if(answer==response) break;
+            assert(i!=199999);
+        }
+        assert(got==request && answer==response);
+        if(cfg.version=="1.3") assert(peer.updates==round+1);
+    }
+    // Both endpoints initiate close without waiting for the other one.
+    for(int i=0;i<10000;++i) {
+        flow.shutdown(); peer.shutdown(); move(flow,peer);
+        char b; flow.read(&b,1); peer.read(&b,1);
+        assert(!flow.failed());
+        if(flow.sent_close() && flow.peer_closed() && (SSL_get_shutdown(peer.ssl)&SSL_RECEIVED_SHUTDOWN)) break;
+        assert(i!=9999);
+    }
+    std::cout<<version<<" Flow "<<(server?"server":"client")<<" protocol OK\n";
+}
+static void alpn_policy(const char *version,const char *cert,const char *key) {
+    Config cfg; cfg.version=version; cfg.sni="localhost"; cfg.ca=cert; cfg.alpn="h2";
+    Flow flow(std::make_shared<Context>(cfg)); flow.coalesce_reads(true); Peer peer(true,version,cert,key);
+    // The independent peer deliberately has no ALPN selection callback.
+    for(int i=0;i<200000 && !flow.failed();++i) {
+        flow.handshake();
+        if(flow.failed()) break;
+        peer.handshake(); move(flow,peer);
+    }
+    assert(flow.failed() && flow.failure()==Failure::POLICY && !flow.ready());
+}
+
+static void resumption(bool server,const char *version,const char *cert,const char *key) {
+    Config cfg; cfg.server=server; cfg.version=version; cfg.bio_capacity=128; cfg.resumption=true;
+    if(server) { cfg.cert=cert; cfg.key=key; } else { cfg.sni="localhost"; cfg.ca=cert; }
+    auto ctx=std::make_shared<Context>(cfg);
+    Peer peer(!server,version,cert,key);
+    SSL_SESSION *saved=nullptr;
+    for (int round=0;round<4;++round) {
+        if (round) {
+            peer.reset(!server);
+            if (server) { assert(saved); assert(SSL_set_session(peer.ssl,saved)==1); }
+        }
+        Flow flow(ctx); flow.coalesce_reads(true);
+        for (unsigned i=0;i<200000;++i) {
+            flow.handshake(); peer.handshake(); move(flow,peer);
+            char b;
+            if(flow.ready()) assert(flow.read(&b,1)==0);
+            if(SSL_is_init_finished(peer.ssl)) assert(peer.read(&b,1)==0);
+            assert(!flow.failed());
+            if(flow.ready() && SSL_is_init_finished(peer.ssl) && !flow.pending() &&
+               !BIO_ctrl_pending(peer.wire) && !flow.input_pending() &&
+               !BIO_ctrl_pending(SSL_get_rbio(peer.ssl))) break;
+            assert(i!=199999);
+        }
+        assert(flow.resumed()==(round!=0));
+        assert(bool(SSL_session_reused(peer.ssl))==(round!=0));
+        bool sent=false, received=false;
+        for(unsigned i=0;i<10000 && !received;++i) {
+            if(!sent) sent=peer.write("https",5)==5;
+            move(flow,peer); char b[5]; auto n=flow.read(b,sizeof(b));
+            if(n) { assert(n==5 && std::string(b,n)=="https"); received=true; }
+            assert(!flow.failed());
+        }
+        assert(received);
+        for(unsigned i=0;i<10000;++i) {
+            flow.shutdown(); peer.shutdown(); move(flow,peer);
+            char b; flow.read(&b,1); peer.read(&b,1);
+            assert(!flow.failed());
+            if(flow.sent_close() && flow.peer_closed() &&
+               (SSL_get_shutdown(peer.ssl)&SSL_RECEIVED_SHUTDOWN)) break;
+            assert(i!=9999);
+        }
+        if(server) { SSL_SESSION_free(saved); saved=peer.ticket; peer.ticket=nullptr;
+            if (!saved) saved=SSL_get1_session(peer.ssl); }
+    }
+    SSL_SESSION_free(saved);
+    std::cout<<version<<" independent resumption "<<(server?"server":"client")<<" OK\n";
+}
+
+int main(int argc,char **argv) {
+    assert(argc==3);
+    for(auto version:{"1.2","1.3"}) {
+        for(bool server:{false,true}) for(bool automatic:{false,true}) test(server,version,argv[1],argv[2],automatic);
+        alpn_policy(version,argv[1],argv[2]);
+        for(bool server:{false,true}) resumption(server,version,argv[1],argv[2]);
+    }
+}
diff --git a/tests/tls/record_coalescing_test.cpp b/tests/tls/record_coalescing_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/record_coalescing_test.cpp
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <cassert>
+#include <chrono>
+#include <cstring>
+#include <iostream>
+using namespace astf_tls;
+static uint64_t data_ns=0;
+static void move(Flow &a, Flow &b, size_t size) {
+    const uint8_t *p=nullptr; size_t n=std::min(size,a.peek(&p));
+    if(n) a.consume(b.feed(p,n));
+}
+static void connect(Flow &c,Flow &s) {
+    for(unsigned i=0;i<100000;++i) {
+        c.handshake();s.handshake();move(c,s,1460);move(s,c,1460);
+        assert(!c.failed()&&!s.failed());
+        if(c.ready()&&s.ready()&&!c.pending()&&!s.pending()) return;
+    }
+    assert(false);
+}
+static size_t run(const char *cert,const char *key,bool coalesce,size_t capacity,size_t fragment) {
+    Config c,s;c.ca=cert;c.sni="localhost";s.server=true;s.cert=cert;s.key=key;
+    c.bio_capacity=s.bio_capacity=capacity;
+    c.cipher_suite=s.cipher_suite="TLS_AES_128_GCM_SHA256";
+    Flow client(std::make_shared<Context>(c)),server(std::make_shared<Context>(s));
+    client.coalesce_reads(coalesce);server.coalesce_reads(coalesce);
+    connect(client,server);
+    char out[16384];std::string input(16384,'x');size_t sent=0,received=0,calls=0;
+    auto data_start=std::chrono::steady_clock::now();
+    const size_t total=164784; // fixed workload, both modes identical
+    for(unsigned i=0;i<2000000&&received<total;++i) {
+        if(sent<total)sent+=server.write(input.data(),std::min<size_t>(total-sent,std::min<size_t>(16384,capacity-64)));
+        move(server,client,fragment);move(client,server,fragment);
+        while(client.read_can_progress()) {
+            ++calls;size_t n=client.read(out,sizeof(out));received+=n;
+            for(size_t j=0;j<n;++j)assert(out[j]=='x');
+            if(!n)break;
+        }
+        assert(!client.failed()&&!server.failed());
+    }
+    data_ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-data_start).count();
+    assert(sent==total&&received==total);
+    server.shutdown();
+    for(int i=0;i<100000&&!client.peer_closed();++i) {
+        server.shutdown();move(server,client,fragment);client.read(out,sizeof(out));
+    }
+    assert(client.peer_closed()&&!client.failed());
+    client.shutdown();
+    for(int i=0;i<100000&&!server.peer_closed();++i) {
+        client.shutdown();move(client,server,fragment);server.read(out,sizeof(out));
+    }
+    assert(server.peer_closed()&&!server.failed());
+    return calls;
+}
+static void guards(const char *cert,const char *key) {
+    Config c,s;c.ca=cert;c.sni="localhost";s.server=true;s.cert=cert;s.key=key;
+    Flow client(std::make_shared<Context>(c)),server(std::make_shared<Context>(s));
+    client.coalesce_reads(true);connect(client,server);char out[32];
+    assert(client.read(out,sizeof(out))==0);
+    assert(server.write("data",4)==4);move(server,client,1);
+    assert(!client.read_can_progress());
+    // Adapter must be able to restore partial reads for small TCP windows.
+    client.coalesce_reads(false);assert(client.read_can_progress());
+    assert(client.read(out,sizeof(out))==0);
+    client.coalesce_reads(true);move(server,client,65536);
+    assert(client.read(out,sizeof(out))==4);
+    assert(client.read(out,sizeof(out))==0);
+    assert(server.write("data",4)==4);
+    const uint8_t *wire=nullptr;assert(server.peek(&wire)>=5);
+    uint8_t header[5];std::memcpy(header,wire,5);header[3]=65;header[4]=1; // 16641 exceeds TLS 1.3 ciphertext maximum
+    assert(client.feed(header,5)==5);assert(client.read_can_progress());
+    client.read(out,sizeof(out));
+    // The library may defer its TLS-version-specific size check until the
+    // body arrives. The adapter must dispatch now, not wait for that body.
+    assert(client.failed() || client.input_pending()==0);
+    client.eof();client.read(out,sizeof(out));assert(client.failed());
+}
+int main(int argc,char **argv) {
+    assert(argc==3 || argc==4);
+    if(argc==4) {
+        uint64_t sums[2]={0,0};
+        for(int i=0;i<100;++i) for(int order=0;order<2;++order) {
+            int mode=(i+order)%2;run(argv[1],argv[2],mode,65536,1460);sums[mode]+=data_ns;
+        }
+        std::cout<<"data_path_us baseline="<<sums[0]/100000.0<<" coalesced="<<sums[1]/100000.0
+                 <<" (100 alternating runs, same 164784 plaintext bytes; no TCP/NIC)\n";
+        return 0;
+    }
+    guards(argv[1],argv[2]);
+    for(size_t capacity:{size_t(128),size_t(65536)})for(size_t fragment:{size_t(1),size_t(1460)}) {
+        auto before=run(argv[1],argv[2],false,capacity,fragment);
+        auto after=run(argv[1],argv[2],true,capacity,fragment);
+        if(capacity==65536)assert(after<before/2);
+        std::cout<<"capacity="<<capacity<<" fragment="<<fragment<<" SSL_read attempts "<<before<<" -> "<<after<<" payload/close PASS\n";
+    }
+}
diff --git a/tests/tls/record_fuzzer.cpp b/tests/tls/record_fuzzer.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/record_fuzzer.cpp
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Build with clang++ -fsanitize=fuzzer,address,undefined. No network I/O.
+#include "44bsd/tls/astf_tls.h"
+#include <algorithm>
+#include <cassert>
+#include <cstdlib>
+#include <stdexcept>
+using namespace astf_tls;
+static void move(Flow &a,Flow &b) {
+    const uint8_t *p=nullptr; size_t n=a.peek(&p);
+    if(n) a.consume(b.feed(p,n));
+}
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data,size_t size) {
+    if(size<2 || size>4096) return 0;
+    Config c,s; c.version=s.version=(data[0]&1)?"1.3":"1.2";
+    const char *cert=std::getenv("TREX_TLS_TEST_CERT");
+    const char *key=std::getenv("TREX_TLS_TEST_KEY");
+    if (!cert || !key) throw std::runtime_error("record fuzzer requires TREX_TLS_TEST_CERT/KEY");
+    c.sni="localhost"; c.ca=cert;
+    s.server=true; s.cert=cert; s.key=key;
+    Flow client(std::make_shared<Context>(c)),server(std::make_shared<Context>(s));
+    for(int i=0;i<1000;++i) {
+        client.handshake(); server.handshake(); move(client,server); move(server,client);
+        assert(!client.failed() && !server.failed());
+        if(client.ready() && server.ready() && !client.pending() && !server.pending()) break;
+        assert(i!=999);
+    }
+    std::vector<uint8_t> wire;
+    bool arbitrary=data[0]&2, corrupt=data[0]&4;
+    if(arbitrary) wire.assign(data+2,data+size);
+    else {
+        assert(client.write(data,size)==size);
+        wire.resize(client.pending());
+        assert(client.drain(wire.data(),wire.size())==wire.size());
+        if(corrupt) wire.back()^=1;
+    }
+    size_t offset=0; std::string plaintext;
+    for(int i=0;i<10000 && offset<wire.size() && !server.failed();++i) {
+        size_t n=std::min<size_t>(1+data[1]%127,wire.size()-offset);
+        offset+=server.feed(wire.data()+offset,n);
+        char b[193]; plaintext.append(b,server.read(b,sizeof(b)));
+    }
+    server.eof();
+    for(int i=0;i<32 && !server.failed();++i) {
+        char b[4096]; plaintext.append(b,server.read(b,sizeof(b)));
+    }
+    if(!arbitrary && !corrupt) {
+        assert(plaintext==std::string(reinterpret_cast<const char *>(data),size));
+    } else assert(plaintext.empty()); // unauthenticated records never reach ASTF
+    assert(server.failed()); // all cases omit close_notify
+    return 0;
+}
