+import unittest
+from trex.astf.api import ASTFProgram, ASTFError, ASTFTemplate, ASTFTCPClientTemplate, ASTFTCPServerTemplate, ASTFIPGen, ASTFIPGenDist
+
+class UDPRequestAPI(unittest.TestCase):
+    def test_command(self):
+        p=ASTFProgram(stream=False)
+        p.udp_request(b'ab',timeout_ms=50,size=18,fill=b'x')
+        p.recv_msg(1)
+        commands=p.to_json()['commands']
+        self.assertEqual(commands[0]['name'],'udp_request')
+        self.assertEqual(commands[0]['timeout_ms'],50)
+        self.assertEqual(commands[1]['min_pkts'],1)  # independent receive watermark
+        self.assertEqual(p.total_send_bytes,18)
+        self.assertNotIn('http',p.to_json())
+    def test_reject(self):
+        for p in (ASTFProgram(), ASTFProgram(stream=False,addon='latency')):
+            with self.assertRaises(ASTFError): p.udp_request(b'x')
+        for value in (0,-1,60001,True,1.5,'1000',None):
+            p=ASTFProgram(stream=False)
+            with self.assertRaises(ASTFError): p.udp_request(b'x',timeout_ms=value)
+            self.assertEqual(p.to_json()['commands'],[])
+    def test_server_rejected(self):
+        c=ASTFProgram(stream=False);c.send_msg(b'x')
+        s=ASTFProgram(stream=False);s.udp_request(b'y')
+        ip=ASTFIPGen(dist_client=ASTFIPGenDist(ip_range=['16.0.0.1','16.0.0.2']),
+                    dist_server=ASTFIPGenDist(ip_range=['48.0.0.1','48.0.0.2']))
+        with self.assertRaises(ASTFError):
+            ASTFTemplate(client_template=ASTFTCPClientTemplate(program=c,ip_gen=ip),
+                         server_template=ASTFTCPServerTemplate(program=s))
+    def test_old_udp(self):
+        p=ASTFProgram(stream=False);p.send_msg(b'x');p.recv_msg(1)
+        self.assertEqual([c['name'] for c in p.to_json()['commands']],['tx_msg','rx_msg'])
+if __name__=='__main__': unittest.main()
