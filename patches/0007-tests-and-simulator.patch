+// Exercise the production overlap policy, including sequence wraparound.
+extern bool tcp_reass_merge_block(CPerProfileCtx *,CTcpCb *,CTcpReassBlock &,CTcpReassBlock &);
+TEST_F(gt_tcp, reassembly_rx_timestamps) {
+    for(uint32_t seq : {1000u,0xfffffffcu}) {
+        CTcpReassTest tst;tst.Create();
+        CTcpReassBlock a{seq,8,0},b{uint32_t(seq+4),8,0};
+        a.m_payload=std::make_shared<astf_rx::Payload>();
+        b.m_payload=std::make_shared<astf_rx::Payload>();
+        a.m_payload->assign(8,'a');b.m_payload->assign(8,'b');
+        a.m_payload->times.emplace_back(8,astf_rx::Stamp(20,20));
+        b.m_payload->times.emplace_back(8,astf_rx::Stamp(10,10));
+        EXPECT_TRUE(tcp_reass_merge_block(DEFAULT_PROFILE_CTX(&tst.m_ctx),&tst.m_flow.m_tcp,a,b));
+        EXPECT_EQ(size_t(12),a.m_payload->size());
+        ASSERT_EQ(size_t(2),a.m_payload->times.size());
+        EXPECT_EQ(size_t(8),a.m_payload->times[0].size);
+        EXPECT_EQ(uint64_t(20),a.m_payload->times[0].time.first);
+        EXPECT_EQ(size_t(4),a.m_payload->times[1].size);
+        EXPECT_EQ(uint64_t(10),a.m_payload->times[1].time.first);
+        // A duplicate cannot replace timestamps or append metadata.
+        EXPECT_TRUE(tcp_reass_merge_block(DEFAULT_PROFILE_CTX(&tst.m_ctx),&tst.m_flow.m_tcp,a,b));
+        EXPECT_EQ(size_t(2),a.m_payload->times.size());
+        EXPECT_EQ(size_t(12),a.m_payload->size());
+        for(size_t i=0;i<12;++i)EXPECT_EQ(i<8?'a':'b',(*a.m_payload)[i]);
+        tst.Delete();
+    }
+}
