+static Json::Value tls_reload_profile() {
+    // Reuse an existing schema-complete profile, replacing its UDP programs.
+    std::ifstream input("automation/regression/data/astf_dns.json");
+    Json::Value profile;
+    Json::Reader reader;
+    if (!reader.parse(input, profile)) throw std::runtime_error("Cannot read test profile");
+    profile["buf_list"] = Json::Value(Json::arrayValue);
+    profile["buf_list"].append("eA==");
+    profile["program_list"] = Json::Value(Json::arrayValue);
+    for (int side = 0; side != 2; ++side) {
+        Json::Value program;
+        program["stream"] = true;
+        Json::Value command;
+        command["name"] = side ? "rx" : "tx";
+        if (side) command["min_bytes"] = 1;
+        else command["buf_index"] = 0;
+        program["commands"].append(command);
+        program["tls"]["server"] = bool(side);
+#ifdef OPENSSL_IS_AWSLC
+        const char *cert=std::getenv("TREX_TLS_TEST_CERT"), *key=std::getenv("TREX_TLS_TEST_KEY");
+        if (!cert || !key) throw std::runtime_error("AWS-LC tests need TREX_TLS_TEST_CERT/KEY");
+        if (side) { program["tls"]["cert"]=cert; program["tls"]["key"]=key; }
+        else { program["tls"]["ca"]=cert; program["tls"]["sni"]="localhost"; }
+#else
+        program["tls"]["psk_identity"] = "reload-test";
+        program["tls"]["psk_hex"] = "0123456789abcdef0123456789abcdef";
+#endif
+        profile["program_list"].append(program);
+    }
+    return profile;
+}
