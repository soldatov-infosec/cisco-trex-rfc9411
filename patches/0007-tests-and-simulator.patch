+            cmd+=shlex.split(os.environ.get('LDFLAGS',''))+['-lssl','-lcrypto','-o',str(binary)]
+            meta['build_command']=cmd;save()
+            result=subprocess.run(cmd,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=180)
