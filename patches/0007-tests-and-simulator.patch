+            inspect=['ldd',str(binary)] if platform.system()=='Linux' else ['otool','-L',str(binary)]
+            linked=subprocess.check_output(inspect,text=True)
+            (out/'linked-libraries.txt').write_text(linked)
+            loaded=sorted(set(re.findall(r'/[^\s]*/lib(?:ssl|crypto)\.so[^\s]*',linked)))
+            meta['benchmark_libraries']=loaded
+            meta['library_paths_match_capture']=bool(loaded) and {str(Path(f).resolve()) for f in loaded}=={str(Path(f).resolve()) for f in meta['captured_libraries']}
+            meta['library_sha256']={f:hashlib.sha256(Path(f).read_bytes()).hexdigest() for f in loaded}
+            if a.capture and not meta['library_paths_match_capture']:
+                raise RuntimeError('benchmark libssl/libcrypto paths differ from captured process; check linked-libraries.txt')
+            if platform.system()=='Linux':
+                (out/'lscpu.txt').write_text(subprocess.check_output(['lscpu'],text=True))
+            jobs=[(op,n,r,shift) for op in ('full',)
+                  for n in threads for r in range(a.repeats) for shift in ('8','off')]
+            random.Random(20261007).shuffle(jobs)
+            for op,n,r,shift in jobs:
+                ensure_idle()
+                env['TREX_ASTF_COST_SHIFT']=shift
+                command=[str(binary),'libctx',str(n),str(a.seconds),a.cert,a.key,a.ca,a.version,'0',op,a.hostname]
+                result=subprocess.run(command,env=env,text=True,capture_output=True,timeout=a.seconds+120)
+                row=dict(operation=op,threads=n,repeat=r,shift=shift,returncode=result.returncode,stderr=result.stderr)
+                try:row['result']=json.loads(result.stdout)
+                except ValueError:row['stdout']=result.stdout
