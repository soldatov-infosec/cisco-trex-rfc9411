+++ b/tests/tls/audit_build.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Check TLS feature flags in the DPDK compile database and simulator-hook absence."""
+import argparse
+import json
+from pathlib import Path
+import shlex
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--commands', default='linux_dpdk/build_dpdk/compile_commands.json')
+parser.add_argument('--binary', default='linux_dpdk/build_dpdk/linux_dpdk/_t-rex-64-debug')
+parser.add_argument('--aws-lc-prefix', help='Require both AWS-LC runtime libraries under this prefix')
+args = parser.parse_args()
+entries = json.loads(Path(args.commands).read_text())
+checked = []
+for entry in entries:
+    name = entry['file'].replace('\\', '/')
+    if '/src/44bsd/' not in name and '/src/astf/' not in name and not name.endswith('/src/stt_cp.cpp'):
+        continue
+    command = entry.get('arguments') or shlex.split(entry['command'])
+    if any(arg.startswith(('-DTREX_TLS_BATCH_VERIFY', '-DTREX_TLS_CRYPTO_MB')) for arg in command):
+        raise SystemExit('Obsolete TLS batching flag: ' + name)
+    if '-DTREX_TLS' not in command:
+        raise SystemExit('Missing TREX_TLS: ' + name)
+    checked.append(name)
+if not any(n.endswith('/netinet/tcp_input.c') for n in checked):
+    raise SystemExit('TCP C source absent from compile database')
+if not any(n.endswith('/44bsd/tcp_socket.cpp') for n in checked):
+    raise SystemExit('TCP C++ source absent from compile database')
+result = subprocess.run(['nm', '-C', args.binary], check=True, text=True, stdout=subprocess.PIPE)
+for line in result.stdout.splitlines():
+    if any(marker in line for marker in ('astf_tls::LibraryScope', 'astf_tls::Batch',
+                                         'mbx_nistp256_ecdsa_verify')):
+        raise SystemExit('Obsolete TLS backend/batching symbol: ' + line)
+    if any(marker in line for marker in ('tls_test_', 'tls_invariant_fault',
+                                         'tls_allocation_budget', 'tls_reass_failure',
+                                         'tls_reass_length_fault')):
+        raise SystemExit('Simulator hook in production binary: ' + line)
+print('TLS flags: PASS ({} compile entries, including TCP C and C++)'.format(len(checked)))
+print('Production binary simulator-hook exclusion: PASS')
+print('Removed TLS scopes/batching flags and symbols: PASS')
+
+if args.aws_lc_prefix:
+    prefix = Path(args.aws_lc_prefix).resolve()
+    linked = subprocess.check_output(['ldd', args.binary], text=True)
+    found = {}
+    for line in linked.splitlines():
+        fields = line.split()
+        if len(fields) >= 3 and (fields[0].startswith('libssl.so') or fields[0].startswith('libcrypto.so')) and fields[1] == '=>':
+            resolved = Path(fields[2]).resolve()
+            try:
+                resolved.relative_to(prefix)
+            except ValueError:
+                raise SystemExit('TLS library loaded outside requested prefix: ' + str(resolved))
+            key = fields[0].split('.so')[0]
+            if key in found: raise SystemExit('Multiple TLS libraries loaded: ' + linked)
+            found[key] = str(resolved)
+    if set(found) != {'libssl', 'libcrypto'}:
+        raise SystemExit('Cannot confirm both TLS runtime libraries: ' + linked)
+    print('TLS runtime prefix: PASS ' + json.dumps(found, sort_keys=True))
