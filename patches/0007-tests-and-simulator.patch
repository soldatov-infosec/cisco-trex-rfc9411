+TEST(astf_scheduler, sustained_overload_preserves_all_work) {
+    CAstfScheduler policy;
+    double now=0,offset=0;
+    unsigned processed=0;
+    for (unsigned i=0;i<1000;++i) {
+        double due=i*0.0001+offset;
+        if (policy.should_stretch(now,now-due,0.0001,true)) offset+=now-due;
+        now+=0.0002; // offered work exceeds CPU capacity
+        ++processed;
+    }
+    EXPECT_EQ(1000u,processed);
+    EXPECT_GT(now,0.19);
+    EXPECT_GT(offset,0.08);
+    EXPECT_GT(policy.snapshot()[CAstfScheduler::STRETCHES],5u);
+}
