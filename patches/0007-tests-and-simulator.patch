@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Diagnostic primitives, not a substitute for a TLS transcript benchmark.
+#include <openssl/pem.h>
+#include <openssl/rsa.h>
+#include <openssl/x509_vfy.h>
+#include <memory>
+struct Primitives {
+    template<class T, void (*Free)(T*)> using Ptr=std::unique_ptr<T, decltype(Free)>;
+    Ptr<EVP_PKEY,EVP_PKEY_free> key{nullptr,EVP_PKEY_free}, a{nullptr,EVP_PKEY_free}, b{nullptr,EVP_PKEY_free};
+    Ptr<X509,X509_free> cert{nullptr,X509_free};
+    Ptr<X509_STORE,X509_STORE_free> store{X509_STORE_new(),X509_STORE_free};
+    std::vector<unsigned char> signature;
+    std::string operation, group, hostname;
+    OSSL_LIB_CTX *lib;
+    static void ensure(bool b) { if (!b) throw std::runtime_error("primitive OpenSSL operation failed"); }
+    Primitives(std::string op, const char *certfile, const char *keyfile, const char *ca,
+               OSSL_LIB_CTX *ctx, std::string host): operation(op), hostname(host), lib(ctx) {
+        group=op.find("p256")!=std::string::npos ? "P-256" : "X25519";
+        if (op=="sign" || op=="verify" || op=="cert_verify") {
+            Ptr<BIO,BIO_free_all> bio{BIO_new_file(certfile,"r"),BIO_free_all}; ensure(bool(bio));
+            cert.reset(PEM_read_bio_X509(bio.get(),nullptr,nullptr,nullptr)); ensure(bool(cert));
+            ensure(bool(store) && X509_STORE_load_locations(store.get(),ca,nullptr)==1);
+            if (op!="cert_verify") {
+                Ptr<BIO,BIO_free_all> kb{BIO_new_file(keyfile,"r"),BIO_free_all};ensure(bool(kb));
+                key.reset(PEM_read_bio_PrivateKey_ex(kb.get(),nullptr,[](char*,int,int,void*) { return 0; },nullptr,ctx,nullptr));ensure(bool(key));
+                ensure(X509_check_private_key(cert.get(),key.get())==1);
+                signature.resize(EVP_PKEY_get_size(key.get())); sign();
+                if (op=="verify") { key.reset(X509_get_pubkey(cert.get())); ensure(bool(key)); }
+            }
+        } else if (op.find("derive_")==0 || op.find("keygen_")==0) {
+            a.reset(generate());b.reset(generate());ensure(bool(a)&&bool(b));
+        } else throw std::runtime_error("unknown primitive");
+    }
+    EVP_PKEY *generate() {
+        return group=="X25519" ? EVP_PKEY_Q_keygen(lib,nullptr,"X25519") : EVP_PKEY_Q_keygen(lib,nullptr,"EC","P-256");
+    }
+    void init(EVP_MD_CTX *md, bool signing) {
+        EVP_PKEY_CTX *pk=nullptr;
+        ensure((signing ? EVP_DigestSignInit_ex(md,&pk,"SHA256",lib,nullptr,key.get(),nullptr) :
+            EVP_DigestVerifyInit_ex(md,&pk,"SHA256",lib,nullptr,key.get(),nullptr))==1);
+        if (EVP_PKEY_is_a(key.get(),"RSA") || EVP_PKEY_is_a(key.get(),"RSA-PSS")) {
+            ensure(EVP_PKEY_CTX_set_rsa_padding(pk,RSA_PKCS1_PSS_PADDING)>0);
+            ensure(EVP_PKEY_CTX_set_rsa_pss_saltlen(pk,RSA_PSS_SALTLEN_DIGEST)>0);
+        }
+    }
+    void sign() {
+        Ptr<EVP_MD_CTX,EVP_MD_CTX_free> md{EVP_MD_CTX_new(),EVP_MD_CTX_free};ensure(bool(md));init(md.get(),true);
+        unsigned char transcript[130]={0};size_t len=signature.size();
+        ensure(EVP_DigestSign(md.get(),signature.data(),&len,transcript,sizeof(transcript))==1);signature.resize(len);
+    }
+    void run() {
+        if (operation=="sign") { signature.resize(EVP_PKEY_get_size(key.get()));sign(); }
+        else if (operation=="verify") {
+            Ptr<EVP_MD_CTX,EVP_MD_CTX_free> md{EVP_MD_CTX_new(),EVP_MD_CTX_free};ensure(bool(md));init(md.get(),false);
+            unsigned char transcript[130]={0};
+            ensure(EVP_DigestVerify(md.get(),signature.data(),signature.size(),transcript,sizeof(transcript))==1);
+        } else if (operation=="cert_verify") {
+            Ptr<X509_STORE_CTX,X509_STORE_CTX_free> c{X509_STORE_CTX_new_ex(lib,nullptr),X509_STORE_CTX_free};ensure(bool(c));
+            ensure(X509_STORE_CTX_init(c.get(),store.get(),cert.get(),nullptr)==1);
+            ensure(X509_STORE_CTX_set_purpose(c.get(),X509_PURPOSE_SSL_SERVER)==1);
+            ensure(X509_VERIFY_PARAM_set1_host(X509_STORE_CTX_get0_param(c.get()),hostname.c_str(),0)==1);
+            ensure(X509_verify_cert(c.get())==1);
+        } else if (operation.find("keygen_")==0) {
+            Ptr<EVP_PKEY,EVP_PKEY_free> k{generate(),EVP_PKEY_free};ensure(bool(k));
+        } else {
+            Ptr<EVP_PKEY_CTX,EVP_PKEY_CTX_free> ctx{EVP_PKEY_CTX_new_from_pkey(lib,a.get(),nullptr),EVP_PKEY_CTX_free};ensure(bool(ctx));
+            ensure(EVP_PKEY_derive_init(ctx.get())==1 && EVP_PKEY_derive_set_peer(ctx.get(),b.get())==1);
+            unsigned char secret[128];size_t len=sizeof(secret);ensure(EVP_PKEY_derive(ctx.get(),secret,&len)==1);
+            OPENSSL_cleanse(secret,sizeof(secret));
+        }
+    }
+};
diff --git a/tests/tls/handshake_verify_cost.cpp b/tests/tls/handshake_verify_cost.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/handshake_verify_cost.cpp
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Local diagnostic only: time default X509 verification, never skip it.
+#include "44bsd/tls/astf_tls.h"
+#include <openssl/x509.h>
+#include <cassert>
+#include <chrono>
+#include <iostream>
+using namespace astf_tls;
+using Clock=std::chrono::steady_clock;
+struct Cost { uint64_t ns=0,calls=0; };
+static int verify(X509_STORE_CTX *ctx,void *arg) {
+    auto start=Clock::now();int rc=X509_verify_cert(ctx);
+    auto &c=*static_cast<Cost *>(arg);++c.calls;
+    c.ns+=std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now()-start).count();
+    return rc;
+}
+static void move(Flow &a,Flow &b) {
+    const uint8_t *p=nullptr;size_t n=a.peek(&p);if(n)a.consume(b.feed(p,n));
+}
+int main(int argc,char **argv) {
+    assert(argc==3);Config c,s;c.ca=argv[1];c.sni="localhost";s.server=true;s.cert=argv[1];s.key=argv[2];
+    c.cipher_suite=s.cipher_suite="TLS_AES_128_GCM_SHA256";
+    auto lib=std::make_shared<Library>();
+    auto cc=std::make_shared<Context>(c)->clone_for_worker(lib),sc=std::make_shared<Context>(s)->clone_for_worker(lib);
+    Cost cost;SSL_CTX_set_cert_verify_callback(cc->ctx,verify,&cost);
+    uint64_t client_ns=0,server_ns=0;const unsigned count=2000;
+    for(unsigned k=0;k<count;++k) {
+        Flow client(cc),server(sc);
+        for(unsigned i=0;i<100;++i) {
+            auto start=Clock::now();if(!client.ready())client.handshake();
+            client_ns+=std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now()-start).count();
+            start=Clock::now();if(!server.ready())server.handshake();
+            server_ns+=std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now()-start).count();
+            move(client,server);move(server,client);
+            assert(!client.failed()&&!server.failed());
+            if(client.ready()&&server.ready()&&!client.pending()&&!server.pending())break;
+        }
+        assert(client.ready()&&server.ready()&&!client.resumed()&&!server.resumed());
+    }
+    assert(cost.calls==count);
+    std::cout<<"full_handshakes="<<count<<" client_us="<<client_ns/count/1000.0
+             <<" server_us="<<server_ns/count/1000.0<<" x509_verify_us="<<cost.ns/count/1000.0
+             <<" (X509 subset of client, same validation; native host only)\n";
+}
