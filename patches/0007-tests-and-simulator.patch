@@ -0,0 +1,59 @@
+"""HTTP/2 pressure regression against a dedicated local TRex instance."""
+import argparse
+import json
+import time
+from http2_live import profile
+from trex.astf.api import ASTFClient
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cert', required=True)
+    parser.add_argument('--key', required=True)
+    parser.add_argument('--cps', type=float, default=100)
+    parser.add_argument('--duration', type=float, default=3)
+    parser.add_argument('--timeout', type=float, default=60)
+    parser.add_argument('--allow-errors', action='store_true', help='Collect an overloaded baseline without asserting success')
+    args = parser.parse_args()
+    if min(args.cps, args.duration, args.timeout) <= 0:
+        parser.error('cps, duration and timeout must be positive')
+    client = ASTFClient()
+    client.connect()
+    client.acquire(force=True)
+    try:
+        for version in ('clear', '1.2', '1.3'):
+            traffic = profile(args, 4, 16384, 200, version)
+            for info in (traffic.default_c_glob_info, traffic.default_s_glob_info):
+                info.tcp.rxbufsize = 1048576
+                info.tcp.txbufsize = 1048576
+            client.load_profile(traffic)
+            client.start(mult=args.cps, duration=args.duration)
+            started = time.monotonic()
+            pools = []
+            while client.is_traffic_active():
+                pools.append(client.get_util_stats().get('mbuf_stats', {}))
+                if time.monotonic() - started > args.duration + args.timeout:
+                    raise RuntimeError('HTTP/2 pressure test did not drain within its deadline')
+                time.sleep(.2)
+            stats = client.get_stats(skip_zero=False)['traffic']
+            print(json.dumps(dict(version=version, cps=args.cps, duration=args.duration,
+                                  elapsed=time.monotonic()-started, stats=stats, pools=pools)), flush=True)
+            if not args.allow_errors:
+                c, s = stats['client'], stats['server']
+                assert c['tcps_connattempt'] == c['tcps_connects'] > 0, stats
+                for side in (c, s):
+                    assert side['tcps_closed'] == side['tcps_connects'], stats
+                    assert not side['tcps_tls_errors'] and not side['tcps_http2_errors'], stats
+                    assert not side['tcps_http2_timeouts'], stats
+                    assert side['tcps_http2_responses'] == 10 * c['tcps_connects'], stats
+                assert c['tcps_http2_ttlb_count'] == c['tcps_connects'], stats
+            client.clear_profile()
+            time.sleep(.2)
+    finally:
+        if client.is_traffic_active():
+            client.stop()
+        client.disconnect()
+
+
+if __name__ == '__main__':
+    main()
