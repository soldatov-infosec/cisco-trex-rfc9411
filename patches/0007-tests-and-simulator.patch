+#!/bin/sh
+# Run only inside a dedicated Linux container/network namespace with NET_ADMIN.
+# Requires iproute2, Python client dependencies and a --rfc9411 DPDK binary.
+set -eu
+cd "$(dirname "$0")/../../scripts"
+for iface in trxtls0 trxtls1; do
+    if ip link show "$iface" >/dev/null 2>&1; then
+        echo "Test interface $iface already exists; refusing to replace it" >&2
+        exit 1
+    fi
+done
+logs=${TREX_TLS_LIVE_LOG_DIR:-$(mktemp -d)}
+mkdir -p "$logs"
+logs=$(cd "$logs" && pwd)
+server_pid=
+cleanup() {
+    if [ -n "$server_pid" ]; then
+        kill "$server_pid" 2>/dev/null || true
+        wait "$server_pid" 2>/dev/null || true
+    fi
+    ip link del trxtls0 2>/dev/null || true
+}
+ip link add trxtls0 type veth peer name trxtls1
+trap cleanup EXIT HUP INT TERM
+ip link set trxtls0 address 02:00:00:00:00:01 up
+ip link set trxtls1 address 02:00:00:00:00:02 up
+cat > "$logs/trex.yaml" <<'YAML'
+- version: 2
+  port_limit: 2
+  interfaces: ["trxtls0", "trxtls1"]
+  low_end: true
+  low_end_core: 0
+  limit_memory: 512
+  port_info:
+    - src_mac: '02:00:00:00:00:01'
+      dest_mac: '02:00:00:00:00:02'
+    - src_mac: '02:00:00:00:00:02'
+      dest_mac: '02:00:00:00:00:01'
+YAML
+openssl req -x509 -newkey rsa:2048 -nodes -keyout "$logs/key.pem" -out "$logs/cert.pem" -days 1 -subj /CN=localhost -addext subjectAltName=DNS:localhost >/dev/null 2>&1
+LD_LIBRARY_PATH="so/x86_64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "${TREX_TLS_TEST_BINARY:-./_t-rex-64-debug}" --astf -i --software --tso-disable --no-scapy-server --cfg "$logs/trex.yaml" > "$logs/server.log" 2>&1 &
+server_pid=$!
+export PYTHONPATH="automation/trex_control_plane/interactive${PYTHONPATH:+:$PYTHONPATH}"
+python3 - "$server_pid" <<'PY'
+import os, socket, sys, time
+for _ in range(100):
+    os.kill(int(sys.argv[1]), 0)
+    try:
+        with socket.create_connection(('localhost', 4501), timeout=.2):
+            break
+    except OSError:
+        time.sleep(.2)
+else:
+    raise SystemExit('TRex RPC startup timeout')
+PY
+python3 ../tests/tls/udp_rtt_live.py "$@" > "$logs/client.log" 2>&1 || { cat "$logs/client.log"; exit 1; }
+cat "$logs/client.log"
+echo "Live validation logs: $logs"
diff --git a/tests/tls/rx_timestamp_test.cpp b/tests/tls/rx_timestamp_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/rx_timestamp_test.cpp
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <cassert>
+#include <iostream>
+#include <cstring>
+using namespace astf_tls;
+static void transfer(Flow &a,Flow &b) {
+    const uint8_t *p=nullptr;size_t n=a.peek(&p);
+    if(n)a.consume(b.feed(p,n));
+}
+static void run(const char *cert,const char *key,const char *version) {
+    Config c,s;c.version=s.version=version;c.ca=cert;c.sni="localhost";
+    s.server=true;s.cert=cert;s.key=key;
+    Flow client(std::make_shared<Context>(c)),server(std::make_shared<Context>(s));
+    client.enable_rx_timestamps();
+    char buf[4096];
+    for(unsigned i=0;i<10000;++i) {
+        client.handshake();server.handshake();transfer(client,server);transfer(server,client);
+        if(client.ready()&&server.ready()&&!client.pending()&&!server.pending())break;
+    }
+    assert(client.ready()&&server.ready());
+    // Consume post-handshake tickets before data; they must not shift attribution.
+    while(client.read_can_progress()) {assert(!client.read(buf,sizeof(buf)));if(!client.input_pending())break;}
+    std::string a(100,'a'),b(200,'b');
+    assert(server.write(a.data(),a.size())==a.size());
+    const uint8_t *wire=nullptr;size_t n=server.peek(&wire);assert(n>5);
+    assert(client.feed(wire,1,astf_rx::Stamp(0,0))==1);
+    assert(!client.read(buf,sizeof(buf)));
+    assert(client.feed(wire+1,4,astf_rx::Stamp(200,200))==4);
+    assert(!client.read(buf,sizeof(buf)));
+    // Last bytes arrived before the missing header fragment (reassembly).
+    assert(client.feed(wire+5,n-5,astf_rx::Stamp(100,100))==n-5);server.consume(n);
+    assert(server.write(b.data(),b.size())==b.size());n=server.peek(&wire);
+    assert(client.feed(wire,n,astf_rx::Stamp(300,350))==n);server.consume(n);
+    // Both records are in BIO before SSL_read; partial plaintext reads keep
+    // the first record's stamp, regardless of processing time/read-ahead.
+    size_t received=0;
+    while(received<a.size()) {
+        n=client.read(buf,7);assert(n && received+n<=a.size());
+        for(size_t i=0;i<n;++i)assert(buf[i]=='a');
+        received+=n;
+        auto t=client.plaintext_time();assert(t.first==0 && t.last==200);
+    }
+    n=client.read(buf,sizeof(buf));assert(n==b.size());
+    for(size_t i=0;i<n;++i)assert(buf[i]=='b');
+    auto t=client.plaintext_time();assert(t.first==300 && t.last==350);
+    assert(!client.failed());
+}
+int main(int argc,char **argv) {
+    assert(argc==3);
+    astf_rx::Queue q;astf_rx::Stamp t;
+    q.append(2,{0,0});q.append(3,{10,10});q.append(4,{5,5});
+    assert(q.consume(7,t)&&t.first==0&&t.last==10&&q.size()==2);
+    assert(!q.consume(3,t)&&q.size()==2);
+    assert(q.consume(2,t)&&t.first==5&&t.last==5&&!q.size());
+    astf_rx::Payload p;p.times.emplace_back(5,astf_rx::Stamp(10,10));
+    p.times.emplace_back(7,astf_rx::Stamp(20,20));astf_rx::Payload merged;
+    merged.append_times(p,7);assert(merged.times.size()==1&&merged.times[0].size==5&&merged.times[0].time.first==20);
+    run(argv[1],argv[2],"1.2");run(argv[1],argv[2],"1.3");
+    std::cout<<"RX timestamps: overlap metadata, zero, reordered fragments, TLS records, partial reads PASS\n";
+}
diff --git a/tests/tls/server_sni_test.cpp b/tests/tls/server_sni_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/server_sni_test.cpp
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+using namespace astf_tls;
+static unsigned rejected;
+static void info(const SSL *, int where, int value) {
+    if ((where & SSL_CB_WRITE_ALERT) == SSL_CB_WRITE_ALERT &&
+        value == ((SSL3_AL_FATAL << 8) | SSL_AD_UNRECOGNIZED_NAME)) ++rejected;
+}
+static void transfer(Flow &a, Flow &b) {
+    const uint8_t *p=nullptr;
+    size_t n=std::min<size_t>(a.peek(&p),17);
+    if (n) a.consume(b.feed(p,n));
+}
+static void check(const std::string &dir, const char *cert, const char *name,
+                  const char *version, bool expected, bool verify=false) {
+    Config c,s; c.version=s.version=version; c.sni=name; c.verify=verify;
+    s.server=true; s.cert=dir+"/"+cert+".pem"; s.key=dir+"/key.pem"; c.ca=s.cert;
+    auto cc=std::make_shared<Context>(c), sc=std::make_shared<Context>(s);
+    SSL_CTX_set_info_callback(sc->ctx,info);
+    rejected=0; Flow client(cc),server(sc);
+    bool connected=false;
+    for (unsigned i=0;i<100000;++i) {
+        client.handshake(); transfer(client,server);
+        server.handshake(); transfer(server,client);
+        if (server.failed() || client.failed()) break;
+        if (client.ready() && server.ready() && !client.pending() && !server.pending()) {
+            connected=true; break;
+        }
+    }
+    assert(connected==expected);
+    if (!expected) {
+        // Client verification is disabled: rejection must originate at server.
+        assert(!verify && server.failed() && !server.ready() && rejected==1);
+        assert(server.write("HTTP/1.1 200 OK\r\n\r\n",19)==0);
+    } else {
+        assert(!server.failed() && !client.failed() && rejected==0);
+        const std::string body="HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok";
+        assert(server.write(body.data(),body.size())==body.size());
+        std::string got;
+        for(unsigned i=0;i<10000 && got.size()<body.size();++i) {
+            transfer(server,client); char buf[100]; size_t n=client.read(buf,sizeof(buf));
+            got.append(buf,n); assert(!client.failed());
+        }
+        assert(got==body);
+    }
+    std::cout << version << " " << cert << " SNI=" << (name[0]?name:"<absent>")
+              << " " << (expected?"accepted":"server rejected") << " PASS\n";
+}
+int main(int argc,char **argv) {
+    assert(argc==2); std::string dir=argv[1];
+    for (auto version:{"1.2","1.3"}) {
+        check(dir,"san","localhost",version,true,true);
+        check(dir,"san","LOCALHOST",version,true);
+        check(dir,"san","alias.example.test",version,true);
+        check(dir,"san","wrong.example.test",version,false);
+        check(dir,"san","cn-only.example.test",version,false); // SAN overrides CN.
+        check(dir,"san","",version,true); // Optional SNI, not optional check.
+        check(dir,"wildcard","www.example.test",version,true);
+        check(dir,"wildcard","example.test",version,false);
+        check(dir,"wildcard","a.b.example.test",version,false);
+        check(dir,"partial","www.example.test",version,false);
+        check(dir,"cn","legacy.example.test",version,true);
+        check(dir,"cn","other.example.test",version,false);
+    }
+}
diff --git a/tests/tls/tcp_fuzzer.h b/tests/tls/tcp_fuzzer.h
new file mode 100644
--- /dev/null
+++ b/tests/tls/tcp_fuzzer.h
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Included by the simulator gtest translation unit, after TlsWireFault.
+// All mutations enter real TCP input/reassembly before the TLS/ASTF adapter.
+class TlsPacketMutation : public CTxRxCallback {
+public:
+    CClientServerTcp &sim;
+    const uint8_t *data;
+    size_t size, offset = 1;
+    explicit TlsPacketMutation(CClientServerTcp &s, const uint8_t *d, size_t n) : sim(s),data(d),size(n) {}
+    int on_rx(int, rte_mbuf_t *) override { return 0; }
+    int on_tx(int dir, rte_mbuf_t *m) override {
+        if (offset+2 >= size || offset >= 97 || m->next || m->pkt_len != m->data_len) return 0;
+        if ((data[0]&8) && (!sim.m_c_ctx.get_tcpstat()->m_sts.tcps_tls_handshakes ||
+                          !sim.m_s_ctx.get_tcpstat()->m_sts.tcps_tls_handshakes)) return 0;
+        auto bytes=rte_pktmbuf_mtod(m,uint8_t *);
+        auto ip=reinterpret_cast<IPHeader *>(bytes+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(bytes+14+ip->getHeaderLength());
+        unsigned header=14+ip->getHeaderLength()+tcp->getHeaderLength();
+        if (header >= m->data_len) return 0;
+        unsigned len=m->data_len-header;
+        unsigned action=data[offset++], pos=data[offset++], value=data[offset++];
+        double when=sim.m_sim.get_time()+0.001+double(value)/10000.0;
+        auto deliver=[&](rte_mbuf_t *p) { sim.m_sim.add_event(new CTcpSimEventRx(&sim,p,dir^1,when)); };
+        switch (action%8) {
+        case 0: break;
+        case 1: deliver(TlsWireFault::copy(m)); break;
+        case 2:
+            if (len>1) {
+                unsigned cut=1+pos%(len-1);
+                auto head=TlsWireFault::copy(m);
+                TlsWireFault::slice(head,0,cut);
+                TlsWireFault::slice(m,cut,len-cut);
+                deliver(head); // Tail arrives first, exercising reassembly.
+            }
+            break;
+        case 3: bytes[header+pos%len]^=uint8_t(value|1); break;
+        case 4: TlsWireFault::slice(m,0,pos%len); tcp->setFinFlag(true); break;
+        case 5: TlsWireFault::slice(m,0,0); tcp->setResetFlag(true); break;
+        case 6: {
+            auto reopen=TlsWireFault::copy(m);
+            tcp->setWindowSize(0);
+            deliver(reopen);
+            break;
+        }
+        case 7: tcp->setSeqNumber(tcp->getSeqNumber()+int(pos)-128); break;
+        }
+        TlsWireFault::checksum(m);
+        return 0;
+    }
+};
+static int tls_tcp_fuzz_input(const uint8_t *data, size_t size) {
+    if (!size) return 0;
+    CClientServerTcp sim;
+    sim.Create("generated","tls_packet_fuzz");
+    sim.m_mss=(data[0]&16)?512:128;
+    sim.m_check_counters=false;
+    if (data[0]&4) sim.m_c_ctx.tcp_iss=0xfffffff0;
+    TlsPacketMutation mutation(sim,data,size);
+    sim.m_callbacks.push_back(&mutation);
+    sim.m_sim.add_event(new CTcpSimEventStop(5.0));
+    sim.simple_tls((data[0]&1)?"1.3":"1.2",(data[0]&2)?65536:128,512);
+    for (auto ctx : {&sim.m_c_ctx,&sim.m_s_ctx}) {
+        const auto &stats=ctx->get_tcpstat()->m_sts;
+        // One connection: failures are terminal and cannot re-enter handshake.
+        assert(stats.tcps_tls_handshakes<=1 && stats.tcps_tls_errors<=1);
+        assert(stats.tcps_tls_rcvbyte<=65536);
+    }
+    sim.close_file();
+    sim.Delete();
+    return 0;
+}
+#ifdef TREX_TLS_FUZZ
+extern "C" int LLVMFuzzerRunDriver(int *, char ***, int (*)(const uint8_t *, size_t));
+TEST_F(gt_tcp, native_tls_guided_fuzz) {
+    const char *runs=getenv("TREX_TLS_FUZZ_RUNS");
+    const char *corpus=getenv("TREX_TLS_FUZZ_CORPUS");
+    std::vector<std::string> args={"tls_tcp_fuzzer",std::string("-runs=")+(runs?runs:"1000"),
+        "-max_len=100","-timeout=10","-rss_limit_mb=3072","-seed=12345"};
+    if (corpus) args.push_back(corpus);
+    std::vector<char *> argv;
+    for (auto &arg:args) argv.push_back(&arg[0]);
+    int argc=argv.size(); char **ptr=argv.data();
+    ASSERT_EQ(0,LLVMFuzzerRunDriver(&argc,&ptr,tls_tcp_fuzz_input));
+}
+#else
+TEST_F(gt_tcp, native_tls_packet_mutations) {
+    for (unsigned mode=0;mode<32;++mode) {
+        uint8_t input[100]; input[0]=mode;
+        for (unsigned i=1;i<sizeof(input);++i) input[i]=uint8_t(mode*37+i*13);
+        tls_tcp_fuzz_input(input,sizeof(input));
+    }
+}
+#endif
