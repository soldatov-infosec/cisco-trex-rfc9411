+++ b/tests/tls/udp_rtt_live.py
@@ -0,0 +1,84 @@
+"""Run only against a dedicated two-port ASTF loopback test server."""
+import argparse
+import time
+import uuid
+from trex.astf.api import *
+
+def make_profile(mode):
+    c=ASTFProgram(stream=False);s=ASTFProgram(stream=False)
+    ip=ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset='1.0.0.0'),
+        dist_client=ASTFIPGenDist(ip_range=['16.0.0.1','16.0.0.20'],distribution='seq'),
+        dist_server=ASTFIPGenDist(ip_range=['48.0.0.1','48.0.0.20'],distribution='seq'))
+    if mode in ('success','delay'):
+        c.set_var('n',3);c.set_label('again')
+        c.udp_request(b'x'*18,timeout_ms=500)
+        c.jmp_nz('n','again')
+        s.set_var('n',3);s.set_label('again');s.recv_msg(1,clear=True)
+        if mode=='delay': s.delay(10000)
+        s.send_msg(b'y'*18);s.jmp_nz('n','again')
+    elif mode=='legacy':
+        c.send_msg(b'x'*18);c.recv_msg(1);s.recv_msg(1);s.send_msg(b'y'*18)
+    else:
+        # Above the default 1-second keepalive: measured timeout must win.
+        timeout=1500 if mode=='timeout' else (20 if mode=='late' else 60000)
+        c.udp_request(b'x'*18,timeout_ms=timeout)
+        s.recv_msg(1)
+        s.delay(50000 if mode=='late' else 3000000)
+        s.send_msg(b'y'*18)
+    t=ASTFTemplate(client_template=ASTFTCPClientTemplate(program=c,ip_gen=ip,port=5353,cps=3),
+        server_template=ASTFTCPServerTemplate(program=s,assoc=ASTFAssociationRule(port=5353)),tg_name='udp_rtt')
+    return ASTFProfile(default_ip_gen=ip,templates=t)
+
+def main():
+    parser=argparse.ArgumentParser();parser.add_argument('--ipv6',action='store_true');args=parser.parse_args()
+    client=ASTFClient();client.connect();client.acquire(force=True)
+    pid='rtt_'+uuid.uuid4().hex[:10]
+    try:
+        for mode in ('success','delay','legacy','timeout','late','abort'):
+            client.load_profile(make_profile(mode),pid_input=pid)
+            client.start(mult=1,duration=1 if mode!='abort' else 30,ipv6=args.ipv6,pid_input=pid)
+            if mode=='abort':
+                deadline=time.monotonic()+10
+                while True:
+                    x=client.get_stats(skip_zero=False,pid_input=pid)['traffic']['client']
+                    if x['udps_rtt_started']: break
+                    assert time.monotonic()<deadline,'no active UDP request'
+                    time.sleep(.05)
+                client.stop(pid_input=pid)
+            else:
+                client.wait_on_traffic(timeout=20)
+            stats=client.get_stats(skip_zero=False,pid_input=pid)['traffic']
+            tg=client.get_traffic_tg_stats('udp_rtt',skip_zero=False,pid_input=pid)['udp_rtt']
+            c=stats['client'];s=stats['server'];count=c['udps_rtt_count']
+            assert c['m_active_flows']==0,c
+            assert c['udps_rtt_started']==count+c['udps_rtt_timeouts']+c['udps_rtt_aborted'],c
+            assert sum(c['udps_rtt_bucket_'+str(i)] for i in range(32))==count,c
+            for k,v in c.items():
+                if k.startswith(('udps_rtt_','udps_rtt_')): assert tg['client'][k]==v,(k,tg['client'][k],v)
+            assert not s['udps_rtt_started'] and not s['udps_rtt_count'],s
+            for side in (c,s):
+                for key in ('tcps_ttfb_count','tcps_ttlb_count','tcps_http_req_ttfb_count','tcps_http_req_ttlb_count'):
+                    assert side[key]==0,(key,side[key])
+            if mode in ('success','delay'):
+                assert count==3*c['udps_connects'] and count>0,c
+                assert c['udps_rtt_timeouts']==c['udps_rtt_aborted']==0,c
+                assert c['udps_sndbyte']==18*count and s['udps_sndbyte']==18*count,stats
+                assert c['udps_rtt_min_ms']<=c['udps_rtt_avg_ms']<=c['udps_rtt_max_ms'],c
+                assert c['udps_rtt_p50_ms']<=c['udps_rtt_p95_ms']<=c['udps_rtt_p99_ms']<=c['udps_rtt_max_ms'],c
+                if mode=='delay': assert c['udps_rtt_min_ms']>=9,c
+            elif mode=='legacy': assert not count and not c['udps_rtt_started'],c
+            elif mode=='abort': assert c['udps_rtt_aborted']>0 and not count and not c['udps_rtt_timeouts'],c
+            else: assert c['udps_rtt_timeouts']>0 and not count and not c['udps_rtt_aborted'],c
+            print(mode,{k:v for k,v in c.items() if k.startswith(('udps_rtt_','udps_rtt_')) and '_bucket_' not in k},flush=True)
+            client.clear_stats(pid_input=pid)
+            cleared=client.get_stats(skip_zero=False,pid_input=pid)['traffic']['client']
+            # Latency aggregates use the same absolute lifetime semantics as HTTP.
+            assert cleared['udps_rtt_count']==count,cleared
+            client.clear_profile(block=False,pid_input=pid)
+            time.sleep(.2)
+        print('PASS UDP RTT: IPv'+('6' if args.ipv6 else '4'),flush=True)
+    finally:
+        if pid in client.get_profiles():
+            client.stop(pid_input=pid);client.clear_profile(block=False,pid_input=pid)
+        client.disconnect()
+if __name__=='__main__': main()
