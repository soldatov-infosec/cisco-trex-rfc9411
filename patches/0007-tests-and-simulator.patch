+            // A one-step pump sends smaller complete records with BIO=128;
+            // allow the resulting timer continuations to finish the bulk send.
+            sim.m_sim.add_event(new CTcpSimEventStop(
+                scenario == CClientServerTcp::TLS_WORK_BUDGET ? 300.0 : 120.0));
+            sim.simple_tls(version,128,512,scenario);
