--- /dev/null
+++ b/tests/tls/run_handshake_cost.py
@@ -0,0 +1,184 @@
+#!/usr/bin/env python3
+"""Text-only TLS benchmark. Run after stopping TRex; never stops it itself."""
+import argparse
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import random
+import re
+import shlex
+import statistics
+import subprocess
+import tempfile
+import zipfile
+
+
+def capture_defaults(path):
+    path = Path(path)
+    if path.is_dir():
+        def read(name):
+            return (path/name).read_text()
+    else:
+        with zipfile.ZipFile(path) as z:
+            names = [n for n in z.namelist() if n.endswith('/metadata.json')]
+            if len(names) != 1:
+                raise ValueError('capture must contain one metadata.json')
+            prefix = names[0][:-len('metadata.json')]
+            # Only needed text, no extraction and no execution of archived profile.py.
+            data = {name: z.read(prefix+name).decode() for name in ('metadata.json', 'server/samples.jsonl', 'server/maps.txt')}
+        read = data.__getitem__
+    metadata = json.loads(read('metadata.json'))
+    baseline = json.loads(read('server/samples.jsonl').splitlines()[0])
+    cpus = []
+    for thread in baseline['threads'].values():
+        if not thread['comm'].strip().startswith('Trex DP core '):
+            continue
+        match = re.search(r'^Cpus_allowed_list:\s*(\d+)\s*$', thread['status'], re.M)
+        if not match:
+            raise ValueError('DP thread is not pinned to exactly one CPU')
+        cpus.append(int(match[1]))
+    if not cpus or len(set(cpus)) != len(cpus):
+        raise ValueError('invalid captured DP affinity')
+    tunables = metadata.get('tunables', [])
+    defaults = dict(cert='/tmp/trex-cert.pem', key='/tmp/trex-key.pem', ca='/tmp/trex-cert.pem', hostname='localhost', version='1.3')
+    if Path(metadata['profile']).name != 'tcp_https_16KB.py':
+        raise ValueError('automatic defaults only support tcp_https_16KB.py; use explicit arguments without --capture')
+    for flag, field in (('--cert','cert'),('--key','key'),('--ca','ca'),('--sni','hostname'),('--tls_version','version')):
+        for i, item in enumerate(tunables):
+            if item == flag:
+                defaults[field] = tunables[i+1]
+            elif item.startswith(flag+'='):
+                defaults[field] = item.split('=',1)[1]
+    maps=read('server/maps.txt')
+    try: maps=json.loads(maps)
+    except ValueError: pass
+    defaults['captured_libraries']=sorted(set(re.findall(r'/[^\s"]*/lib(?:ssl|crypto)\.so[^\s"]*',maps))) if isinstance(maps,str) else []
+    return sorted(cpus), defaults
+
+
+def ensure_idle():
+    for proc in Path('/proc').glob('[0-9]*'):
+        try:
+            name = Path(os.readlink(proc/'exe')).name
+        except (OSError, PermissionError):
+            continue
+        if re.fullmatch(r'_?t-rex-64(?:-debug)?(?:-o)?', name):
+            raise RuntimeError('Stop TRex before benchmark: its poll-mode threads would distort measurements')
+
+
+def main():
+    p = argparse.ArgumentParser(__doc__)
+    p.add_argument('--capture', help='Existing text capture directory or ZIP; infer DP CPUs and profile options')
+    p.add_argument('--cpus', help='Explicit comma-separated CPU IDs; required on Linux without capture')
+    p.add_argument('--threads', help='Defaults to 1, min(15,N), N on captured/selected CPUs')
+    p.add_argument('--seconds', type=float, default=3)
+    p.add_argument('--repeats', type=int, default=3)
+    for field in ('cert','key','ca','hostname','version'):
+        p.add_argument('--'+field)
+    p.add_argument('--output', required=True, help='New output directory and adjacent ZIP')
+    a = p.parse_args()
+    cpus, defaults = capture_defaults(a.capture) if a.capture else ([], dict(hostname='localhost',version='1.3'))
+    for field in ('cert','key','ca','hostname','version'):
+        if getattr(a,field) is None:
+            setattr(a,field,defaults.get(field))
+    if not all((a.cert,a.key,a.ca)) or a.version not in ('1.2','1.3'):
+        p.error('provide cert/key/ca and version 1.2 or 1.3')
+    if a.cpus:
+        cpus = list(map(int,a.cpus.split(',')))
+    if platform.system()=='Linux' and not cpus:
+        p.error('provide --capture or --cpus for pinned workers')
+    if cpus and (min(cpus)<0 or len(set(cpus))!=len(cpus)):
+        p.error('CPU IDs must be distinct nonnegative integers')
+    if cpus and hasattr(os,'sched_getaffinity') and not set(cpus)<=os.sched_getaffinity(0):
+        p.error('requested CPUs are outside this process allowed affinity')
+    threads = list(map(int,a.threads.split(','))) if a.threads else sorted(set((1,min(15,len(cpus) or 1),len(cpus) or 1)))
+    if not threads or min(threads)<1 or max(threads)>min(256,len(cpus) or 1):
+        p.error('threads exceed available selected CPUs')
+    if not math.isfinite(a.seconds) or not 0<a.seconds<=60 or not 1<=a.repeats<=10:
+        p.error('seconds must be finite in (0,60], repeats in [1,10]')
+    for field in ('cert','key','ca'):
+        if not Path(getattr(a,field)).is_file():
+            p.error('--'+field+' file does not exist')
+    ensure_idle()
+    root=Path(__file__).resolve().parents[2]
+    out=Path(a.output).resolve();archive=out.with_suffix(out.suffix+'.zip')
+    if out.exists() or archive.exists():
+        p.error('output or ZIP exists')
+    out.mkdir(parents=True)
+    meta=dict(args=vars(a),cpus=cpus,threads=threads,runs=[],status='running',
+              openssl_environment={k:os.environ.get(k) for k in ('OPENSSL_CONF','OPENSSL_MODULES','OPENSSL_ENGINES')},
+              semantics='full handshake, verification enabled, no resumption; AWS-LC only',
+              sources={f:hashlib.sha256((root/f).read_bytes()).hexdigest() for f in
+                       ('src/44bsd/tls/astf_tls.cpp','src/astf/astf_cost_metrics.h','tests/tls/handshake_bench.cpp')},
+              certificate_sha256=hashlib.sha256(Path(a.cert).read_bytes()).hexdigest(),
+              captured_libraries=defaults.get('captured_libraries',[]))
+    def save():
+        (out/'results.json').write_text(json.dumps(meta,indent=2)+'\n')
+    env=dict(os.environ,TREX_ASTF_COST_SHIFT='8')
+    if cpus:env['TREX_TLS_BENCH_CPUS']=','.join(map(str,cpus))
+    try:
