@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Test TLS allocation against TRex's built DPDK, without NICs or hugepages.
+Run after building a TLS DPDK target. Requires compile_commands.json.
+"""
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+commands = json.loads((root / 'linux_dpdk/build_dpdk/compile_commands.json').read_text())
+entry = next(e for e in commands if e['file'].endswith('/44bsd/tcp_dpdk.cpp'))
+debug_build = '-D_DEBUG' in shlex.split(entry['command'])
+cwd = Path(entry['directory'])
+args = shlex.split(entry['command'])
+flags = [a for a in args[1:] if a != '-c' and a != entry['file'] and not a.startswith('-o')]
+# Link only core DPDK components and the ring mempool driver; no NIC driver.
+parts = ('/lib/eal/', '/lib/mempool/', '/lib/ring/', '/lib/mbuf/',
+         '/lib/kvargs/', '/lib/log/', '/lib/telemetry/', '/drivers/mempool/ring/')
+objects = []
+for e in commands:
+    if '/src/dpdk/' in e['file'] and any(p in e['file'] for p in parts):
+        cmd = shlex.split(e['command'])
+        # Match the selected target; mixing debug/release DPDK objects would
+        # introduce duplicate symbols. Explicit check() works with NDEBUG too.
+        if ('-DNDEBUG' in cmd) == debug_build:
+            continue
+        output = next((a[2:] for a in cmd if a.startswith('-o') and len(a) > 2), None)
+        if output is None:
+            output = cmd[cmd.index('-o') + 1]
+        obj = Path(e['directory']) / output
+        if obj not in objects:
+            objects.append(obj)
+if not objects or not all(o.exists() for o in objects):
+    raise SystemExit('Build the selected DPDK target first')
+with tempfile.TemporaryDirectory(prefix='trex-tls-mbuf-') as tmp:
+    binary = str(Path(tmp) / 'test')
+    subprocess.run([args[0]] + flags + [str(root / 'tests/tls/mbuf_pool_test.cpp')] +
+                   list(map(str, objects)) + ['-pthread', '-ldl', '-lm', '-lrt', '-o', binary],
+                   cwd=cwd, check=True)
+    cpu = min(os.sched_getaffinity(0))
+    subprocess.run([binary, '-l', str(cpu), '--no-huge', '--no-pci', '--legacy-mem',
+                    '--file-prefix=trex-tls-mbuf-' + str(os.getpid()),
+                    '--iova-mode=va', '-m', '64'], check=True)
diff --git a/tests/tls/run_optimization_bench.py b/tests/tls/run_optimization_bench.py
new file mode 100644
--- /dev/null
+++ b/tests/tls/run_optimization_bench.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Compare full TLS, handshake and lifecycle cost locally, without a NIC or perf."""
+import argparse
+import json
+import os
+from pathlib import Path
+import shlex
+import statistics
+import subprocess
+import tempfile
+
+p = argparse.ArgumentParser(description=__doc__)
+p.add_argument('--baseline', type=Path, required=True, help='Source tree before v3')
+p.add_argument('--output', type=Path, required=True)
+p.add_argument('--seconds', type=float, default=2)
+p.add_argument('--repeats', type=int, default=5)
+a = p.parse_args()
+if not 0 < a.seconds <= 60 or not 1 <= a.repeats <= 100:
+    p.error('seconds must be in (0,60], repeats in [1,100]')
+current = Path(__file__).resolve().parents[2]
+rows, allocation_results, commands = [], {}, []
+with tempfile.TemporaryDirectory(prefix='trex-v3-bench-') as temporary:
+    tmp = Path(temporary)
+    openssl = os.environ.get('OPENSSL', 'openssl')
+    subprocess.run([openssl, 'req', '-x509', '-newkey', 'rsa:2048', '-nodes',
+                    '-keyout', str(tmp/'key.pem'), '-out', str(tmp/'cert.pem'),
+                    '-days', '1', '-subj', '/CN=localhost', '-addext',
+                    'subjectAltName=DNS:localhost'], check=True, capture_output=True)
+    for variant, source in [('baseline', a.baseline.resolve()), ('v3', current)]:
+        for kind in ('datapath', 'allocation'):
+            executable = tmp / (variant+'-'+kind)
+            cmd = shlex.split(os.environ.get('CXX', 'c++')) + [
+                '-O2', '-std=c++11', '-DTREX_TLS', '-pthread', '-I'+str(source/'src')]
+            cmd += shlex.split(os.environ.get('CXXFLAGS', ''))
+            cmd += [str(current/f'tests/tls/tls_{kind}_bench.cpp'),
+                    str(source/'src/44bsd/tls/astf_tls.cpp')]
+            cmd += shlex.split(os.environ.get('LDFLAGS', ''))
+            cmd += ['-lssl', '-lcrypto', '-o', str(executable)]
+            subprocess.run(cmd, check=True); commands.append(cmd)
+            if kind == 'allocation':
+                allocation_results[variant] = json.loads(subprocess.check_output([str(executable)]))
+    for mode in ('lifecycle', 'handshake', 'full'):
+        for version in ('1.2', '1.3'):
+            for repeat in range(a.repeats):
+                order = ('baseline', 'v3') if repeat % 2 == 0 else ('v3', 'baseline')
+                for variant in order:
+                    cmd = [str(tmp/(variant+'-datapath')), mode, version, str(a.seconds),
+                           str(tmp/'cert.pem'), str(tmp/'key.pem'), str(tmp/'cert.pem')]
+                    row = json.loads(subprocess.check_output(cmd))
+                    row.update(variant=variant, version=version, repeat=repeat)
+                    rows.append(row)
+    summary = []
+    for mode in ('lifecycle', 'handshake', 'full'):
+        for version in ('1.2', '1.3'):
+            medians = {v: statistics.median(r['ops_per_second'] for r in rows
+                       if r['mode'] == mode and r['version'] == version and r['variant'] == v)
+                       for v in ('baseline', 'v3')}
+            summary.append(dict(mode=mode, version=version, medians=medians,
+                                change_percent=100*(medians['v3']/medians['baseline']-1)))
+    result = dict(rows=rows, summary=summary, allocations=allocation_results,
+                  build_commands=commands, note='Memory BIO microbenchmark; not NIC throughput')
+    a.output.parent.mkdir(parents=True, exist_ok=True)
+    a.output.write_text(json.dumps(result, indent=2)+'\n')
+    print(json.dumps(summary, indent=2))
