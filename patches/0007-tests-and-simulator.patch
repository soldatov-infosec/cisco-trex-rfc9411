+#!/bin/sh
+# SPDX-License-Identifier: Apache-2.0
+# Installs only below the supplied prefix. No package-manager or system edits.
+set -eu
+if [ "$#" -ne 2 ]; then echo "usage: $0 SOURCE_DIR INSTALL_PREFIX" >&2; exit 2; fi
+src=$(cd "$1" && pwd)
+case "$2" in /*) prefix=$2;; *) echo 'Use an absolute installation prefix' >&2; exit 2;; esac
+# Use the release's pregenerated sources; Go is not needed for this build.
+cmake -S "$src" -B "$src/trex-build" -DCMAKE_BUILD_TYPE=Release \
+    -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF -DDISABLE_GO=ON \
+    -DCMAKE_INSTALL_PREFIX="$prefix"
+cmake --build "$src/trex-build" --parallel "${JOBS:-8}"
+cmake --install "$src/trex-build"
