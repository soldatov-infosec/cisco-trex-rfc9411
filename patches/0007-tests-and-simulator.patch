+            group=client.get_traffic_tg_stats('http2',skip_zero=False,pid_input=pid)['http2']
+            for side in ('client','server'):
+                for key,value in stats[side].items():
+                    if key.startswith(('tcps_http2_ttfb_','tcps_http2_ttlb_','tcps_ttfb_','tcps_ttlb_')):
+                        assert group[side][key]==value,(key,group[side][key],value)
+            print(concurrency,size,status,version,{k:v for k,v in c.items() if k.startswith(('tcps_http2_','tcps_tls_err')) and '_bucket_' not in k},flush=True)
+            if version=='clear':
+                for side in (c,s):
+                    assert side['tcps_tls_attempts']==side['tcps_tls_handshakes']==side['tcps_tls_sndbyte']==side['tcps_tls_rcvbyte']==0,side
+            if status==200:
+                assert c['tcps_http2_responses']==(1 if size==0 else 10)*c['tcps_connects']>0,stats
+                assert s['tcps_http2_responses']==c['tcps_http2_responses'],stats
+                assert not c['tcps_http2_errors'] and not c['tcps_tls_errors'],stats
+                assert not s['tcps_http2_errors'] and not s['tcps_tls_errors'],stats
+                for kind in ('ttfb','ttlb'):
+                    prefix='tcps_http2_'+kind
+                    assert c[prefix+'_count']==c['tcps_connects'],c
+                    assert c[prefix+'_min_ms']==c['tcps_'+kind+'_min_ms'],c
+                    assert c[prefix+'_max_ms']==c['tcps_'+kind+'_max_ms'],c
+                    assert c['tcps_'+kind+'_count']==c['tcps_connects'],c
