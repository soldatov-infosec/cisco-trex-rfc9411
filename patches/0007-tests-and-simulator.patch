+/* SPDX-License-Identifier: Apache-2.0 */
+// Compile unchanged against either engine. Count allocations, not elapsed time.
+#include "44bsd/tls/astf_tls.h"
+#include <atomic>
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+static std::atomic<unsigned long long> allocations{0}, bytes{0};
+static void *allocate(size_t n,const char *,int) { ++allocations;bytes+=n;return std::malloc(n); }
+static void *resize(void *p,size_t n,const char *,int) { ++allocations;bytes+=n;return std::realloc(p,n); }
+static void release(void *p,const char *,int) { std::free(p); }
+int main() {
+    if(!CRYPTO_set_mem_functions(allocate,resize,release)) return 1;
+    astf_tls::Config cfg;cfg.sni="localhost";cfg.verify=false;
+    auto library=astf_tls::Library::local();
+    auto ctx=std::make_shared<astf_tls::Context>(cfg)->clone_for_worker(library);
+    for(int i=0;i<100;++i) { astf_tls::Flow flow(ctx); }
+    allocations=0;bytes=0;
+    for(int i=0;i<10000;++i) { astf_tls::Flow flow(ctx); }
+    std::cout<<"{\"flows\":10000,\"allocation_calls\":"<<allocations.load()
+             <<",\"requested_bytes\":"<<bytes.load()<<"}\n";
+}
diff --git a/tests/tls/tls_datapath_bench.cpp b/tests/tls/tls_datapath_bench.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/tls_datapath_bench.cpp
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Same source is compiled against baseline and optimized engines. No NIC.
+#include "44bsd/tls/astf_tls.h"
+#include <chrono>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+using namespace astf_tls;
+using Clock=std::chrono::steady_clock;
+static void check(bool ok) { if(!ok) throw std::runtime_error("TLS benchmark invariant failed"); }
+static void move(Flow &a,Flow &b) {
+    const uint8_t *p=nullptr;size_t n=std::min<size_t>(a.peek(&p),1448);
+    if(n) a.consume(b.feed(p,n));
+}
+static void connect(Flow &c,Flow &s) {
+    for(unsigned i=0;i<100000;++i) {
+        if(!c.ready()) c.handshake();
+        if(!s.ready()) s.handshake();
+        move(c,s);move(s,c);check(!c.failed()&&!s.failed());
+        if(c.ready()&&s.ready()&&!c.pending()&&!s.pending()) return;
+    }
+    check(false);
+}
+static void send(Flow &a,Flow &b,const std::string &data) {
+    size_t written=0,read=0;
+    for(unsigned i=0;i<100000;++i) {
+        if(written<data.size()) written+=a.write(data.data()+written,std::min<size_t>(16384,data.size()-written));
+        move(a,b);
+        // Model repeated pump reads on output/ACK progress. Successful extra
+        // reads must still be consumed: SSL can retain plaintext internally.
+        for(int poll=0;poll<3;++poll) {
+            char buf[16384];size_t n=b.read(buf,sizeof(buf));
+            check(read+n<=data.size() && !std::memcmp(data.data()+read,buf,n));read+=n;
+        }
+        move(b,a);char scratch;check(a.read(&scratch,1)==0);
+        check(!a.failed()&&!b.failed());
+        if(written==data.size()&&read==data.size()) return;
+    }
+    check(false);
+}
+static void close(Flow &c,Flow &s) {
+    for(unsigned i=0;i<10000;++i) {
+        c.shutdown();s.shutdown();move(c,s);move(s,c);
+        char out;check(c.read(&out,1)==0 && s.read(&out,1)==0);
+        check(!c.failed()&&!s.failed());
+        if(c.sent_close()&&s.sent_close()&&c.peer_closed()&&s.peer_closed()&&!c.pending()&&!s.pending()) return;
+    }
+    check(false);
+}
+int main(int argc,char **argv) {
+    try {
+        check(argc==7);std::string mode=argv[1];check(mode=="full"||mode=="empty"||mode=="handshake"||mode=="lifecycle");
+        double seconds=std::stod(argv[3]);check(seconds>0 && seconds<=60);
+        Config c,s;c.version=s.version=argv[2];c.sni="localhost";c.ca=argv[6];s.server=true;s.cert=argv[4];s.key=argv[5];
+        auto library=Library::local();
+        auto cc=std::make_shared<Context>(c)->clone_for_worker(library);
+        auto sc=std::make_shared<Context>(s)->clone_for_worker(library);
+        std::string request(255,'q'),response(16478,'r');
+        auto transaction=[&] {
+            Flow client(cc),server(sc);connect(client,server);check(!client.resumed()&&!server.resumed());
+            if(mode=="full") for(int i=0;i<10;++i) { send(client,server,request);send(server,client,response); }
+            close(client,server);
+        };
+        uint64_t count=0;double elapsed=0;
+        if(mode=="lifecycle") {
+            { Flow client(cc),server(sc); }
+            auto start=Clock::now();
+            do {
+                for(int i=0;i<128;++i) { Flow client(cc),server(sc); }
+                count+=128;elapsed=std::chrono::duration<double>(Clock::now()-start).count();
+            } while(elapsed<seconds);
+        } else if(mode=="full" || mode=="handshake") {
+            for(int i=0;i<10;++i) transaction();
+            auto start=Clock::now();
+            do { transaction();++count;elapsed=std::chrono::duration<double>(Clock::now()-start).count(); } while(elapsed<seconds);
+        } else {
+            Flow client(cc),server(sc);connect(client,server);char out;check(client.read(&out,1)==0);
+            auto start=Clock::now();
+            do {
+                for(unsigned i=0;i<1024;++i) check(client.read(&out,1)==0);
+                count+=1024;elapsed=std::chrono::duration<double>(Clock::now()-start).count();
+            } while(elapsed<seconds);
+            close(client,server);
+        }
+        std::cout<<"{\"mode\":\""<<mode<<"\",\"completed\":"<<count<<",\"seconds\":"<<elapsed<<",\"ops_per_second\":"<<count/elapsed<<"}\n";
+    } catch(const std::exception &e) { std::cerr<<e.what()<<'\n';return 1; }
+}
