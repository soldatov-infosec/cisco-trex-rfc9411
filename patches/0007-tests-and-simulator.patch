new file mode 100644
--- /dev/null
+++ b/tests/tls/bio_ring_test.cpp
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include "44bsd/tls/astf_tls_bio.h"
+#include <cassert>
+#include <deque>
+#include <iostream>
+#include <vector>
+using namespace astf_tls;
+int main() {
+    // Compare the transport against independent byte queues over many wraps.
+    for (size_t capacity : {1u, 127u, 128u, 129u, 257u, 65535u, 65536u}) {
+        BIO *ends[2]; assert(transport::create(&ends[0],capacity,&ends[1],capacity));
+        std::deque<uint8_t> expected[2];
+        std::vector<uint8_t> data(capacity + 17), out(capacity + 17);
+        uint32_t state=12345;
+        auto random=[&]() { state=state*1664525u+1013904223u; return state; };
+        for (unsigned step=0; step<2000; ++step) {
+            unsigned side=random()%2;
+            size_t want=1+random()%data.size();
+            unsigned operation=(random()>>8)%3;
+            if (!operation) {
+                for (size_t i=0;i<want;++i) data[i]=uint8_t(random()>>24);
+                size_t n=std::min(want,capacity-expected[1-side].size());
+                int result=BIO_write(ends[side],data.data(),int(want));
+                assert(n ? result==int(n) : result==-1 && BIO_should_retry(ends[side]));
+                for (size_t i=0;i<n;++i) expected[1-side].push_back(data[i]);
+            } else {
+                size_t n;
+                if (operation==1) {
+                    n=std::min(want,expected[side].size());
+                    int result=BIO_read(ends[side],out.data(),int(want));
+                    assert(n ? result==int(n) : result==-1 && BIO_should_retry(ends[side]));
+                } else {
+                    const uint8_t *bytes;
+                    n=std::min(want,transport::peek(ends[side],&bytes));
+                    std::copy(bytes,bytes+n,out.begin());
+                    assert(transport::consume(ends[side],n)==n);
+                }
+                for (size_t i=0;i<n;++i) {
+                    assert(out[i]==expected[side].front()); expected[side].pop_front();
+                }
+            }
+            for (unsigned i=0;i<2;++i) assert(BIO_ctrl_pending(ends[i])==expected[i].size());
+            if (step%97==0) {
+                BIO_shutdown_wr(ends[side]);
+                transport::reset(ends[0],ends[1]);
+                expected[0].clear(); expected[1].clear();
+                assert(!BIO_eof(ends[0]) && !BIO_eof(ends[1]));
+            }
+        }
+        BIO_free(ends[0]); BIO_free(ends[1]);
+    }
+    std::cout<<"BIO ring wrap, bidirectional byte order, backpressure and reset: PASS\n";
+}
