@@ -0,0 +1,36 @@
+"""Ensure periodic diagnostics never walk dataplane page tables."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+source=Path(__file__).resolve().parents[2]/"scripts/astf/nic_validation/server_capture.py"
+spec=importlib.util.spec_from_file_location("server_capture",source)
+module=importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+class MemoryCaptureTest(unittest.TestCase):
+    def test_memory_walks_only_outside_traffic(self):
+        with tempfile.TemporaryDirectory() as directory:
+            capture=object.__new__(module.Capture)
+            capture.proc=Path('/proc')/str(os.getpid())
+            capture.identity='test';capture.origin=0;capture.samples=6
+            capture.cpus=[];capture.interfaces=[];capture.out=Path(directory)
+            reads=[]
+            def read(path):
+                reads.append(str(path));return ''
+            with patch.object(module,'identity',return_value='test'), patch.object(module,'read',side_effect=read):
+                capture.snapshot('poll')
+                self.assertFalse(any(p.endswith(('/numa_maps','/smaps_rollup')) for p in reads))
+                self.assertTrue(any(p.endswith('/status') for p in reads))
+                for phase in ('baseline','final'):
+                    reads.clear();capture.snapshot(phase)
+                    self.assertTrue(any(p.endswith('/numa_maps') for p in reads))
+                    self.assertTrue(any(p.endswith('/smaps_rollup') for p in reads))
+            rows=[json.loads(line) for line in (capture.out/'samples.jsonl').read_text().splitlines()]
+            self.assertEqual([r['phase'] for r in rows],['poll','baseline','final'])
+
+if __name__=='__main__':unittest.main()
diff --git a/tests/tls/compare_openssl.py b/tests/tls/compare_openssl.py
new file mode 100644
--- /dev/null
+++ b/tests/tls/compare_openssl.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Compare two OpenSSL installations using identical TRex TLS engine sources."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import statistics
+import subprocess
+import tempfile
+
+
+def library_dir(prefix):
+    for name in ('lib64', 'lib'):
+        path = prefix/name
+        if all(any((path/('lib'+lib+ext)).is_file() for ext in ('.so', '.dylib'))
+               for lib in ('ssl', 'crypto')):
+            return path
+    raise ValueError('Missing shared OpenSSL libraries under '+str(prefix))
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--baseline-prefix', required=True, type=Path)
+    p.add_argument('--candidate-prefix', required=True, type=Path)
+    p.add_argument('--output', required=True, type=Path)
+    p.add_argument('--seconds', type=float, default=2)
+    p.add_argument('--repeats', type=int, default=5)
+    p.add_argument('--threads', type=int, default=1)
+    args = p.parse_args()
+    if not 0 < args.seconds <= 60 or not 1 <= args.repeats <= 100 or not 1 <= args.threads <= 256:
+        p.error('Invalid duration, repeats or thread count')
+    root = Path(__file__).resolve().parents[2]
+    sources = ['tests/tls/handshake_bench.cpp', 'tests/tls/handshake_primitives.h',
+               'src/44bsd/tls/astf_tls.cpp', 'src/44bsd/tls/astf_tls.h', 'src/astf/astf_cost_metrics.h']
+    result = dict(status='running', sources={f:hashlib.sha256((root/f).read_bytes()).hexdigest() for f in sources},
+                  rows=[], builds={}, note='Native same-host comparison required for performance conclusions')
+    with tempfile.TemporaryDirectory(prefix='trex-openssl-') as tmpname:
+        tmp = Path(tmpname)
+        config = tmp/'openssl.cnf'
+        config.write_text('openssl_conf = init\n[init]\nssl_conf = ssl\n[ssl]\n'
+                          'system_default = fixed\n[fixed]\nGroups = X25519\n'
+                          'Ciphersuites = TLS_AES_256_GCM_SHA384\n'
+                          'SignatureAlgorithms = rsa_pss_rsae_sha256\n'
+                          'CipherString = DEFAULT:@SECLEVEL=2\n')
+        environments = {}
+        for name, prefix in [('baseline', args.baseline_prefix), ('candidate', args.candidate_prefix)]:
+            prefix = prefix.resolve(); lib = library_dir(prefix)
+            env = os.environ.copy()
+            env.update(OPENSSL_CONF=str(config), OPENSSL_MODULES=str(lib/'ossl-modules'),
+                       LD_LIBRARY_PATH=str(lib), DYLD_LIBRARY_PATH=str(lib), TREX_ASTF_COST_SHIFT='8')
+            environments[name] = env
+            command = shlex.split(os.environ.get('CXX', 'c++')) + [
+                '-O2', '-std=c++11', '-DTREX_TLS', '-DTREX_TLS_BENCH_SECURITY_LEVEL=2', '-pthread', '-I'+str(prefix/'include'),
+                '-I'+str(root/'src'), str(root/sources[0]), str(root/sources[2]),
+                '-L'+str(lib), '-Wl,-rpath,'+str(lib), '-lssl', '-lcrypto', '-o', str(tmp/name)]
+            subprocess.run(command, check=True)
+            version = subprocess.check_output([str(prefix/'bin/openssl'), 'version', '-a'], env=env, text=True)
+            result['builds'][name] = dict(command=command, openssl=version, prefix=str(prefix))
+        candidate = args.candidate_prefix.resolve()
+        subprocess.run([str(candidate/'bin/openssl'), 'req', '-x509', '-newkey', 'rsa:2048',
+                        '-nodes', '-keyout', str(tmp/'key.pem'), '-out', str(tmp/'cert.pem'),
+                        '-days', '1', '-subj', '/CN=localhost', '-addext', 'subjectAltName=DNS:localhost'],
+                       env=environments['candidate'], check=True, capture_output=True)
+        result['certificate_sha256'] = hashlib.sha256((tmp/'cert.pem').read_bytes()).hexdigest()
+        for operation in ('full', 'sign', 'verify', 'cert_verify', 'keygen_x25519', 'derive_x25519'):
+            for repeat in range(args.repeats):
+                order = ('baseline', 'candidate') if repeat % 2 == 0 else ('candidate', 'baseline')
+                for name in order:
+                    command = [str(tmp/name), 'libctx', str(args.threads), str(args.seconds),
+                               str(tmp/'cert.pem'), str(tmp/'key.pem'), str(tmp/'cert.pem'),
+                               '1.3', '0', operation, 'localhost']
+                    row = json.loads(subprocess.check_output(command, env=environments[name]))
+                    if row['failed_workers'] or row['completed'] <= 0:
+                        raise RuntimeError('Incomplete benchmark')
+                    if operation == 'full':
+                        for worker in row['workers']:
+                            for n in worker['cost']['negotiated']:
+                                expected = (772, 4866, 1034, 672, 912)
+                                actual = tuple(n[k] for k in ('version','cipher','group_id','signature_digest_nid','signature_type_nid'))
+                                if actual != expected or n['different'] or n['completed'] != worker['completed']:
+                                    raise RuntimeError('Cryptography changed: '+str(n))
+                    result['rows'].append(dict(variant=name, operation=operation, repeat=repeat, result=row))
+                    args.output.parent.mkdir(parents=True, exist_ok=True)
+                    args.output.write_text(json.dumps(result, indent=2)+'\n')
+        result['summary'] = []
+        for operation in ('full','sign','verify','cert_verify','keygen_x25519','derive_x25519'):
+            medians = {name:statistics.median(r['result']['cps'] for r in result['rows']
+                       if r['variant']==name and r['operation']==operation) for name in ('baseline','candidate')}
+            result['summary'].append(dict(operation=operation, medians=medians,
+                change_percent=100*(medians['candidate']/medians['baseline']-1)))
+        result['status'] = 'complete'
+        args.output.write_text(json.dumps(result, indent=2)+'\n')
+        print(json.dumps(result['summary'], indent=2))
+
+if __name__ == '__main__': main()
