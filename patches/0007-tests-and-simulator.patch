@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <cassert>
+#include <iostream>
+#include <stdexcept>
+using namespace astf_tls;
+int main(int argc,char **argv) {
+    assert(argc==5); // strong certificate/key, weak certificate/key
+    Config s; s.server=true; s.cert=argv[1]; s.key=argv[2];
+    Context valid(s);
+#ifdef OPENSSL_IS_AWSLC
+    Config weak=s; weak.cert=argv[3]; weak.key=argv[4];
+    bool rejected=false;
+    try { Context bad(weak); } catch(const std::runtime_error &) { rejected=true; }
+    assert(rejected);
+    for(auto version:{"1.2","1.3"}) {
+        // Independent peer deliberately bypasses our server-side policy.
+        SSL_CTX *raw=SSL_CTX_new(TLS_method()); assert(raw);
+        assert(SSL_CTX_use_certificate_chain_file(raw,argv[3]));
+        assert(SSL_CTX_use_PrivateKey_file(raw,argv[4],SSL_FILETYPE_PEM));
+        int v=std::string(version)=="1.3" ? TLS1_3_VERSION : TLS1_2_VERSION;
+        assert(SSL_CTX_set_min_proto_version(raw,v) && SSL_CTX_set_max_proto_version(raw,v));
+        SSL *peer=SSL_new(raw); assert(peer);
+        BIO *inside=nullptr,*wire=nullptr; assert(BIO_new_bio_pair(&inside,65536,&wire,65536));
+        SSL_set_bio(peer,inside,inside); SSL_set_accept_state(peer);
+        Config c; c.version=version; c.sni="localhost"; c.ca=argv[3];
+        Flow client(std::make_shared<Context>(c));
+        for(unsigned i=0;i<10000 && !client.failed();++i) {
+            client.handshake();
+            const uint8_t *data=nullptr; size_t n=client.peek(&data);
+            if(n) { int sent=BIO_write(wire,data,int(n)); if(sent>0) client.consume(sent); }
+            SSL_do_handshake(peer);
+            char buffer[4096]; int got=BIO_read(wire,buffer,sizeof(buffer));
+            if(got>0) assert(client.feed(buffer,got)==size_t(got));
+        }
+        assert(client.failed() && client.failure()==Failure::VERIFY && !client.ready());
+        SSL_free(peer); BIO_free(wire); SSL_CTX_free(raw);
+
+        Config p; p.version=version; p.psk_identity="test";
+        p.psk_hex="0123456789abcdef0123456789abcdef";
+        rejected=false;
+        try { Context bad(p); } catch(const std::runtime_error &e) {
+            rejected=std::string(e.what()).find("external PSK")!=std::string::npos;
+        }
+        assert(rejected);
+    }
+#endif
+    std::cout<<backend_name()<<" "<<backend_version()<<" policy: PASS\n";
+}
