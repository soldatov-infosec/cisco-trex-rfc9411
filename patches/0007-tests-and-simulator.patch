+#ifdef TREX_TLS
+// Match the NIC HTTP/1.1 profile: ten sequential requests, 16-KiB bodies,
+// blocking sends and a server waiting for the client's TLS close.
+int CClientServerTcp::tls_http_transactions(const std::string &version) {
+    return simple_http_generic([this,&version](CMbufBuffer *req, CMbufBuffer *res,
+            CEmulAppProgram *c, CEmulAppProgram *s, uint32_t) {
+        std::string response="HTTP/1.1 200 OK\r\nContent-Length: 16384\r\n\r\n"+std::string(16384,'x');
+        res->Delete();
+        utl_mbuf_buffer_create_and_copy(0,res,2048,
+            reinterpret_cast<uint8_t *>(&response[0]),response.size());
+        c->m_http.enabled=true;c->m_http.transactions=true;c->m_http.responses=10;
+        for(unsigned i=0;i<10;++i) {
+            CEmulAppCmd mark;mark.m_cmd=tcHTTP_REQUEST;c->add_cmd(mark);
+            build_http(req,res,c,s,response.size());
+        }
+        CEmulAppCmd wait;wait.m_cmd=tcDONT_CLOSE;s->add_cmd(wait);
+        astf_tls::Config config;config.version=version;
+        const char *cert=std::getenv("TREX_TLS_TEST_CERT"),*key=std::getenv("TREX_TLS_TEST_KEY");
+        if(!cert || !key)throw std::runtime_error("TLS simulator needs TREX_TLS_TEST_CERT/KEY");
+        config.ca=cert;config.sni="localhost";
+        c->m_tls_context=std::make_shared<astf_tls::Context>(config);
+        config.server=true;config.cert=cert;config.key=key;
+        s->m_tls_context=std::make_shared<astf_tls::Context>(config);
+        for(auto p:{c,s}) {p->set_stream(true);p->set_addon(nullptr);p->prepare_tls_buffers();}
+        return 0;
+    });
+}
+
+int CClientServerTcp::simple_tls(const std::string &version, size_t bio_capacity,
+                               uint32_t window, tls_scenario_t scenario) {
+    if (window) {
+        for (auto ctx : {&m_c_ctx, &m_s_ctx}) {
+            auto &tune = DEFAULT_PROFILE_CTX(ctx)->m_tunable_ctx;
+            tune.tcp_rx_socket_bsize = window;
+            tune.tcp_tx_socket_bsize = window;
+        }
+    }
+    return simple_http_generic([this, &version, bio_capacity, scenario](CMbufBuffer *req, CMbufBuffer *res,
+                 CEmulAppProgram *c, CEmulAppProgram *s, uint32_t len) {
+        if (scenario == TLS_DUPLEX || scenario == TLS_WORK_BUDGET || scenario == TLS_WORK_CANCEL) {
+            std::vector<uint8_t> request(256 * 1024, 'x');
+            req->Delete();
+            utl_mbuf_buffer_create_and_copy(0, req, 2048, request.data(), request.size());
+        }
+        if (scenario == TLS_NONBLOCK) {
+            std::vector<uint8_t> request(8192, 'n');
+            req->Delete();
+            utl_mbuf_buffer_create_and_copy(0, req, 2048, request.data(), request.size());
+            // Repeated sends cross both the ciphertext byte and slot bounds.
+            // Switching back to blocking adds an ACK fence before receiving.
+            CEmulAppCmd mode;
+            mode.m_cmd = tcTX_MODE;
+            mode.u.m_tx_mode.m_flags = CEmulAppCmdTxMode::txcmd_BLOCK_MASK;
+            c->add_cmd(mode);
+            CEmulAppCmd send;
+            send.m_cmd = tcTX_BUFFER;
+            send.u.m_tx_cmd.m_buf = req;
+            CEmulAppCmd mark;
+            mark.m_cmd = tcADD_STATS;
+            mark.u.m_stats.m_stats_id = 1;
+            mark.u.m_stats.m_val = 1;
+            for (unsigned i = 0; i < 128; ++i) {
+                c->add_cmd(send);
+                c->add_cmd(mark);
+            }
+            mode.u.m_tx_mode.m_flags = 0;
+            c->add_cmd(mode);
+        }
+        if (scenario >= TLS_HTTP_OK) {
+            std::string response;
+            if (scenario == TLS_HTTP_CHUNKED)
+                response="HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n";
+            else
+                response=std::string("HTTP/1.1 ")+(scenario==TLS_HTTP_BAD_STATUS ? "403 Denied" : "200 OK")+
+                    "\r\nContent-Length: 5\r\n\r\n"+(scenario==TLS_HTTP_TRUNCATED ? "hell" : "hello");
+            c->m_http.enabled=true;
+            c->m_http.body_contains=scenario==TLS_HTTP_BAD_BODY ? "missing" : "hello";
+            if (scenario == TLS_HTTP_OK) { c->m_http.responses=10; std::string one=response; for(int i=1;i<10;++i) response+=one; }
+            res->Delete();
+            utl_mbuf_buffer_create_and_copy(0,res,2048,reinterpret_cast<uint8_t*>(&response[0]),response.size());
+            len=response.size();
+        }
+        build_http(req, res, c, s, len);
+        if (scenario == TLS_DUPLEX || scenario == TLS_WORK_BUDGET || scenario == TLS_WORK_CANCEL) {
+            s->get_index(0)->u.m_rx_cmd.m_rx_bytes_wm = 1;
+            CEmulAppCmd receive;
+            receive.m_cmd = tcRX_BUFFER;
+            receive.u.m_rx_cmd.m_flags = CEmulAppCmdRxBuffer::rxcmd_WAIT;
+            receive.u.m_rx_cmd.m_rx_bytes_wm = req->len() - 1;
+            s->add_cmd(receive);
+        }
+        if (scenario == TLS_NONBLOCK) {
+            s->get_index(0)->u.m_rx_cmd.m_rx_bytes_wm = req->len() * 129;
+            c->get_index(c->get_size() - 1)->u.m_rx_cmd.m_rx_bytes_wm = len * 2;
+            CEmulAppCmd mode;
+            mode.m_cmd = tcTX_MODE;
+            mode.u.m_tx_mode.m_flags = CEmulAppCmdTxMode::txcmd_BLOCK_MASK;
+            s->add_cmd(mode);
+            CEmulAppCmd send;
+            send.m_cmd = tcTX_BUFFER;
+            send.u.m_tx_cmd.m_buf = res;
+            s->add_cmd(send); // End the program with outstanding ciphertext.
+
+        }
+        astf_tls::Config config;
+        config.version = version;
+        config.bio_capacity = bio_capacity;
+        if (scenario == TLS_WORK_BUDGET || scenario == TLS_WORK_CANCEL) config.pump_budget = 1;
+        if (scenario == TLS_HANDSHAKE_TIMEOUT) config.handshake_timeout_ms = 50;
+        if (scenario == TLS_CLOSE_STALL || scenario == TLS_SNI_MISMATCH) config.close_timeout_ms = 50;
+        const char *cert=std::getenv("TREX_TLS_TEST_CERT"), *key=std::getenv("TREX_TLS_TEST_KEY");
+        if (!cert || !key) throw std::runtime_error("AWS-LC simulator needs TREX_TLS_TEST_CERT/KEY");
+        config.ca=cert;
+        config.sni=scenario==TLS_SNI_MISMATCH ? "wrong.invalid" : "localhost";
+        c->set_stream(true); s->set_stream(true);
+        c->set_addon(nullptr); s->set_addon(nullptr);
+        c->m_tls_context = std::make_shared<astf_tls::Context>(config);
+        config.server = true;
+        config.cert=cert; config.key=key;
+        if (scenario != TLS_STALL && scenario != TLS_HANDSHAKE_TIMEOUT) s->m_tls_context = std::make_shared<astf_tls::Context>(config);
+        else s->get_index(0)->u.m_rx_cmd.m_rx_bytes_wm = UINT32_MAX;
+        if (scenario == TLS_RESET) s->get_index(1)->m_cmd = tcRESET;
+        if (scenario == TLS_SHORT_READ) c->get_index(1)->u.m_rx_cmd.m_rx_bytes_wm = len + 1;
+        if (scenario == TLS_CANCEL || scenario == TLS_WORK_CANCEL) m_sim.add_event(new CTcpSimEventStop(0.18));
+        if (scenario == TLS_HANDSHAKE_TIMEOUT) m_sim.add_event(new CTcpSimEventStop(1.0));
+        CEmulAppCmd done;
+        done.m_cmd = tcADD_STATS;
+        done.u.m_stats.m_stats_id = 0;
+        done.u.m_stats.m_val = 1;
+        c->add_cmd(done); s->add_cmd(done);
+        c->prepare_tls_buffers(); s->prepare_tls_buffers();
+        return 0;
+    });
+}
+#endif
