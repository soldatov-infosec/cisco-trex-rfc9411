+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <thread>
+#include <atomic>
+#include <fstream>
+#include <cstdio>
+using namespace astf_tls;
+static void move(Flow &a, Flow &b) {
+    const uint8_t *p;
+    size_t n = std::min<size_t>(a.peek(&p), 37);
+    if (n) a.consume(b.feed(p, n));
+}
+static void connect(Flow &c, Flow &s) {
+    for (unsigned i=0; i<200000; ++i) {
+        c.handshake(); s.handshake();
+        char out;
+        if (c.ready()) assert(c.read(&out,1)==0);
+        if (s.ready()) assert(s.read(&out,1)==0);
+        move(c,s); move(s,c);
+        assert(!c.failed() && !s.failed());
+        if (c.ready() && s.ready() && !c.pending() && !s.pending() &&
+            !c.input_pending() && !s.input_pending()) return;
+    }
+    assert(false && "handshake/ticket stalled");
+}
+static void close(Flow &c, Flow &s) {
+    for (unsigned i=0; i<10000; ++i) {
+        c.shutdown(); s.shutdown(); move(c,s); move(s,c);
+        char out;
+        assert(c.read(&out,1)==0 && s.read(&out,1)==0);
+        assert(!c.failed() && !s.failed());
+        if (c.sent_close() && s.sent_close() && c.peer_closed() && s.peer_closed()) return;
+    }
+    assert(false && "close stalled");
+}
+static void application(Flow &c, Flow &s) {
+    bool sent=false;
+    for (unsigned i=0; i<10000; ++i) {
+        if (!sent) sent=c.write("https",5)==5;
+        move(c,s); move(s,c);
+        char out[5];
+        auto n=s.read(out,sizeof(out));
+        assert(!c.failed() && !s.failed());
+        if (n) { assert(n==5 && std::string(out,n)=="https"); return; }
+    }
+    assert(false && "application stalled");
+}
+static void run(std::shared_ptr<Context> cc, std::shared_ptr<Context> sc,
+                bool offered, bool resumed) {
+    Flow c(cc), s(sc);
+    assert(c.resume_attempted()==offered);
+    connect(c,s);
+    assert(c.resumed()==resumed && s.resumed()==resumed);
+    application(c,s); application(s,c); close(c,s);
+    assert(SSL_CTX_sess_number(cc->ctx)==0 && SSL_CTX_sess_number(sc->ctx)==0);
+}
+int main(int argc, char **argv) {
+    assert(argc == 3);
+    for (auto version : {"1.2", "1.3"}) {
+        Config c, s;
+        c.version = s.version = version;
+        c.resumption = s.resumption = true;
+        c.sni = "localhost"; c.ca = argv[1];
+        s.server = true; s.cert = argv[1]; s.key = argv[2];
+        auto pc = std::make_shared<Context>(c), ps = std::make_shared<Context>(s);
+#ifndef OPENSSL_IS_AWSLC
+        OSSL_LIB_CTX *before = OSSL_LIB_CTX_set0_default(nullptr);
+#endif
+        std::atomic<unsigned> ready{0};
+        std::array<const Library *, 4> identities{};
+        std::vector<std::thread> threads;
+        for (unsigned i=0; i<identities.size(); ++i) threads.emplace_back([&,i] {
+#ifndef OPENSSL_IS_AWSLC
+            auto previous = OSSL_LIB_CTX_set0_default(nullptr);
+#endif
+            std::weak_ptr<Library> lifetime;
+            {
+                WorkerContexts programs;
+                programs.prepare({pc, ps});
+                auto cc = programs.get(pc.get()), sc = programs.get(ps.get());
+                assert(cc->library && cc->library == sc->library);
+                assert(cc->ctx != pc->ctx && sc->ctx != ps->ctx);
+                lifetime = cc->library;
+                identities[i] = cc->library.get();
+                ++ready;
+                while (ready.load() != identities.size()) std::this_thread::yield();
+                for (unsigned j=0; j<i; ++j) assert(identities[j] != identities[i]);
+                run(cc,sc,false,false);
+                for (int n=0;n<8;++n) run(cc,sc,true,true);
+                // A server clone in a different library can accept this ticket.
+                auto other_library = std::make_shared<Library>();
+                auto other_server = ps->clone_for_worker(other_library);
+                run(cc,other_server,true,true);
+                run(cc,sc,true,true);
+#ifndef OPENSSL_IS_AWSLC
+                assert(OSSL_LIB_CTX_set0_default(nullptr) == previous);
+#endif
+                // Reloading the profile changes the ticket namespace.
+                auto new_program = std::make_shared<Context>(s);
+                auto new_server = new_program->clone_for_worker(other_library);
+                run(cc,new_server,true,false);
+                run(cc,new_server,true,true);
+            }
+            assert(lifetime.expired());
+#ifndef OPENSSL_IS_AWSLC
+            assert(OSSL_LIB_CTX_set0_default(nullptr) == previous);
+#endif
+        });
+        for (auto &thread : threads) thread.join();
+#ifndef OPENSSL_IS_AWSLC
+        assert(OSSL_LIB_CTX_set0_default(nullptr) == before);
+#endif
+        // Preparation is transactional: failure preserves the old lookup.
+        std::string copy = std::string(argv[1]) + ".worker-copy";
+        { std::ifstream in(argv[1], std::ios::binary); std::ofstream out(copy, std::ios::binary); out << in.rdbuf(); assert(out.good()); }
+        Config missing = s; missing.cert = copy;
+        auto stale = std::make_shared<Context>(missing);
+        assert(std::remove(copy.c_str()) == 0);
+        WorkerContexts programs; programs.prepare({pc,ps});
+        auto original = programs.get(pc.get());
+        bool threw = false;
+        try { programs.prepare({pc, stale}); } catch (const std::exception &) { threw = true; }
+        assert(threw && programs.get(pc.get()) == original);
+        // Certificate and external PSK paths both work in isolated libraries.
+        for (bool psk : {false,true}) {
+            Config a=c, b=s; a.resumption=b.resumption=false;
+            if (psk) {
+                a.psk_identity=b.psk_identity="worker-test";
+                a.psk_hex=b.psk_hex="0123456789abcdef0123456789abcdef";
+                b.cert.clear(); b.key.clear();
+            }
+#ifdef OPENSSL_IS_AWSLC
+            if (psk) {
+                bool rejected=false;
+                try { Context unsupported(a); } catch (const std::runtime_error &) { rejected=true; }
+                assert(rejected); continue;
+            }
+#endif
+            auto x=std::make_shared<Context>(a), y=std::make_shared<Context>(b);
+            WorkerContexts local; local.prepare({x,y});
+            Flow client(local.get(x.get())), server(local.get(y.get()));
+            connect(client,server); application(client,server); application(server,client); close(client,server);
+        }
+        std::cout << version << " worker isolation/lifetime/rollback/cross-context tickets OK\n";
+    }
+}
