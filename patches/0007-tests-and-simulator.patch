+/* SPDX-License-Identifier: Apache-2.0 */
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <cassert>
+#include <iostream>
+#include <algorithm>
+using namespace astf_tls;
+static bool transfer(Flow &from, Flow &to, size_t fragment=17) {
+    const uint8_t *bytes = nullptr;
+    size_t n=std::min(from.peek(&bytes), fragment);
+    size_t accepted = n ? to.feed(bytes,n) : 0;
+    if (accepted) from.consume(accepted);
+    return accepted != 0;
+}
+static bool connect(Flow &c, Flow &s) {
+    for (int i=0;i<200000;++i) {
+        c.handshake(); s.handshake();
+        if (c.failed() || s.failed()) return false;
+        transfer(c,s); transfer(s,c);
+        if (c.failed() || s.failed()) return false;
+        if (c.ready() && s.ready() && !c.pending() && !s.pending()) return true;
+    }
+    assert(false && "handshake stalled"); return false;
+}
+static void exchange(Flow &c, Flow &s) {
+    std::string data(300000, '\0');
+    for (size_t i=0; i<data.size(); ++i) data[i]=static_cast<char>((i*37 + i/251) & 255);
+    std::string received;
+    size_t offset=0;
+    for (int i=0;i<2000000 && received.size()<data.size();++i) {
+        if (offset<data.size()) offset+=c.write(data.data()+offset,std::min<size_t>(16384,data.size()-offset));
+        transfer(c,s,31); transfer(s,c,31);
+        char out[901]; size_t n=s.read(out,sizeof(out)); received.append(out,n);
+        assert(!c.failed() && !s.failed());
+    }
+    assert(received==data);
+    c.shutdown();
+    for (int i=0;i<10000 && !s.peer_closed();++i) {
+        c.shutdown(); transfer(c,s,1); char byte; s.read(&byte,1);
+    }
+    assert(s.peer_closed() && !s.failed());
+    s.shutdown();
+    for (int i=0;i<10000 && !c.peer_closed();++i) {
+        s.shutdown(); transfer(s,c,1); char byte; c.read(&byte,1);
+    }
+    assert(c.peer_closed() && !c.failed());
+}
+
+#include "astf/astf_cost_metrics.h"
+int main(int argc, char **argv) {
+    assert(argc == 3); // ECDSA P-256 certificate and key, SAN localhost
+    for (auto cipher : {"TLS_AES_128_GCM_SHA256", "TLS_AES_256_GCM_SHA384", "TLS_CHACHA20_POLY1305_SHA256"}) {
+        Config c,s; c.sni="localhost"; c.ca=argv[1]; s.server=true; s.cert=argv[1]; s.key=argv[2];
+        c.cipher_suite=s.cipher_suite=cipher;
+        auto cc=std::make_shared<Context>(c), sc=std::make_shared<Context>(s);
+        for(int repeat=0;repeat<2;++repeat) {
+            astf_cost::Metrics metrics; astf_cost::Binding binding(&metrics);
+            Flow client(cc), server(sc); assert(connect(client,server));
+            astf_cost::Negotiation n; uint64_t completed=0,different=0;
+            assert(metrics.negotiation(false,n,completed,different));
+            unsigned expected=std::string(cipher)=="TLS_AES_128_GCM_SHA256" ? 4865 : std::string(cipher)=="TLS_AES_256_GCM_SHA384" ? 4866 : 4867;
+            assert(n.cipher==expected && n.version==TLS1_3_VERSION);
+            assert(n.signature==NID_sha256 && n.signature_type==NID_X9_62_id_ecPublicKey);
+            assert(!client.resumed() && !server.resumed());
+            exchange(client,server);
+        }
+        s.cipher_suite=std::string(cipher)=="TLS_AES_128_GCM_SHA256" ? "TLS_AES_256_GCM_SHA384" : "TLS_AES_128_GCM_SHA256";
+        Flow badclient(cc), badserver(std::make_shared<Context>(s)); assert(!connect(badclient,badserver));
+    }
+    for (auto bad : {"INVALID", "TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384", "TLS_AES_128_CCM_SHA256"}) {
+        Config c; c.cipher_suite=bad; bool rejected=false;
+        try { Context ctx(c); } catch(const std::runtime_error &) { rejected=true; }
+        assert(rejected);
+    }
+    Config c; c.cipher_suite="TLS_AES_128_GCM_SHA256"; c.version="1.2"; bool rejected=false;
+    try { Context ctx(c); } catch(const std::runtime_error &) { rejected=true; }
+    assert(rejected);
+    std::cout << "ECDSA P-256/SHA256, all three TLS 1.3 suites, full handshakes, payload/close, invalid/mismatched suite: PASS\n";
+}
