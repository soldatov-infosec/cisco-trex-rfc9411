+"""Validate text-collector output from a completed TLS-only veth workload.
+Usage: python3 tests/tls/check_cost_metrics.py /path/to/stats.jsonl 0|8|off
+"""
+import json
+import sys
+from pathlib import Path
+rows = [json.loads(line) for line in Path(sys.argv[1]).read_text().splitlines()]
+mode = sys.argv[2]
+before, after = rows[0]['stats'], rows[-1]['stats']
+assert after['traffic']['client']['m_active_flows'] == 0
+assert after['traffic']['client']['tcps_tls_errors'] == 0
+assert after['traffic']['server']['tcps_tls_errors'] == 0
+base, final = before['utilization']['cpu'], after['utilization']['cpu']
+assert len(base) == len(final) and final
+metrics = {}
+for a, b in zip(base, final):
+    x, y = a['tls_cost'], b['tls_cost']
+    assert y['schema'] in (1,2) and y['config_valid']
+    assert y['enabled'] == (mode != 'off')
+    assert y['sample_shift'] == (-1 if mode == 'off' else int(mode))
+    if mode == 'off':
+        assert not y['metrics']
+        continue
+    if y['schema']==2:
+        assert y['openssl_runtime']
+        for side in ('client','server'):
+            n=y['negotiated'][side]
+            assert n['different_from_first']==0 and n['tls_version_id'] in (771,772)
+            assert n['cipher_protocol_id'] and n['group_name']
+            if side == 'client':
+                assert n['signature_digest_nid'] and n['signature_type_nid']
+            else:
+                assert n['signature_digest_nid']==n['signature_type_nid']==0
+    for name, values in y['metrics'].items():
+        previous = x['metrics'].get(name, dict(calls=0, bytes=0, samples=0, histogram_log2_ns={}))
+        sums = metrics.setdefault(name, dict(calls=0, bytes=0, samples=0))
+        for key in sums:
+            delta = values[key] - previous[key]
+            assert delta >= 0
+            sums[key] += delta
+        bins = sum(values['histogram_log2_ns'].values()) - sum(previous['histogram_log2_ns'].values())
+        assert bins == values['samples'] - previous['samples']
+        assert values['max_sampled_ns'] <= values['sampled_ns']
+        if mode == '0':
+            assert values['calls'] == values['samples']
+if mode != 'off':
+    for side in ['client', 'server']:
+        assert metrics['write_'+side]['bytes'] == after['traffic'][side]['tcps_tls_sndbyte'] - before['traffic'][side]['tcps_tls_sndbyte']
+        assert metrics['read_'+side]['bytes'] == after['traffic'][side]['tcps_tls_rcvbyte'] - before['traffic'][side]['tcps_tls_rcvbyte']
+        expected = after['traffic'][side]['tcps_tls_attempts'] - before['traffic'][side]['tcps_tls_attempts']
+        assert metrics['flow_create_'+side]['calls'] == expected
+        assert metrics['flow_free_'+side]['calls'] == expected
+    if final[0]['tls_cost']['schema']==2:
+        for side in ('client','server'):
+            total=metrics['handshake_ssl_'+side]['calls']
+            assert total==sum(v['calls'] for k,v in metrics.items() if k.startswith('handshake_state_'+side+'_'))
+            assert metrics['handshake_result_'+side]['calls']==total
+    assert metrics['wire_copy']['bytes'] > 0
+    assert metrics['mbuf_alloc']['calls'] > 0
+    assert metrics['rx_batch']['samples'] > 0
+print('PASS mode='+mode, json.dumps(metrics, sort_keys=True))
