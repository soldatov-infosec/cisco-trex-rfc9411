diff --git a/tests/tls/engine_test.cpp b/tests/tls/engine_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/engine_test.cpp
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <cassert>
+#include <iostream>
+#include <algorithm>
+using namespace astf_tls;
+static bool transfer(Flow &from, Flow &to, size_t fragment=17) {
+    const uint8_t *bytes = nullptr;
+    size_t n=std::min(from.peek(&bytes), fragment);
+    size_t accepted = n ? to.feed(bytes,n) : 0;
+    if (accepted) from.consume(accepted);
+    return accepted != 0;
+}
+static bool connect(Flow &c, Flow &s) {
+    c.coalesce_reads(true); s.coalesce_reads(true);
+    for (int i=0;i<200000;++i) {
+        c.handshake(); s.handshake();
+        if (c.failed() || s.failed()) return false;
+        transfer(c,s); transfer(s,c);
+        if (c.failed() || s.failed()) return false;
+        if (c.ready() && s.ready() && !c.pending() && !s.pending()) return true;
+    }
+    assert(false && "handshake stalled"); return false;
+}
+static void exchange(Flow &c, Flow &s) {
+    std::string data(300000, '\0');
+    for (size_t i=0; i<data.size(); ++i) data[i]=static_cast<char>((i*37 + i/251) & 255);
+    std::string received;
+    size_t offset=0;
+    for (int i=0;i<2000000 && received.size()<data.size();++i) {
+        if (offset<data.size()) offset+=c.write(data.data()+offset,std::min<size_t>(16384,data.size()-offset));
+        transfer(c,s,31); transfer(s,c,31);
+        char out[901]; size_t n=s.read(out,sizeof(out)); received.append(out,n);
+        assert(!c.failed() && !s.failed());
+    }
+    assert(received==data);
+    c.shutdown();
+    for (int i=0;i<10000 && !s.peer_closed();++i) {
+        c.shutdown(); transfer(c,s,1); char byte; s.read(&byte,1);
+    }
+    assert(s.peer_closed() && !s.failed());
+    s.shutdown();
+    for (int i=0;i<10000 && !c.peer_closed();++i) {
+        s.shutdown(); transfer(s,c,1); char byte; c.read(&byte,1);
+    }
+    assert(c.peer_closed() && !c.failed());
+}
+static void write_retry(std::shared_ptr<Context> cc, std::shared_ptr<Context> sc) {
+    std::string payload(16384, 'w');
+    Flow c(cc), s(sc);
+    assert(connect(c, s));
+    assert(c.write(payload.data(), payload.size()) == 0);
+    assert(c.write_retry_pending() && c.write_blocks_read());
+    const char reply[] = "incoming while write is blocked";
+    assert(s.write(reply, sizeof(reply)) == sizeof(reply));
+    while (s.pending()) assert(transfer(s, c, 128));
+    size_t input = c.input_pending(), output = c.pending();
+    char buf[1024];
+    assert(c.read(buf, sizeof(buf)) == 0);
+    assert(c.input_pending() == input && c.pending() == output);
+    assert(!c.handshake());
+    c.shutdown();
+    assert(!c.sent_close() && c.write_blocks_read());
+    std::string received, response;
+    size_t written = 0;
+    for (int i = 0; i < 200000; ++i) {
+        transfer(c, s, 31);
+        received.append(buf, s.read(buf, sizeof(buf)));
+        if (!written) written = c.write(payload.data(), payload.size());
+        response.append(buf, c.read(buf, sizeof(buf)));
+        assert(!c.failed() && !s.failed());
+        if (received == payload && response.size() == sizeof(reply)) break;
+        assert(i != 199999);
+    }
+    assert(written == payload.size() && !c.write_retry_pending());
+    assert(response == std::string(reply, sizeof(reply)));
+    // Both pointer and length changes are rejected before entering OpenSSL.
+    for (bool change_pointer : {false, true}) {
+        Flow wrong(cc), peer(sc);
+        assert(connect(wrong, peer));
+        assert(wrong.write(payload.data(), payload.size()) == 0);
+        std::string copy = payload;
+        assert(wrong.write(change_pointer ? copy.data() : payload.data(),
+                           change_pointer ? payload.size() : payload.size()-1) == 0);
+        assert(wrong.failed() && wrong.failure() == Failure::APPLICATION);
+    }
+    // Teardown with an outstanding retry must not retain the caller's buffer.
+    Flow abandoned(cc), peer(sc);
+    assert(connect(abandoned, peer));
+    assert(abandoned.write(payload.data(), payload.size()) == 0);
+    assert(abandoned.write_retry_pending());
+}
+
+static void close_retry(std::shared_ptr<Context> cc, std::shared_ptr<Context> sc) {
+    Flow c(cc), s(sc);
+    assert(connect(c,s));
+    assert(c.write("x",1)==1);
+    size_t record=c.pending(), count=1;
+    while (c.pending()+record<=cc->config.bio_capacity) {
+        assert(c.write("x",1)==1);
+        ++count;
+    }
+    c.shutdown();
+    assert(!c.sent_close()); // close_notify cannot fit; must retry despite SSL_SENT_SHUTDOWN.
+    size_t received=0;
+    for (int i=0;i<10000 && (!s.peer_closed() || !c.sent_close());++i) {
+        transfer(c,s,1);
+        char out[64]; received+=s.read(out,sizeof(out));
+        c.shutdown();
+        assert(!c.failed() && !s.failed());
+    }
+    assert(c.sent_close() && s.peer_closed() && received==count);
+}
+static void half_close(std::shared_ptr<Context> cc, std::shared_ptr<Context> sc) {
+    Flow c(cc), s(sc);
+    assert(connect(c,s));
+    for (int i=0;i<10000 && !s.peer_closed();++i) {
+        c.shutdown(); transfer(c,s,1); char byte; s.read(&byte,1);
+    }
+    assert(s.peer_closed() && s.can_write());
+    assert(s.write("reply",5)==5);
+    std::string received;
+    for (int i=0;i<10000 && !c.peer_closed();++i) {
+        s.shutdown(); transfer(s,c,1);
+        char out[8]; received.append(out,c.read(out,sizeof(out)));
+    }
+    assert(received=="reply" && c.peer_closed());
+}
+
+static void coalesced_records(std::shared_ptr<Context> cc, std::shared_ptr<Context> sc) {
+    Flow c(cc), s(sc); assert(connect(c,s));
+    std::string expected, received;
+    for(int i=0;i<8;++i) {
+        std::string record(31,char('a'+i)); expected+=record;
+        assert(c.write(record.data(),record.size())==record.size());
+    }
+    std::vector<uint8_t> wire(c.pending());
+    assert(c.drain(wire.data(),wire.size())==wire.size());
+    assert(s.feed(wire.data(),wire.size())==wire.size());
+    for(int i=0;i<100 && received.size()<expected.size();++i) {
+        char b[11]; received.append(b,s.read(b,sizeof(b)));
+    }
+    assert(received==expected && !s.failed());
+}
+
+static void bad_records(std::shared_ptr<Context> cc, std::shared_ptr<Context> sc) {
+    for (int mode=0; mode!=6; ++mode) {
+        Flow c(cc), s(sc); assert(connect(c,s));
+        assert(c.write("authenticated payload",21)==21);
+        std::vector<uint8_t> wire(c.pending());
+        assert(c.drain(wire.data(),wire.size())==wire.size());
+        size_t cut=wire.size();
+        if(mode==0) wire.back()^=1; // corrupt authentication tag
+        else cut=mode==5 ? wire.size()-1 : size_t(mode-1);
+        size_t offset=0; char out[64]; size_t plain=0;
+        while(offset<cut) {
+            size_t n=s.feed(wire.data()+offset,1); offset+=n;
+            plain+=s.read(out,sizeof(out));
+            if(s.failed()) break;
+        }
+        if(mode) s.eof();
+        plain+=s.read(out,sizeof(out));
+        assert(s.failed() && plain==0);
+        assert(s.failure()==(mode ? Failure::TRUNCATED : Failure::PROTOCOL));
+        auto reason=s.openssl_error(); assert(reason!=0);
+        c.read(out,sizeof(out)); // another flow clears OpenSSL's thread error queue
+        assert(s.openssl_error()==reason && s.write("x",1)==0);
+    }
+}
+
+int main(int argc, char **argv) {
+    assert(argc==4); // certificate, key, CA
+    for (size_t capacity: {size_t(128), size_t(65536)}) for (auto version: {"1.2", "1.3"}) for (bool psk: {false,true}) for (auto alpn: {"http/1.1","h2"}) {
+        Config c,s; c.version=s.version=version; c.alpn=s.alpn=alpn;
+        s.server=true; c.bio_capacity=s.bio_capacity=capacity;
+        if (psk) {
+            c.psk_identity=s.psk_identity="trex-test";
+            c.psk_hex=s.psk_hex="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+        } else { c.sni="localhost"; c.ca=argv[3]; s.cert=argv[1]; s.key=argv[2]; }
+#ifdef OPENSSL_IS_AWSLC
+        if (psk) {
+            bool rejected=false;
+            try { Context unsupported(c); } catch (const std::runtime_error &e) {
+                rejected=std::string(e.what()).find("external PSK")!=std::string::npos;
+            }
+            assert(rejected); continue;
+        }
+#endif
+        auto cc=std::make_shared<Context>(c), sc=std::make_shared<Context>(s);
+        Flow client(cc),server(sc);
+        assert(connect(client,server));
+        assert(client.negotiated_alpn()==alpn && server.negotiated_alpn()==alpn);
+        exchange(client,server);
+        if(capacity==65536 && c.alpn=="http/1.1") {
+            bad_records(cc,sc); coalesced_records(cc,sc);
+        }
+        if (capacity==128) { close_retry(cc,sc); write_retry(cc,sc); }
+        if (c.version=="1.3") half_close(cc,sc);
+        if (psk && c.version == "1.3") {
+            Config fallback; fallback.server=true; fallback.alpn=alpn;
+            fallback.cert=argv[1]; fallback.key=argv[2];
+            Flow victim(cc), impersonator(std::make_shared<Context>(fallback));
+            assert(!connect(victim,impersonator));
+        }
+        // Fresh connection: wrong credentials must fail, with no application bytes.
+        if (psk) c.psk_hex[0]='f'; else c.sni="wrong.invalid";
+        Flow wrong(std::make_shared<Context>(c)),peer(sc);
+        assert(!connect(wrong,peer));
+        if (!psk) {
+            assert(peer.failed() && !peer.ready()); // Server rejects SNI first.
+            // Keep independent coverage of client hostname verification against
+            // a permissive external peer; bypass server check only in this test.
+            auto permissive=std::make_shared<Context>(s);
+            SSL_CTX_set_tlsext_servername_callback(permissive->ctx,nullptr);
+            Flow verifier(std::make_shared<Context>(c)), external(permissive);
+            assert(!connect(verifier,external));
+            assert(verifier.failure()==Failure::VERIFY && verifier.verify_error()!=X509_V_OK);
+        }
+        // Abrupt EOF must not be accepted as an authenticated close_notify.
+        Flow truncated(cc),other(sc);
+        assert(connect(truncated,other));
+        truncated.eof(); char byte; truncated.read(&byte,1);
+        assert(truncated.failed() && truncated.failure()==Failure::TRUNCATED);
+        std::cout << "BIO=" << capacity << " " << version << " " << (psk?"PSK":"certificate") << " " << alpn << " OK\n";
+    }
+}
diff --git a/tests/tls/error_classification_test.cpp b/tests/tls/error_classification_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/error_classification_test.cpp
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <cassert>
+#include <cstdio>
+#include <openssl/err.h>
+using namespace astf_tls;
+static void move(Flow &a, Flow &b) {
+    const uint8_t *data=nullptr; size_t n=a.peek(&data);
+    if(n) a.consume(b.feed(data,n));
+}
+static void pre_certificate(const char *version) {
+    for(int which=0;which<3;++which) {
+        Config c; c.version=version; c.sni="localhost";
+        Flow f(std::make_shared<Context>(c)); f.handshake();
+        unsigned char out[4096]; while(f.pending()) f.drain(out,sizeof(out));
+        const unsigned char alert[]={21,3,3,0,2,2,112};
+        const unsigned char malformed[]={0,0,0,0,0};
+        if(which==0) f.feed(alert,sizeof(alert));
+        else if(which==1) f.feed(malformed,sizeof(malformed));
+        else f.eof();
+        f.handshake();
+        assert(f.failed());
+        assert(f.failure()==(which==2 ? Failure::TRUNCATED : Failure::PROTOCOL));
+    }
+}
+static void exchange(const char *version,const char *cert,const char *key,int which) {
+    Config c,s; c.version=s.version=version; c.sni="localhost";
+    s.server=true; s.cert=cert; s.key=key;
+    // 0: untrusted issuer; 1: hostname mismatch; 2/3: valid chain then EOF/alert.
+    if(which!=0) c.ca=cert;
+    if(which==1) c.sni="wrong.invalid";
+    auto server_context=std::make_shared<Context>(s);
+    // Isolate hostname verification from the server's earlier SNI rejection.
+    if(which==1) SSL_CTX_set_tlsext_servername_callback(server_context->ctx,nullptr);
+    Flow client(std::make_shared<Context>(c)),server(server_context);
+    for(unsigned i=0;i<10000 && !client.failed() && !(client.ready() && server.ready());++i) {
+        client.handshake(); server.handshake(); move(client,server); move(server,client);
+    }
+    if(which<2) {
+        if (!client.failed() || client.failure()!=Failure::VERIFY)
+            std::fprintf(stderr,"version=%s case=%d failed=%d class=%u verify=%ld ssl=%lu reason=%s\n",version,which,client.failed(),unsigned(client.failure()),client.verify_error(),client.openssl_error(),ERR_reason_error_string(client.openssl_error()));
+        assert(client.failed() && client.failure()==Failure::VERIFY);
+        return;
+    }
+    assert(client.ready() && server.ready());
+    if(which==2) client.eof();
+    else {
+        // A plaintext fatal alert after establishment is invalid TLS traffic.
+        const unsigned char alert[]={21,3,3,0,2,2,112};
+        assert(client.feed(alert,sizeof(alert))==sizeof(alert));
+    }
+    char scratch[1024];
+    for(unsigned i=0;i<100 && !client.failed();++i) client.read(scratch,sizeof(scratch));
+    assert(client.failed());
+    assert(client.failure()==(which==2 ? Failure::TRUNCATED : Failure::PROTOCOL));
+}
+int main(int argc,char **argv) {
+    assert(argc==3);
+    for(auto version:{"1.2","1.3"}) {
+        pre_certificate(version);
+        for(int which=0;which<4;++which) exchange(version,argv[1],argv[2],which);
+        printf("TLS %s error classification: protocol, pre/post-certificate EOF, chain, hostname PASS\n",version);
+    }
+}
diff --git a/tests/tls/features_test.cpp b/tests/tls/features_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/features_test.cpp
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <cassert>
+#include <openssl/pem.h>
+#include <iostream>
+using namespace astf_tls;
+static void transfer(Flow &a,Flow &b) {
+    const uint8_t *p; size_t n=a.peek(&p); if(n) a.consume(b.feed(p,n));
+}
+static bool connect(Config c,Config s) {
+    Flow client(std::make_shared<Context>(c)),server(std::make_shared<Context>(s));
+    for(unsigned i=0;i<10000;++i) {
+        client.handshake(); transfer(client,server); server.handshake(); transfer(server,client);
+        if(client.failed()||server.failed()) return false;
+        if(client.ready()&&server.ready()) {
+            assert(client.negotiated_version()==(c.version=="1.2" ? 0x0303 : 0x0304));
+            assert(server.negotiated_version()==client.negotiated_version());
+            assert(client.negotiated_cipher()==(c.version=="1.2" ? 0xc02b : 0x1301));
+            assert(server.negotiated_cipher()==client.negotiated_cipher());
+            assert(client.negotiated_group()==23 && server.negotiated_group()==23);
+            assert(client.peer_signature()==0x0403 && server.peer_signature()==0x0403);
+            const char msg[]="authenticated"; char out[32]={};
+            assert(client.write(msg,sizeof(msg))==sizeof(msg)); transfer(client,server);
+            assert(server.read(out,sizeof(out))==sizeof(msg));
+            assert(std::string(out)==msg); return true;
+        }
+    }
+    assert(false); return false;
+}
+static void invalid(Config c) { bool rejected=false; try {Context ctx(c);} catch(const std::runtime_error&){rejected=true;} assert(rejected); }
+int main(int argc,char**argv) {
+    assert(argc==2); std::string dir=argv[1];
+    FILE *f=fopen((dir+"/client.pem").c_str(),"r"); assert(f);
+    X509 *expired=PEM_read_X509(f,nullptr,nullptr,nullptr); fclose(f); assert(expired);
+    f=fopen((dir+"/ca.key").c_str(),"r"); assert(f);
+    EVP_PKEY *key=PEM_read_PrivateKey(f,nullptr,nullptr,nullptr); fclose(f); assert(key);
+    assert(ASN1_TIME_set(X509_get_notBefore(expired),1));
+    assert(ASN1_TIME_set(X509_get_notAfter(expired),2));
+    assert(X509_sign(expired,key,EVP_sha256())); EVP_PKEY_free(key);
+    f=fopen((dir+"/expired.pem").c_str(),"w"); assert(f);
+    assert(PEM_write_X509(f,expired)); fclose(f); X509_free(expired);
+    for(auto version:{"1.2","1.3"}) {
+        Config c,s; c.version=s.version=version; c.sni="localhost"; c.ca=dir+"/ca.pem";
+        s.server=true; s.cert=dir+"/server.pem"; s.key=dir+"/server.key"; s.ca=c.ca; s.require_client_cert=true;
+        c.cert=dir+"/client.pem"; c.key=dir+"/client.key";
+        c.groups=s.groups={"P-256"}; c.signature_algorithms=s.signature_algorithms={"ecdsa_secp256r1_sha256"};
+        c.cipher_suite=s.cipher_suite=std::string(version)=="1.2"?"ECDHE-ECDSA-AES128-GCM-SHA256":"TLS_AES_128_GCM_SHA256";
+        assert(connect(c,s));
+        auto bad=c; bad.cert=bad.key=""; assert(!connect(bad,s));
+        bad=c; bad.cert=dir+"/rogue.pem"; bad.key=dir+"/rogue.key"; assert(!connect(bad,s));
+        bad=c; bad.cert=dir+"/wrong-eku.pem"; assert(!connect(bad,s));
+        bad=c; bad.cert=dir+"/expired.pem"; assert(!connect(bad,s));
+        bad=c; bad.groups={"P-384"}; assert(!connect(bad,s));
+        bad=c; bad.signature_algorithms={"rsa_pss_rsae_sha256"}; assert(!connect(bad,s));
+        bad=c; bad.cipher_suite=std::string(version)=="1.2" ? "ECDHE-ECDSA-AES256-GCM-SHA384" : "TLS_AES_256_GCM_SHA384";
+        assert(!connect(bad,s));
+        bad=s; bad.verify=false; invalid(bad); bad=s; bad.ca=""; invalid(bad);
+        bad=c; bad.require_client_cert=true; invalid(bad);
+        bad=c; bad.groups={"P-256","P-256"}; invalid(bad);
+        bad=c; bad.signature_algorithms={"RSA+SHA1"}; invalid(bad);
+        bad=c; bad.cipher_suite="ALL"; invalid(bad);
+    }
+    std::cout<<"TLS 1.2/1.3 policy intersections, mTLS trusted/missing/untrusted/wrong EKU: PASS\n";
+}
diff --git a/tests/tls/handshake_bench.cpp b/tests/tls/handshake_bench.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/handshake_bench.cpp
@@ -0,0 +1,171 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Standalone diagnostic: exact patched TLS engine, worker-local contexts, no DPDK.
+#include "44bsd/tls/astf_tls.h"
+#include <openssl/crypto.h>
+#include <openssl/err.h>
+#include <openssl/x509v3.h>
+#include "astf/astf_cost_metrics.h"
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <iostream>
+#include <mutex>
+#include <thread>
+#include <vector>
+#include <stdexcept>
+#include <cstdlib>
+#include <sstream>
+#include <ctime>
+#ifdef __linux__
+#include <sched.h>
+#endif
+using namespace astf_tls;
+using Clock = std::chrono::steady_clock;
+static void check(bool ok, const char *msg) { if (!ok) throw std::runtime_error(msg); }
+static void transfer(Flow &a, Flow &b) {
+    const uint8_t *p = nullptr;
+    size_t n = a.peek(&p);
+    if (n) a.consume(b.feed(p,n));
+}
+static void healthy(Flow &c, Flow &s) {
+    check(!c.failed() && !s.failed(), "TLS flow failure");
+}
+static void payload(Flow &a, Flow &b, size_t bytes) {
+    char input[16384], output[16384];
+    std::memset(input, 'x', sizeof(input));
+    size_t sent=0, received=0;
+    for (unsigned step=0; received<bytes && step<100000; ++step) {
+        if (sent<bytes) sent+=a.write(input, std::min(sizeof(input),bytes-sent));
+        transfer(a,b); transfer(b,a);
+        size_t n=b.read(output,sizeof(output));
+        check(received+n<=bytes, "excess plaintext");
+        check(std::memcmp(input,output,n)==0, "corrupt plaintext");
+        received+=n; healthy(a,b);
+    }
+    check(sent==bytes && received==bytes, "payload stalled");
+}
+static void transaction(const std::shared_ptr<Context> &cc,
+                        const std::shared_ptr<Context> &sc, size_t bytes) {
+    Flow c(cc), s(sc);
+    for (unsigned i=0; i<10000; ++i) {
+        c.handshake(); s.handshake(); transfer(c,s); transfer(s,c); healthy(c,s);
+        if (c.ready() && s.ready() && !c.pending() && !s.pending()) break;
+        check(i!=9999,"handshake stalled");
+    }
+    check(!c.resumed() && !s.resumed(), "unexpected resumption");
+    payload(c,s,bytes ? 2550 : 0); payload(s,c,bytes);
+    char scratch[1];
+    for (unsigned i=0; i<10000; ++i) {
+        c.shutdown(); s.shutdown(); transfer(c,s); transfer(s,c);
+        c.read(scratch,1); s.read(scratch,1); healthy(c,s);
+        if (c.peer_closed() && s.peer_closed() && c.sent_close() && s.sent_close()
+            && !c.pending() && !s.pending()) return;
+    }
+    throw std::runtime_error("shutdown stalled");
+}
+static void pin_worker(int id) {
+    const char *cpus=std::getenv("TREX_TLS_BENCH_CPUS");
+    if (!cpus || !*cpus) return;
+#ifdef __linux__
+    std::istringstream list(cpus); std::string item;
+    for (int i=0;i<=id;++i) check(bool(std::getline(list,item,',')),"too few CPU IDs");
+    int cpu=std::stoi(item); check(cpu>=0 && cpu<CPU_SETSIZE,"CPU ID out of range");
+    cpu_set_t set; CPU_ZERO(&set); CPU_SET(cpu,&set);
+    check(sched_setaffinity(0,sizeof(set),&set)==0,"sched_setaffinity failed");
+#else
+    (void)id; throw std::runtime_error("CPU pinning requires Linux");
+#endif
+}
+struct Result { uint64_t completed=0; double seconds=0; std::string error; std::string cost; };
+int main(int argc, char **argv) {
+    try {
+        check(argc==11,"usage: bench libctx threads seconds cert key ca version response_bytes operation hostname");
+        std::string mode=argv[1];
+        check(mode=="libctx","bad mode");
+        int threads=std::stoi(argv[2]); double seconds=std::stod(argv[3]);
+        size_t bytes=std::stoull(argv[8]);
+        check(threads>0 && threads<=256 && seconds>0 && seconds<=3600 && bytes<=16777216,"bad bounds");
+        Config c,s; c.sni=argv[10]; c.ca=argv[6]; c.version=argv[7];
+        s.server=true; s.cert=argv[4]; s.key=argv[5]; s.version=c.version;
+        std::mutex mutex; std::condition_variable cv;
+        int ready=0; bool go=false; Clock::time_point start; std::clock_t cpu_start=0;
+        std::vector<Result> results(threads); std::vector<std::thread> workers;
+        auto arrive=[&]() { std::unique_lock<std::mutex> lock(mutex); ++ready; cv.notify_all(); cv.wait(lock,[&]{return go;}); };
+        // Even initialization failures reach the barrier, so no worker hangs.
+        try {
+            for (int id=0; id<threads; ++id) workers.emplace_back([&,id] {
+                bool arrived=false;
+                try {
+                    pin_worker(id);
+                    auto library=Library::local();
+                    auto cc=std::make_shared<Context>(c)->clone_for_worker(library);
+                    auto sc=std::make_shared<Context>(s)->clone_for_worker(library);
+#if defined(TREX_TLS_BENCH_SECURITY_LEVEL) && !defined(OPENSSL_IS_AWSLC)
+                    check(SSL_CTX_get_security_level(cc->ctx)==TREX_TLS_BENCH_SECURITY_LEVEL &&
+                          SSL_CTX_get_security_level(sc->ctx)==TREX_TLS_BENCH_SECURITY_LEVEL,
+                          "unexpected TLS security level");
+#endif
+                    check(std::string(argv[9])=="full","AWS-LC benchmark supports full exchanges only");
+                    auto operation=[&]() { transaction(cc,sc,bytes); };
+
+                    check(SSL_CTX_set_cipher_list(cc->ctx,"ECDHE-RSA-AES256-GCM-SHA384")==1 &&
+                          SSL_CTX_set_cipher_list(sc->ctx,"ECDHE-RSA-AES256-GCM-SHA384")==1,"TLS 1.2 cipher pin");
+                    check(SSL_CTX_set_ciphersuites(cc->ctx,"TLS_AES_256_GCM_SHA384")==1 &&
+                          SSL_CTX_set_ciphersuites(sc->ctx,"TLS_AES_256_GCM_SHA384")==1,"cipher pin");
+                    check(SSL_CTX_set1_groups_list(cc->ctx,"X25519")==1 &&
+                          SSL_CTX_set1_groups_list(sc->ctx,"X25519")==1,"group pin");
+                    check(SSL_CTX_set1_sigalgs_list(cc->ctx,"rsa_pss_rsae_sha256")==1 &&
+                          SSL_CTX_set1_sigalgs_list(sc->ctx,"rsa_pss_rsae_sha256")==1,"signature pin");
+                    for (int i=0;i<10;++i) operation();
+                    astf_cost::Metrics metrics;
+                    astf_cost::Binding binding(&metrics);
+                    arrived=true; arrive();
+                    do { operation(); ++results[id].completed; }
+                    while (std::chrono::duration<double>(Clock::now()-start).count()<seconds);
+                    results[id].seconds=std::chrono::duration<double>(Clock::now()-start).count();
+                    std::ostringstream out;out<<"{\"metrics\":{";bool comma=false;
+                    for (unsigned m=0;m<astf_cost::COUNT;++m) {
+                        auto v=metrics.snapshot(static_cast<astf_cost::Metric>(m));if (!v.calls) continue;
+                        if(comma) { out<<","; }
+                        comma=true;
+                        out<<"\""<<astf_cost::name(m)<<"\":{\"calls\":"<<v.calls<<",\"samples\":"<<v.samples<<",\"sampled_ns\":"<<v.sampled_ns;
+                        if (m>=astf_cost::HS_STATE_BASE) out<<",\"entry_state\":\""<<metrics.state_label(m-astf_cost::HS_STATE_BASE)<<"\"";
+                        out<<"}";
+                    }
+                    out<<"},\"negotiated\":[";
+                    for(unsigned side=0;side<2;++side) {
+                        if(side)out<<",";
+                        astf_cost::Negotiation n;uint64_t count=0,diff=0;metrics.negotiation(side,n,count,diff);
+                        out<<"{\"version\":"<<n.version<<",\"cipher\":"<<n.cipher<<",\"group_id\":"<<n.group<<",\"signature_digest_nid\":"<<n.signature<<",\"signature_type_nid\":"<<n.signature_type<<",\"group_name\":\""<<n.group_name<<"\""<<",\"completed\":"<<count<<",\"different\":"<<diff<<"}";
+                    }
+                    out<<"]}";results[id].cost=out.str();
+                } catch (const std::exception &e) {
+                    results[id].error=e.what();
+                    if (!arrived) arrive();
+                }
+            });
+        } catch (...) {
+            { std::lock_guard<std::mutex> lock(mutex); start=Clock::now(); go=true; }
+            cv.notify_all(); for(auto &t:workers)t.join(); throw;
+        }
+        { std::unique_lock<std::mutex> lock(mutex); cv.wait(lock,[&]{return ready==threads;}); cpu_start=std::clock(); start=Clock::now(); go=true; }
+        cv.notify_all(); for(auto &t:workers)t.join();
+        double cpu_seconds=double(std::clock()-cpu_start)/CLOCKS_PER_SEC;
+        uint64_t count=0; double elapsed=0; unsigned failures=0;
+        for(const auto &r:results) {
+            count+=r.completed; elapsed=std::max(elapsed,r.seconds);
+            if(!r.error.empty()) { ++failures; std::cerr<<r.error<<'\n'; }
+        }
+        std::cout<<"{\"completed\":"<<count<<",\"seconds\":"<<elapsed
+                 <<",\"cpu_seconds\":"<<cpu_seconds<<",\"cpu_us_per_connection\":"<<(count ? cpu_seconds*1e6/count:0)
+                 <<",\"cps\":"<<(elapsed ? count/elapsed:0)<<",\"failed_workers\":"<<failures
+                 <<",\"response_bytes\":"<<bytes<<",\"openssl\":\""<<OpenSSL_version(OPENSSL_VERSION)<<"\",\"workers\":[";
+        for(size_t i=0;i<results.size();++i) {
+            if(i)std::cout<<",";
+            std::cout<<"{\"completed\":"<<results[i].completed<<",\"seconds\":"<<results[i].seconds<<",\"cost\":"<<(results[i].cost.empty()?"null":results[i].cost)<<"}";
+        }
+        std::cout<<"]}\n";
+        return failures ? 1:0;
+    } catch(const std::exception &e) { std::cerr<<e.what()<<'\n'; return 1; }
+}
