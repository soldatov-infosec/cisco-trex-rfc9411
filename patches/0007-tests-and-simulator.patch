+++ b/tests/tls/run_interop.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""Independent GnuTLS endpoints, loopback only; not part of TRex runtime."""
+import os
+import pathlib
+import select
+import shlex
+import shutil
+import socket
+import subprocess as sp
+import tempfile
+import time
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+
+def run(args, **kw):
+    return sp.run(args, check=True, timeout=60, **kw)
+
+def stop(process):
+    if process.poll() is None:
+        process.terminate()
+        try:
+            process.wait(timeout=3)
+        except sp.TimeoutExpired:
+            process.kill()
+            process.wait()
+
+def main():
+    for tool in ('gnutls-cli', 'gnutls-serv', 'openssl'):
+        if not shutil.which(tool):
+            raise SystemExit('Required test dependency: ' + tool)
+    with tempfile.TemporaryDirectory() as directory:
+        tmp = pathlib.Path(directory)
+        binary = str(tmp / 'peer')
+        command = shlex.split(os.environ.get('CXX', 'c++'))
+        command += ['-std=c++11', '-DTREX_TLS', '-Wall', '-Wextra', '-Werror', '-Isrc']
+        command += shlex.split(os.environ.get('CXXFLAGS', ''))
+        command += ['tests/tls/interop_peer.cpp', 'src/44bsd/tls/astf_tls.cpp']
+        command += shlex.split(os.environ.get('LDFLAGS', ''))
+        run(command + ['-lssl', '-lcrypto', '-o', binary], cwd=ROOT)
+        # Independent roots -> intermediate CAs -> RSA/ECDSA server leaves.
+        for algorithm in ('rsa', 'ec'):
+            def generate(name, subject, root=False):
+                key = str(tmp / (name+'.key'))
+                out = str(tmp / (name+('.pem' if root else '.csr')))
+                args = ['openssl', 'req', '-newkey']
+                args += ['rsa:2048'] if algorithm=='rsa' else ['ec', '-pkeyopt', 'ec_paramgen_curve:P-256']
+                if root:
+                    args += ['-x509', '-days', '1', '-addext', 'basicConstraints=critical,CA:TRUE']
+                run(args + ['-nodes', '-keyout', key, '-out', out, '-subj', subject],
+                    stdout=sp.DEVNULL, stderr=sp.DEVNULL)
+                return key, out
+            ca_key, ca = generate(algorithm+'-ca', '/CN=Test Root '+algorithm, True)
+            int_key, csr = generate(algorithm+'-int', '/CN=Test Intermediate '+algorithm)
+            extension = tmp / 'extensions.cnf'
+            extension.write_text('basicConstraints=critical,CA:TRUE,pathlen:0\n'
+                                 'keyUsage=critical,keyCertSign,cRLSign\n')
+            intermediate = str(tmp / (algorithm+'-int.pem'))
+            run(['openssl', 'x509', '-req', '-in', csr, '-CA', ca, '-CAkey', ca_key,
+                 '-set_serial', '2', '-days', '1', '-extfile', str(extension), '-out', intermediate],
+                stdout=sp.DEVNULL, stderr=sp.DEVNULL)
+            key, csr = generate(algorithm, '/CN=localhost')
+            extension.write_text('basicConstraints=critical,CA:FALSE\n'
+                                 'keyUsage=critical,digitalSignature,keyEncipherment\n'
+                                 'extendedKeyUsage=serverAuth\nsubjectAltName=DNS:localhost\n')
+            leaf = str(tmp / (algorithm+'-leaf.pem'))
+            run(['openssl', 'x509', '-req', '-in', csr, '-CA', intermediate, '-CAkey', int_key,
+                 '-set_serial', '3', '-days', '1', '-extfile', str(extension), '-out', leaf],
+                stdout=sp.DEVNULL, stderr=sp.DEVNULL)
+            (tmp / (algorithm+'.pem')).write_bytes(pathlib.Path(leaf).read_bytes() +
+                                                   pathlib.Path(intermediate).read_bytes())
+        for version in ('1.2', '1.3'):
+            priority = 'NORMAL:-VERS-ALL:+VERS-TLS' + version
+            for algorithm in ('rsa', 'ec'):
+                cert, key = str(tmp / (algorithm+'.pem')), str(tmp / (algorithm+'.key'))
+                ca = str(tmp / (algorithm+'-ca.pem'))
+                peer = sp.Popen([binary, 'server', version, cert, key, ca, '0', 'accept'],
+                                stdout=sp.PIPE, stderr=sp.PIPE, text=True)
+                try:
+                    if not select.select([peer.stdout], [], [], 15)[0]:
+                        raise RuntimeError('native server startup timeout')
+                    line = peer.stdout.readline().strip()
+                    if not line.startswith('LISTEN '):
+                        raise RuntimeError(line + peer.stderr.read())
+                    port = line.split()[1]
+                    with tempfile.TemporaryFile() as output:
+                        client = sp.Popen(['gnutls-cli', '--priority', priority, '--x509cafile', ca,
+                                           '--verify-hostname', 'localhost', '--sni-hostname', 'localhost',
+                                           '--alpn', 'http/1.1', '-p', port, '127.0.0.1'],
+                                          stdin=sp.PIPE, stdout=output, stderr=output)
+                        try:
+                            client.stdin.write(b'GET / HTTP/1.1\r\nHost: localhost\r\n\r\n')
+                            client.stdin.flush()  # keep stdin open until server close_notify
+                            code = client.wait(timeout=15)
+                            output.seek(0)
+                            result = output.read()
+                            assert code==0 and b'TLS-OK!' in result, result
+                        finally:
+                            stop(client)
+                            client.stdin.close()
+                    out, err = peer.communicate(timeout=15)
+                    assert peer.returncode==0 and 'EXCHANGE OK' in out, out+err
+                finally:
+                    stop(peer)
+                print(version, algorithm, 'native server / GnuTLS client OK', flush=True)
+                # gnutls-serv does not expose an inherited listener; reserve a local port.
+                with socket.socket() as sock:
+                    sock.bind(('127.0.0.1', 0))
+                    port = str(sock.getsockname()[1])
+                with tempfile.TemporaryFile() as log:
+                    server = sp.Popen(['gnutls-serv', '--http', '--priority', priority,
+                                       '--x509certfile', cert, '--x509keyfile', key, '-p', port],
+                                      stdout=log, stderr=log)
+                    try:
+                        deadline = time.monotonic()+10
+                        while True:
+                            try:
+                                with socket.create_connection(('127.0.0.1', int(port)), timeout=.1):
+                                    break
+                            except OSError:
+                                if server.poll() is not None or time.monotonic()>deadline:
+                                    log.seek(0)
+                                    raise RuntimeError(log.read().decode(errors='replace'))
+                                time.sleep(.05)
+                        run([binary, 'client', version, cert, key, ca, port, 'accept'])
+                        other = str(tmp / ('ec-ca.pem' if algorithm=='rsa' else 'rsa-ca.pem'))
+                        run([binary, 'client', version, cert, key, other, port, 'reject'])
+                    finally:
+                        stop(server)
+                print(version, algorithm, 'native client / GnuTLS server + untrusted CA rejection OK', flush=True)
+
+if __name__=='__main__':
+    main()
