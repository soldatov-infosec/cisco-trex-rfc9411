+            auto &s=sim.m_s_ctx.get_tcpstat()->m_sts;
+            EXPECT_TRUE(fault.injected>0);
+            if(mode==TlsWireFault::OVERLAP || mode==TlsWireFault::ZERO_WINDOW) {
+                EXPECT_EQ_UINT32(1,sim.m_c_ctx.get_appstat()->m_sts.user_counter_A);
+                EXPECT_EQ_UINT32(1,sim.m_s_ctx.get_appstat()->m_sts.user_counter_A);
+                EXPECT_EQ_UINT32(262144,s.tcps_tls_rcvbyte);
