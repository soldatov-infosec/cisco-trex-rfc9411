+#!/bin/sh
+# Run after building linux/bp-sim-64-debug with --rfc9411.
+set -eu
+cd "$(dirname "$0")/../../scripts"
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+openssl req -x509 -newkey rsa:2048 -nodes -keyout "$tmp/key.pem" -out "$tmp/cert.pem" -days 1 -subj /CN=localhost -addext subjectAltName=DNS:localhost >/dev/null 2>&1
+for version in 1.2 1.3; do
+    for auth in certificate psk; do
+        for protocol in http1 h2; do
+            extra=""
+            if [ "$auth" = psk ]; then extra="--psk 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"; fi
+            if [ "$protocol" = h2 ]; then extra="$extra --h2"; fi
+            # Deliberate word splitting: extra contains only constants above.
+            if ./astf-sim -v -f astf/https_native.py -o "$tmp/traffic" -t --version "$version" --cert "$tmp/cert.pem" --key "$tmp/key.pem" --ca "$tmp/cert.pem" $extra > "$tmp/log" 2>&1; then
+                if [ "$auth" = psk ]; then
+                    echo 'AWS-LC unexpectedly accepted an external PSK profile' >&2; exit 1
+                fi
+            else
+                if [ "$auth" = psk ] &&
+                   grep -q 'external PSK profile' "$tmp/log"; then
+                    echo "$version $auth $protocol rejected as expected"; continue
+                fi
+                cat "$tmp/log"; exit 1
+            fi
+            python3 - "$tmp/log" <<'PY'
+import re, sys
+text = open(sys.argv[1]).read()
+if not re.search(r'user_counter_A\s*\|\s*1\s*\|\s*1\s*\|', text):
+    print(text)
+    raise SystemExit('Both ASTF endpoints must finish application commands')
+PY
+            echo "$version $auth $protocol OK"
+        done
+    done
+done
