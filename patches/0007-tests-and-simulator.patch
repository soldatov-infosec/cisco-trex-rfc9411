+#ifdef TREX_TLS
+int CClientServerTcp::cleartext_http2() {
+    return http2_transport("",120000);
+}
+int CClientServerTcp::http2_transport(const std::string &version,uint32_t timeout_ms,uint32_t body_size) {
+    return simple_http_generic([&version,timeout_ms,body_size](CMbufBuffer *,CMbufBuffer *,CEmulAppProgram *c,CEmulAppProgram *s,uint32_t) {
+        for(auto p:{c,s}) {
+            p->m_http2.enabled=true;p->m_http2.secure=!version.empty();
+            p->m_http2.server=p==s;p->m_http2.requests=12;
+            p->m_http2.concurrency=4;p->m_http2.body_size=body_size;
+            // 50-ms RTT, MSS 256 and repeated loss/reordering need a longer session budget.
+            p->m_http2.timeout_ms=timeout_ms;
+            if(!version.empty()) {
+                astf_tls::Config config;config.version=version;config.alpn="h2";
+                config.server=p==s;
+                const char *cert=std::getenv("TREX_TLS_TEST_CERT"),*key=std::getenv("TREX_TLS_TEST_KEY");
+                if(!cert || !key)throw std::runtime_error("HTTP/2 TLS tests require certificate/key");
+                if(config.server) {config.cert=cert;config.key=key;}
+                else {config.ca=cert;config.sni="localhost";}
+                p->m_tls_context=std::make_shared<astf_tls::Context>(config);
+            }
+            CEmulAppCmd cmd;cmd.m_cmd=tcHTTP2;p->add_cmd(cmd);
+        }
+        return 0;
+    });
+}
+#endif
