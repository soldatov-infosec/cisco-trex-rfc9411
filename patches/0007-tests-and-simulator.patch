+class TlsCloseStall : public CTxRxCallback {
+public:
+    CClientServerTcp &sim;
+    explicit TlsCloseStall(CClientServerTcp &s):sim(s) {}
+    int on_rx(int, rte_mbuf_t *) override { return 0; }
+    int on_tx(int dir, rte_mbuf_t *m) override {
+        if (dir==1 && sim.m_s_ctx.get_tcpstat()->m_sts.tcps_tls_sndbyte) {
+            auto ip=reinterpret_cast<IPHeader *>(rte_pktmbuf_mtod(m,uint8_t *)+14);
+            auto tcp=reinterpret_cast<TCPHeader *>(ip->getPointer()+ip->getHeaderLength());
+            tcp->setWindowSize(0);
+            TlsWireFault::checksum(m);
+        }
+        return 0;
+    }
+};
