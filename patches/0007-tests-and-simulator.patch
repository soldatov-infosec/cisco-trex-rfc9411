+"""Run with scripts/automation/trex_control_plane/interactive on PYTHONPATH."""
+import unittest
+from trex.astf.trex_astf_profile import ASTFProgram, ASTFError
+
+
+class TLSAPI(unittest.TestCase):
+    def test_old_profile_unchanged(self):
+        p = ASTFProgram()
+        p.send(b'hello')
+        self.assertNotIn('tls', p.to_json())
+
+    def test_roles_and_copy(self):
+        options = {'version': '1.2', 'psk_identity': 'test', 'psk_hex': 'ab' * 32}
+        c, s = ASTFProgram(tls=options), ASTFProgram(side='s', tls=options)
+        c.send(b'hello')
+        s.recv(5)
+        options['version'] = 'invalid'
+        self.assertFalse(c.to_json()['tls']['server'])
+        self.assertTrue(s.to_json()['tls']['server'])
+        self.assertEqual(c.to_json()['tls']['version'], '1.2')
+        self.assertNotEqual(c.calc_hash(), s.calc_hash())
+
+    def test_resumption(self):
+        p = ASTFProgram(tls={'resumption': True, 'session_timeout': 120})
+        p.send(b'hello')
+        self.assertTrue(p.to_json()['tls']['resumption'])
+        self.assertEqual(p.to_json()['tls']['session_timeout'], 120)
+        for options in ({'resumption': 1}, {'session_timeout': True},
+                        {'session_timeout': 0}, {'session_timeout': 86401},
+                        {'session_timeout': '300'},
+                        {'resumption': True, 'psk_hex': 'ab' * 32}):
+            with self.assertRaises(ASTFError):
+                ASTFProgram(tls=options)
+
+    def test_deadlines(self):
+        p = ASTFProgram(tls={'handshake_timeout_ms': 50, 'close_timeout_ms': 100})
+        p.send(b'hello')
+        self.assertEqual(p.to_json()['tls']['handshake_timeout_ms'], 50)
+        for name in ('handshake_timeout_ms', 'close_timeout_ms'):
+            for value in (0, -1, 600001, True, '50'):
+                with self.assertRaises(ASTFError):
+                    ASTFProgram(tls={name: value})
+
+    def test_v5_policy(self):
+        options = {'version': '1.2', 'cipher_suite': 'ECDHE-ECDSA-AES128-GCM-SHA256',
+                   'groups': ['P-256'], 'signature_algorithms': ['ecdsa_secp256r1_sha256']}
+        p = ASTFProgram(tls=options)
+        options['groups'].append('P-384')
+        self.assertEqual(p.to_json()['tls']['groups'], ['P-256'])
+        p.to_json()['tls']['groups'].append('X25519')
+        self.assertEqual(p.to_json()['tls']['groups'], ['P-256'])
+        for bad in ({'groups': []}, {'groups': ['P-256', 'P-256']}, {'groups': ['bogus']},
+                    {'signature_algorithms': ['RSA+SHA1']}, {'cipher_suite': 'ALL'},
+                    {'require_client_cert': True}, {'require_client_cert': 1}):
+            with self.assertRaises(ASTFError): ASTFProgram(tls=bad)
+        ASTFProgram(side='s',tls={'require_client_cert':True,'ca':'ca.pem','cert':'s.pem','key':'s.key'})
+        for extra in ({'verify':False},{'ca':''}):
+            opts={'require_client_cert':True,'ca':'ca.pem','cert':'s.pem','key':'s.key'}
+            opts.update(extra)
+            with self.assertRaises(ASTFError): ASTFProgram(side='s',tls=opts)
+
+    def test_http(self):
+        opts={'responses':10}
+        p=ASTFProgram(tls={},http=opts)
+        opts['responses']=20
+        self.assertEqual(p.to_json()['http']['responses'],10)
+        self.assertNotEqual(p.calc_hash(),ASTFProgram(tls={}).calc_hash())
+        for kwargs in ({'http':{},'stream':False},{'http':{},'side':'s'}, {'http':{},'addon':'x'}, {'tls':{},'side':'s','http':{}},
+                       {'tls':{'alpn':'h2'},'http':{}},{'tls':{},'http':{'responses':True}},
+                       {'tls':{},'http':{'responses':0}},{'tls':{},'http':{'expected_status':100}},
+                       {'tls':{},'http':{'extra':1}}):
+            with self.assertRaises(ASTFError): ASTFProgram(**kwargs)
+
+    def test_plain_http(self):
+        import io
+        p=ASTFProgram(http={'responses':2})
+        p.send(b'GET / HTTP/1.1\r\nHost: example\r\n\r\n')
+        self.assertNotIn('tls',p.to_json())
+        self.assertEqual(p.to_json()['http'],{'responses':2})
+        out=io.StringIO(); p.dump(out,'p')
+        self.assertIn("http={'responses': 2}",out.getvalue())
+
+    def test_v51(self):
+        p=ASTFProgram(http={'body_contains':'hello','transactions':True})
+        p.http_request_start(); p.send(b'GET / HTTP/1.1\r\n\r\n')
+        self.assertEqual([x['name'] for x in p.to_json()['commands']],['http_request','tx'])
+        for options in ({'body_contains':''},{'body_contains':'a'*4097},{'body_contains':True},{'transactions':1}):
+            with self.assertRaises(ASTFError): ASTFProgram(http=options)
+        with self.assertRaises(ASTFError): ASTFProgram(http={}).http_request_start()
+
+    def test_bad_options(self):
+        for kwargs in ({'tls': True}, {'tls': {}, 'stream': False},
+                       {'tls': {'version': 'SSLv3'}}, {'tls': {'alpn': 'h3'}},
+                       {'tls': {'verify': 'false'}}, {'tls': {'typo': 1}},
+                       {'tls': {}, 'addon': 'anything'}):
+            with self.assertRaises(ASTFError):
+                ASTFProgram(**kwargs)
+
+
+if __name__ == '__main__':
+    unittest.main()
