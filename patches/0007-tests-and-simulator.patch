+TEST_F(gt_astf_inter, tls_profile_reload) {
+    auto profile = tls_reload_profile();
+    CFlowGenList flows;
+    flows.Create();
+    flows.generate_p_thread_info(1);
+    auto thread = flows.m_threads_info[0];
+    const profile_id_t id = 0x12345678;
+    for (int iteration = 0; iteration != 32; ++iteration) {
+        for (auto &program : profile["program_list"])
+            program["tls"]["version"] = iteration & 1 ? "1.3" : "1.2";
+        auto db = CAstfDB::get_instance(id);
+        db->Create();
+        Json::FastWriter writer;
+        std::string error;
+        ASSERT_TRUE(db->set_profile_one_msg(writer.write(profile), error)) << error;
+        thread->load_tcp_profile(id, true, db);
+        auto ro = db->get_db_ro(0);
+        std::weak_ptr<astf_tls::Context> client = ro->get_client_prog(0)->m_tls_context;
+        auto server_info = ro->get_server_info_by_port(ro->get_dport(0));
+        ASSERT_TRUE(server_info != nullptr);
+        std::weak_ptr<astf_tls::Context> server = server_info->get_prog()->m_tls_context;
+        auto wc = thread->m_c_tcp->get_profile_ctx(id)->m_tls_contexts.get(client.lock().get());
+        auto ws = thread->m_s_tcp->get_profile_ctx(id)->m_tls_contexts.get(server.lock().get());
+        EXPECT_NE(wc->ctx, client.lock()->ctx);
+        EXPECT_NE(ws->ctx, server.lock()->ctx);
+        EXPECT_TRUE(wc->library && wc->library == ws->library);
+        std::weak_ptr<astf_tls::Library> runtime = wc->library;
+        std::weak_ptr<astf_tls::Context> worker_client = wc, worker_server = ws;
+        std::unique_ptr<astf_tls::Flow> retained_worker(new astf_tls::Flow(wc));
+        wc.reset(); ws.reset();
+        std::unique_ptr<astf_tls::Flow> retained(new astf_tls::Flow(client.lock()));
+        thread->unload_tcp_profile(id, true, db);
+        CAstfDB::free_instance(id);
+        EXPECT_TRUE(server.expired());
+        EXPECT_TRUE(worker_server.expired());
+        EXPECT_FALSE(worker_client.expired());
+        EXPECT_FALSE(runtime.expired());
+        retained_worker.reset();
+        EXPECT_TRUE(worker_client.expired());
+        EXPECT_TRUE(runtime.expired());
+        EXPECT_FALSE(client.expired()); // SSL owns its context until flow destruction.
+        retained.reset();
+        EXPECT_TRUE(client.expired());
+    }
+    flows.clean_p_thread_info();
+    flows.Delete();
+}
