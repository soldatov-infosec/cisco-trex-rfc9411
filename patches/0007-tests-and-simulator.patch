+// Deterministic wall-clock tests: no sleeps, crypto timing or NIC dependency.
+TEST(astf_scheduler, transient_work_does_not_move_deadlines) {
+    auto simulate = [](bool recovery, uint64_t &stretches) {
+        CAstfScheduler policy;
+        double now=0, offset=0;
+        for (unsigned i=0;i<10000;++i) {
+            double due=i*0.0001+offset;
+            double lag=now-due;
+            if (policy.should_stretch(now,lag,0.0001,recovery)) {
+                offset+=lag; due+=lag;
+            }
+            if (now<due) { policy.waited(due-now); now=due; }
+            // Average work is below offered capacity, with periodic long events.
+            now+= i%100==0 ? 0.0006 : 0.00003;
+        }
+        auto stats=policy.snapshot(); stretches=stats[CAstfScheduler::STRETCHES];
+        if (recovery) {
+            EXPECT_GT(stats[CAstfScheduler::RECOVERED], 90u);
+            EXPECT_GT(stats[CAstfScheduler::WAIT_US], 0u);
+        }
+        return offset;
+    };
+    uint64_t stretches=0;
+    EXPECT_DOUBLE_EQ(0.0, simulate(true,stretches));
+    EXPECT_EQ(0u,stretches);
+    EXPECT_GT(simulate(false,stretches),0.04);
+    EXPECT_GT(stretches,90u);
+}
