+                print(f'{op}: threads={n}, repeat={r}, shift={shift}, ops/s={row["result"]["cps"]}',flush=True)
+            meta['status']='completed'
+    except BaseException as exc:
+        meta['status']='failed';meta['error']=str(exc);raise
+    finally:
+        save()
+        (out/'README.txt').write_text('Text-only diagnostics; no private key, packet payload or perf.data included.\n'
+            'Compare loaded libssl/libcrypto paths with NIC capture server/maps.txt; CLI openssl version is not sufficient.\n'
+            'Full handshake includes Flow lifecycle, memory-BIO transfer and orderly shutdown, no application payload.\n'
+            'No NIC, packet scheduling or TCP costs in this benchmark. No primitive decomposition is performed.\n')
+        groups={}
+        for row in meta['runs']:
+            if row['returncode'] or 'result' not in row:
+                continue
+            groups.setdefault((row['operation'],row['threads'],row['shift']),[]).append(row['result'])
+        lines=['operation workers shift repeats median_ops_per_s median_elapsed_worker_us_per_op',
+               '# Elapsed worker time includes loop overhead/preemption, not hardware CPU time.']
+        for (op,n,shift),runs in sorted(groups.items()):
+            rates=[x['cps'] for x in runs]
+            costs=[sum(w['seconds'] for w in x['workers'])*1e6/x['completed'] for x in runs if x['completed']]
+            lines.append(f'{op} {n} {shift} {len(runs)} {statistics.median(rates):.3f} {statistics.median(costs):.3f}')
+        (out/'summary.txt').write_text('\n'.join(lines)+'\n')
+        with zipfile.ZipFile(archive,'x',zipfile.ZIP_DEFLATED) as z:
+            for f in sorted(out.iterdir()):
+                if f.is_file():z.write(f,out.name+'/'+f.name)
+        print('Text results:',archive,flush=True)
+
+if __name__=='__main__':
+    main()
