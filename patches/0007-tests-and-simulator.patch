@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Run against compiled handshake_bench: binary cert key ca."""
+import json
+import os
+import subprocess
+import sys
+binary,cert,key,ca=sys.argv[1:]
+for version in ('1.2','1.3'):
+    for shift in ('0','8','off'):
+        result=json.loads(subprocess.check_output([binary,'libctx','2','.04',cert,key,ca,version,'0','full','localhost'],
+            env=dict(os.environ,TREX_ASTF_COST_SHIFT=shift),text=True))
+        assert result['failed_workers']==0 and result['completed']>0
+        for worker in result['workers']:
+            cost=worker['cost'];m=cost['metrics'];n=worker['completed']
+            if shift=='off':
+                assert not m
+                assert all(x['completed']==0 for x in cost['negotiated'])
+                continue
+            for i,side in enumerate(('client','server')):
+                assert m['flow_create_'+side]['calls']==m['flow_free_'+side]['calls']==n
+                total=m['handshake_ssl_'+side]['calls']
+                assert sum(v['calls'] for k,v in m.items() if k.startswith('handshake_state_'+side+'_'))==total
+                assert m['handshake_result_'+side]['calls']==total
+                assert m['handshake_post_'+side]['calls']==total
+                value=cost['negotiated'][i]
+                assert value['version']==(771 if version=='1.2' else 772)
+                assert value['completed']==n and value['different']==0
+                assert value['cipher']>0 and value['group_id']>0 and value['group_name']
+                if side == 'client':
+                    assert value['signature_type_nid']>0 and value['signature_digest_nid']>0
+                else:
+                    assert value['signature_type_nid']==value['signature_digest_nid']==0
+            if shift=='0':
+                assert all(v['calls']==v['samples'] for v in m.values())
+            assert not any(k in m for k in ('library_enter','library_leave','handshake_scope_client','handshake_scope_server'))
+bad=subprocess.run([binary,'libctx','2','.01',cert,key,ca,'1.3','0','full','wrong.invalid'],capture_output=True,text=True,timeout=20)
+assert bad.returncode!=0
+print('TLS 1.2/1.3, off/sampled/exact, per-worker lifecycle/state/negotiation, verification failure: PASS')
