+    program.m_tls_context = std::make_shared<astf_tls::Context>(config);
+    CEmulAppCmd cmd;
+    cmd.m_cmd = tcTX_BUFFER;
+    cmd.u.m_tx_cmd.m_buf = &buffer;
+    program.add_cmd(cmd);
+    program.add_cmd(cmd); // Repeated sends share a single prepared copy.
+    program.prepare_tls_buffers();
+    ASSERT_EQ(1u, program.m_tls_plaintext.size());
+    EXPECT_TRUE(payload == program.m_tls_plaintext.at(&buffer));
+    // Failure to rebuild must leave the previously prepared data intact.
+    auto length = buffer.m_vec[0].m_mbuf->pkt_len;
+    buffer.m_vec[0].m_mbuf->pkt_len = 0;
+    EXPECT_THROW(program.prepare_tls_buffers(), std::runtime_error);
+    EXPECT_TRUE(payload == program.m_tls_plaintext.at(&buffer));
+    buffer.m_vec[0].m_mbuf->pkt_len = length;
+    buffer.Delete();
+}
