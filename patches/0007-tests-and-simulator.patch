+TEST(astf_scheduler, bounded_recovery_and_explicit_override) {
+    CAstfScheduler policy;
+    EXPECT_FALSE(policy.should_stretch(1.0,0.0005,0.0001,true));
+    // Even constant small debt must not start an endless recovery episode.
+    EXPECT_TRUE(policy.should_stretch(1.011,0.0005,0.0001,true));
+    EXPECT_TRUE(policy.should_stretch(2.0,0.011,0.0001,true));
+    // Existing explicit override semantics are retained.
+    EXPECT_FALSE(policy.should_stretch(3.0,0.009,0.010,false));
+    EXPECT_TRUE(policy.should_stretch(3.0,0.011,0.010,false));
+    auto stats=policy.snapshot();
+    EXPECT_EQ(3u,stats[CAstfScheduler::STRETCHES]);
+    EXPECT_GE(stats[CAstfScheduler::STRETCH_US],22498u);
+    policy.begin(); // preserve cumulative counters across scheduler invocations
+    EXPECT_EQ(stats[CAstfScheduler::STRETCHES],policy.snapshot()[CAstfScheduler::STRETCHES]);
+}
