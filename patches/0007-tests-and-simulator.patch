+class TlsLateEmptyAck : public TlsWireFault {
+public:
+    int direction;
+    TlsLateEmptyAck(CClientServerTcp &s,int d):TlsWireFault(s,OVERLAP),direction(d) {}
+    int on_tx(int dir,rte_mbuf_t *m) override {
+        if(injected || dir!=direction || !sim.m_c_ctx.get_tcpstat()->m_sts.tcps_tls_sndbyte)return 0;
+        auto bytes=rte_pktmbuf_mtod(m,uint8_t *);
+        auto ip=reinterpret_cast<IPHeader *>(bytes+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(bytes+14+ip->getHeaderLength());
+        unsigned len=ip->getTotalLength()-ip->getHeaderLength()-tcp->getHeaderLength();
+        if(len || tcp->getFlags()!=TCPHeader::Flag::ACK)return 0;
+        ++injected;
+        deliver(copy(m),dir,sim.m_sim.get_time()+0.00045);
+        return 0;
+    }
+};
