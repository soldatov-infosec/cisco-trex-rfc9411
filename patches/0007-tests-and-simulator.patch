+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <cassert>
+#include <cstring>
+#include <thread>
+#include <iostream>
+using namespace astf_tls;
+static void move(Flow &a,Flow &b,size_t fragment=65536) {
+    const uint8_t *p=nullptr;size_t n=std::min(a.peek(&p),fragment);
+    if(n) a.consume(b.feed(p,n));
+}
+static void connect(Flow &c,Flow &s) {
+    for(unsigned i=0;i<200000;++i) {
+        if(!c.ready()) c.handshake();
+        if(!s.ready()) s.handshake();
+        move(c,s,19);move(s,c,19);
+        assert(!c.failed()&&!s.failed());
+        if(c.ready()&&s.ready()&&!c.pending()&&!s.pending()) return;
+    }
+    assert(false);
+}
+static void progress(const char *version,const char *cert,const char *key,bool automatic) {
+    Config c,s;c.sni="localhost";c.ca=cert;c.version=s.version=version;
+    s.server=true;s.cert=cert;s.key=key;
+    auto library=Library::local();
+    auto cc=std::make_shared<Context>(c)->clone_for_worker(library);
+    auto sc=std::make_shared<Context>(s)->clone_for_worker(library);
+    if(!automatic) { SSL_CTX_clear_mode(cc->ctx,SSL_MODE_AUTO_RETRY);SSL_CTX_set_read_ahead(cc->ctx,1); }
+    Config tiny=c;tiny.bio_capacity=128;
+    auto tiny_ctx=std::make_shared<Context>(tiny)->clone_for_worker(library);
+    for(bool drain:{false,true}) {
+        Flow blocked(tiny_ctx);char byte;
+        assert(blocked.read(&byte,1)==0 && !blocked.read_can_progress());
+        assert(blocked.pending()==128); // implicit ClientHello is blocked on BIO output
+        blocked.consume(0);assert(!blocked.read_can_progress());
+        if(drain) assert(blocked.drain(&byte,1)==1);
+        else blocked.consume(1);
+        assert(blocked.read_can_progress());
+    }
+    for(bool drain:{false,true}) {
+        Flow blocked(tiny_ctx);char byte;
+        assert(!blocked.handshake() && !blocked.handshake_can_progress());
+        assert(blocked.pending()==128);
+        blocked.consume(0);assert(!blocked.handshake_can_progress());
+        if(drain) assert(blocked.drain(&byte,1)==1);else blocked.consume(1);
+        assert(blocked.handshake_can_progress());
+    }
+    {
+        Flow waiting(sc);assert(!waiting.handshake() && !waiting.handshake_can_progress());
+        waiting.eof();assert(waiting.handshake_can_progress());waiting.handshake();assert(waiting.failed());
+    }
+    Flow client(cc),server(sc);connect(client,server);
+    char data[32];assert(client.read(data,sizeof(data))==0);
+    assert(!client.read_can_progress());
+    for(int i=0;i<1000;++i) assert(client.read(data,sizeof(data))==0);
+    assert(server.write("first",5)==5);assert(server.write("second",6)==6);
+    move(server,client,1);assert(client.read_can_progress());
+    assert(client.read(data,sizeof(data))==0); // incomplete TLS header
+    move(server,client);assert(client.read_can_progress());
+    std::string got;
+    for(int i=0;i<100 && got.size()<11;++i) { auto n=client.read(data,2);got.append(data,n); }
+    assert(got=="firstsecond"); // includes plaintext buffered inside SSL
+    assert(client.read(data,sizeof(data))==0 && !client.read_can_progress());
+    assert(client.write("x",1)==1);assert(client.read_can_progress());
+    move(client,server);assert(server.read(data,sizeof(data))==1);
+    assert(client.read(data,sizeof(data))==0 && !client.read_can_progress());
+    server.shutdown();move(server,client,1);client.read(data,sizeof(data));move(server,client);
+    for(int i=0;i<100&&!client.peer_closed();++i) client.read(data,sizeof(data));
+    assert(client.peer_closed()&&!client.failed());
+    client.shutdown();move(client,server);server.read(data,sizeof(data));
+    assert(server.peer_closed());
+    Flow truncated(cc),peer(sc);connect(truncated,peer);
+    assert(truncated.read(data,sizeof(data))==0 && !truncated.read_can_progress());
+    truncated.eof();assert(truncated.read_can_progress());truncated.read(data,sizeof(data));
+    assert(truncated.failed() && truncated.failure()==Failure::TRUNCATED);
+}
+static void reuse(const char *version,const char *cert,const char *key) {
+    Config a,b;a.version=b.version=version;a.sni="localhost";a.ca=cert;
+    b.server=true;b.cert=cert;b.key=key;
+    auto lib=Library::local();
+    auto c=std::make_shared<Context>(a)->clone_for_worker(lib);
+    auto s=std::make_shared<Context>(b)->clone_for_worker(lib);
+    // Overflow the eight-entry worker cache, mix capacity and EOF/dirty data.
+    for(int round=0;round<4;++round) {
+        std::vector<std::unique_ptr<Flow>> dirty;
+        for(int i=0;i<20;++i) {
+            dirty.emplace_back(new Flow(i%2?c:s));
+            dirty.back()->feed("incomplete",10);
+            dirty.back()->eof();
+        }
+        dirty.clear();
+        for(int i=0;i<20;++i) {
+            Flow client(c),server(s);
+            assert(client.handshake_can_progress());
+            client.handshake();
+            assert(!client.handshake_can_progress());
+            for(int j=0;j<100;++j) assert(!client.handshake());
+            connect(client,server);
+            assert(!client.resumed()&&!server.resumed());
+            assert(client.write("fresh",5)==5);move(client,server);
+            char out[8];assert(server.read(out,8)==5 && !std::memcmp(out,"fresh",5));
+            client.eof(); // cache must reopen this transport on next use
+        }
+    }
+}
+int main(int argc,char **argv) {
+    assert(argc==3);
+    for(auto version:{"1.2","1.3"}) for(bool automatic:{false,true}) progress(version,argv[1],argv[2],automatic);
+    for(auto version:{"1.2","1.3"}) reuse(version,argv[1],argv[2]);
+    std::cout<<"BIO cache overflow/dirty EOF reuse, full handshake isolation, worker contexts, WANT_READ wakeup, fragments, buffered plaintext, EOF and close: PASS\n";
+}
