+// Runs in both TLS-enabled and ordinary builds. Use large bodies so losses,
+// reordering and mbuf boundaries exercise the actual HTTP receive adapter.
+int CClientServerTcp::validated_http(unsigned scenario, bool transactions) {
+    return simple_http_generic([this,scenario,transactions](CMbufBuffer *req, CMbufBuffer *res,
+            CEmulAppProgram *c, CEmulAppProgram *s, uint32_t len) {
+        std::string body(16384,'x'), response;
+        if (scenario==1)
+            response="HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4000\r\n"+body+"\r\n0\r\nX-End: yes\r\n\r\n";
+        else if (scenario==4)
+            response="HTTP/1.0 200 OK\r\n\r\n"+body;
+        else {
+            response=std::string("HTTP/1.1 ")+(scenario==2 ? "403 Denied" : "200 OK")+
+                "\r\nContent-Length: 16384\r\n\r\n"+body;
+            if (scenario==3) response.pop_back();
+        }
+        c->m_http.enabled=true;
+        if (scenario==0) {
+            c->m_http.responses=10;
+            std::string one=response;
+            for (unsigned i=1;i<10;++i) response+=one;
+        }
+        res->Delete();
+        utl_mbuf_buffer_create_and_copy(0,res,2048,reinterpret_cast<uint8_t*>(&response[0]),response.size());
+        if (transactions) {
+            c->m_http.transactions=true;
+            c->m_http.body_contains=scenario==6 ? "missing" : "xxx";
+            CEmulAppCmd cmd; cmd.m_cmd=tcHTTP_REQUEST;
+            for (unsigned i=0;i<c->m_http.responses;++i) c->add_cmd(cmd);
+        }
+        build_http(req,res,c,s,response.size());
+        if (scenario==5) s->get_index(1)->m_cmd=tcRESET;
+        return 0;
+    });
+}
