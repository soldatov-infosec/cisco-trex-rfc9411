new file mode 100644
--- /dev/null
+++ b/tests/tls/run_resumption_profiles.sh
@@ -0,0 +1,27 @@
+#!/bin/sh
+# Full ASTF simulator: repeated TCP flows must actually reuse session tickets.
+set -eu
+cd "$(dirname "$0")/../../scripts"
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+openssl req -x509 -newkey rsa:2048 -nodes -keyout "$tmp/key.pem" -out "$tmp/cert.pem" -days 1 -subj /CN=localhost -addext subjectAltName=DNS:localhost >/dev/null 2>&1
+for version in 1.2 1.3; do
+    ./astf-sim -v --full -d 4 -f astf/https_native.py -o "$tmp/traffic" -t --version "$version" --cert "$tmp/cert.pem" --key "$tmp/key.pem" --ca "$tmp/cert.pem" --resumption > "$tmp/log" 2>&1 || { cat "$tmp/log"; exit 1; }
+    python3 - "$tmp/log" <<'PY'
+import re, sys
+text = open(sys.argv[1]).read()
+def counter(name):
+    match = re.search(r'\b' + name + r'\s*\|\s*(\d+)\s*\|\s*(\d+)\s*\|', text)
+    return tuple(map(int, match.groups())) if match else (0, 0)
+handshakes = counter('tcps_tls_handshakes')
+resumed = counter('tcps_tls_resumed')
+if (min(handshakes) < 2 or min(resumed) < 1 or
+        handshakes != counter('user_counter_A') or
+        counter('tcps_tls_resume_attempts')[0] != resumed[0] or
+        counter('tcps_tls_errors') != (0, 0)):
+    print(text)
+    raise SystemExit('Expected successful full and resumed ASTF HTTPS flows')
+print('handshakes=%s resumed=%s' % (handshakes, resumed))
+PY
+    echo "$version ASTF session resumption OK"
+done
