+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/tls/astf_tls.h"
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <thread>
+using namespace astf_tls;
+static void move(Flow &a, Flow &b) {
+    const uint8_t *p;
+    size_t n = std::min<size_t>(a.peek(&p), 37);
+    if (n) a.consume(b.feed(p, n));
+}
+static void connect(Flow &c, Flow &s) {
+    for (unsigned i=0; i<200000; ++i) {
+        c.handshake(); s.handshake();
+        char out;
+        if (c.ready()) assert(c.read(&out,1)==0);
+        if (s.ready()) assert(s.read(&out,1)==0);
+        move(c,s); move(s,c);
+        assert(!c.failed() && !s.failed());
+        if (c.ready() && s.ready() && !c.pending() && !s.pending() &&
+            !c.input_pending() && !s.input_pending()) return;
+    }
+    assert(false && "handshake/ticket stalled");
+}
+static void close(Flow &c, Flow &s) {
+    for (unsigned i=0; i<10000; ++i) {
+        c.shutdown(); s.shutdown(); move(c,s); move(s,c);
+        char out;
+        assert(c.read(&out,1)==0 && s.read(&out,1)==0);
+        assert(!c.failed() && !s.failed());
+        if (c.sent_close() && s.sent_close() && c.peer_closed() && s.peer_closed()) return;
+    }
+    assert(false && "close stalled");
+}
+static void application(Flow &c, Flow &s) {
+    bool sent=false;
+    for (unsigned i=0; i<10000; ++i) {
+        if (!sent) sent=c.write("https",5)==5;
+        move(c,s); move(s,c);
+        char out[5];
+        auto n=s.read(out,sizeof(out));
+        assert(!c.failed() && !s.failed());
+        if (n) { assert(n==5 && std::string(out,n)=="https"); return; }
+    }
+    assert(false && "application stalled");
+}
+static void run(std::shared_ptr<Context> cc, std::shared_ptr<Context> sc,
+                bool offered, bool resumed) {
+    Flow c(cc), s(sc);
+    assert(c.resume_attempted()==offered);
+    connect(c,s);
+    assert(c.resumed()==resumed && s.resumed()==resumed);
+    application(c,s); application(s,c); close(c,s);
+    assert(SSL_CTX_sess_number(cc->ctx)==0 && SSL_CTX_sess_number(sc->ctx)==0);
+}
+int main(int argc, char **argv) {
+    assert(argc==3);
+    for (auto version : {"1.2","1.3"}) for (auto capacity : {128u,65536u}) for (bool mtls : {false,true}) {
+        Config c,s;
+        c.version=s.version=version; c.bio_capacity=s.bio_capacity=capacity;
+        c.resumption=s.resumption=true;
+        c.sni="localhost"; c.ca=argv[1]; s.cert=argv[1]; s.key=argv[2]; s.server=true;
+        if (mtls) { c.cert=argv[1]; c.key=argv[2]; s.ca=argv[1]; s.require_client_cert=true; }
+        auto cc=std::make_shared<Context>(c), sc=std::make_shared<Context>(s);
+        run(cc,sc,false,false);
+        for (int i=0; i<16; ++i) run(cc,sc,true,true);
+        // A new server context has a different ticket key/namespace: fall back.
+        sc=std::make_shared<Context>(s);
+        run(cc,sc,true,false);
+        run(cc,sc,true,true);
+        // Deterministic expiration without sleeping or changing the system clock.
+        auto expired=cc->take_session(); assert(expired);
+#if OPENSSL_VERSION_NUMBER >= 0x30400000L
+        SSL_SESSION_set_time_ex(expired,1);
+#else
+        SSL_SESSION_set_time(expired,1);
+#endif
+        cc->cache_session(expired);
+        run(cc,sc,false,false);
+        // Aborted flows consume their ticket without publishing replacements.
+        { Flow client(cc),server(sc); connect(client,server); }
+        run(cc,sc,false,false);
+        // Adapter cancellation after SSL close, before TCP flush, must veto caching.
+        { Flow client(cc),server(sc); connect(client,server); close(client,server); client.discard_session(); }
+        run(cc,sc,false,false);
+        // Cache capacity, eviction and single-use ownership.
+        auto seed=cc->take_session(); assert(seed);
+        for (int i=0;i<80;++i) {
+#ifdef OPENSSL_IS_AWSLC
+            assert(SSL_SESSION_up_ref(seed)); auto copy=seed;
+#else
+            auto copy=SSL_SESSION_dup(seed);
+#endif
+            assert(copy); cc->cache_session(copy);
+        }
+        SSL_SESSION_free(seed);
+        unsigned count=0;
+        while (auto session=cc->take_session()) { ++count; SSL_SESSION_free(session); }
+        assert(count==32);
+        // Independent SSL instances share a context across DP-like threads.
+        std::vector<std::thread> threads;
+        for (int i=0;i<4;++i) threads.emplace_back([cc,sc]() {
+            for (int n=0;n<8;++n) {
+                Flow client(cc),server(sc); connect(client,server);
+                application(client,server); close(client,server);
+            }
+        });
+        for (auto &thread : threads) thread.join();
+        // Server-side name rejection must not leave a usable ticket behind.
+        Config wrong=c; wrong.sni="wrong.invalid";
+        auto bad=std::make_shared<Context>(wrong);
+        {
+            Flow client(bad),server(sc);
+            for (unsigned i=0;i<200000 && !client.failed() && !server.failed();++i) {
+                client.handshake(); server.handshake(); move(client,server); move(server,client);
+            }
+            assert(server.failed() && !server.ready() && !client.ready());
+        }
+        assert(!bad->take_session());
+        c.resumption=s.resumption=false;
+        cc=std::make_shared<Context>(c); sc=std::make_shared<Context>(s);
+        run(cc,sc,false,false); run(cc,sc,false,false);
+        std::cout << version << " BIO=" << capacity << " mTLS=" << mtls << " resumption OK\n";
+    }
+}
