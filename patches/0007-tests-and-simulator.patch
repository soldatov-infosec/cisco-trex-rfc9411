+#!/bin/sh
+# CXXFLAGS/LDFLAGS must select the same AWS-LC installation as TRex.
+set -eu
+cd "$(dirname "$0")/../.."
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+openssl ecparam -name prime256v1 -genkey -noout -out "$tmp/key.pem"
+make_cert() {
+    name=$1; cn=$2; san=$3
+    if [ -n "$san" ]; then
+        openssl req -new -x509 -key "$tmp/key.pem" -sha256 -days 1 \
+            -subj "/CN=$cn" -addext "subjectAltName=$san" -out "$tmp/$name.pem"
+    else
+        openssl req -new -x509 -key "$tmp/key.pem" -sha256 -days 1 \
+            -subj "/CN=$cn" -out "$tmp/$name.pem"
+    fi
+}
+make_cert san cn-only.example.test DNS:localhost,DNS:alias.example.test
+make_cert wildcard unused.invalid 'DNS:*.example.test'
+make_cert partial unused.invalid 'DNS:w*.example.test'
+make_cert cn legacy.example.test ''
+${CXX:-c++} -std=c++11 -DTREX_TLS -Wall -Wextra -Werror ${CXXFLAGS:-} -Isrc \
+    tests/tls/server_sni_test.cpp src/44bsd/tls/astf_tls.cpp \
+    ${LDFLAGS:-} -lssl -lcrypto -pthread -o "$tmp/test"
+"$tmp/test" "$tmp"
