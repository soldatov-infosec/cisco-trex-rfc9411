+#include "../../src/astf/astf_cost_metrics.h"
+#include <cstdio>
+#include <cstdlib>
+volatile uint64_t sink = 0;
+int main() {
+    const unsigned count=1000000;
+    for (const char *mode : {"off", "8", "0"}) {
+        setenv("TREX_ASTF_COST_SHIFT", mode, 1);
+        astf_cost::Metrics stats;
+        astf_cost::Binding binding(&stats);
+        auto start=std::chrono::steady_clock::now();
+        for (unsigned i=0;i<count;++i) {
+            astf_cost::Probe probe(astf_cost::WRITE_C);
+            sink+=i; probe.bytes(64);
+        }
+        auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now()-start).count();
+        auto s=stats.snapshot(astf_cost::WRITE_C);
+        std::printf("mode=%s elapsed_ns_per_probe=%.2f calls=%llu samples=%llu\n", mode,
+            double(ns)/count, (unsigned long long)s.calls, (unsigned long long)s.samples);
+    }
+}
diff --git a/tests/tls/cost_metrics_test.cpp b/tests/tls/cost_metrics_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/cost_metrics_test.cpp
@@ -0,0 +1,42 @@
+#include "../../src/astf/astf_cost_metrics.h"
+#include <cassert>
+#include <thread>
+#include <cstdlib>
+using namespace astf_cost;
+int main() {
+    setenv("TREX_ASTF_COST_SHIFT", "off", 1);
+    Metrics off;
+    { Binding b(&off); Probe p(WRITE_C); p.bytes(100); }
+    assert(off.snapshot(WRITE_C).calls == 0);
+    setenv("TREX_ASTF_COST_SHIFT", "invalid", 1);
+    Metrics invalid; assert(!invalid.enabled() && !invalid.config_valid());
+    setenv("TREX_ASTF_COST_SHIFT", "0", 1);
+    Metrics exact;
+    { Binding b(&exact);
+      { Probe p(WRITE_C); p.bytes(37); }
+      try { Probe p(FLOW_CREATE_C); throw 1; } catch (...) {}
+      { Binding nested(&off); Probe p(WRITE_C); }
+      { Probe p(WRITE_C); p.bytes(5); }
+    }
+    { Probe p(WRITE_C); } // no binding, nothing recorded
+    auto v = exact.snapshot(WRITE_C);
+    assert(v.calls == 2 && v.samples == 2 && v.bytes == 42);
+    uint64_t bins=0; for (auto n:v.histogram) bins+=n;
+    assert(bins==v.samples && v.sampled_ns >= v.max_sampled_ns);
+    assert(exact.snapshot(FLOW_CREATE_C).calls == 1);
+    setenv("TREX_ASTF_COST_SHIFT", "8", 1);
+    Metrics sparse;
+    // Concurrent CP-style reader: only atomic snapshots, single writer.
+    std::atomic<bool> done{false};
+    std::thread reader([&] { uint64_t previous=0;
+        while (!done.load()) { auto n=sparse.snapshot(READ_C).calls; assert(n>=previous); previous=n; }
+    });
+    { Binding b(&sparse); for (unsigned i=0;i<1000000;++i) { Probe p(READ_C); p.bytes(1); } }
+    done.store(true); reader.join();
+    auto s=sparse.snapshot(READ_C);
+    assert(s.calls==1000000 && s.bytes==1000000);
+    assert(s.samples>2500 && s.samples<5500);
+    // Independent thread binding must not inherit the main thread's owner.
+    { Binding b(&exact); std::thread t([] { Probe p(WRITE_C); }); t.join(); }
+    assert(exact.snapshot(WRITE_C).calls==2);
+}
