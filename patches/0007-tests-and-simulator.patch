+        if (dir == 0 && sim.m_c_ctx.get_appstat()->m_sts.user_counter_B &&
+            sim.m_s_ctx.get_tcpstat()->m_sts.tcps_tls_rcvbyte <
+                8192 * sim.m_c_ctx.get_appstat()->m_sts.user_counter_B) {
