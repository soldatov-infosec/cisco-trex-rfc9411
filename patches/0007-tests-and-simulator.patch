+    client=ASTFClient();client.connect();client.acquire(force=True);pid='h2_'+uuid.uuid4().hex[:8]
+    try:
+        for concurrency,size,status,version in [(1,0,200,'clear'),(4,16384,200,'clear'),(8,100000,200,'clear'),(1,100,404,'clear'),(1,0,0,'clear'),(1,0,200,'1.2'),(4,16384,200,'1.3'),(8,100000,200,'1.3'),(1,100,404,'1.3'),(1,0,0,'1.3')]:
+            client.load_profile(profile(a,concurrency,size,status,version),pid_input=pid)
