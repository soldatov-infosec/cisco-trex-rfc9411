+++ b/tests/tls/http2_interop.py
@@ -0,0 +1,75 @@
+"""Independent python-h2 peer for the native protocol engine; no network needed."""
+import subprocess,sys
+from h2.connection import H2Connection
+from h2.config import H2Configuration
+from h2.events import RequestReceived,DataReceived,StreamEnded,ConnectionTerminated,ResponseReceived
+
+def run(native_server,secure=True):
+    p=subprocess.Popen([sys.argv[1],'server' if native_server else 'client','tls' if secure else 'clear'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True)
+    h=H2Connection(config=H2Configuration(client_side=native_server,header_encoding='utf-8'))
+    h.initiate_connection();sent=completed=0;pending={};received={};goaway=False
+    def submit():
+        nonlocal sent
+        while sent<12 and sent-completed<4:
+            stream=h.get_next_available_stream_id()
+            h.send_headers(stream,[(':method','GET'),(':scheme','https' if secure else 'http'),(':authority','localhost'),(':path','/')],end_stream=True)
+            received[stream]=0;sent+=1
+    if native_server:submit()
+    try:
+        for _ in range(10000):
+            p.stdin.write(h.data_to_send().hex()+'\n');p.stdin.flush()
+            line=p.stdout.readline();assert line,'native engine exited'
+            wire,finished,failed=line.strip().split('|');assert failed=='0',line
+            for e in h.receive_data(bytes.fromhex(wire)):
+                if isinstance(e,RequestReceived):
+                    assert not native_server
+                    assert dict(e.headers)[':scheme']==('https' if secure else 'http')
+                    h.send_headers(e.stream_id,[(':status','200'),('content-length','100000')])
+                    pending[e.stream_id]=0
+                elif isinstance(e,ResponseReceived):assert dict(e.headers)[':status']=='200'
+                elif isinstance(e,DataReceived):
+                    received[e.stream_id]+=len(e.data)
+                    h.acknowledge_received_data(e.flow_controlled_length,e.stream_id)
+                elif isinstance(e,StreamEnded) and native_server:
+                    assert received[e.stream_id]==100000
+                    completed+=1
+                elif isinstance(e,ConnectionTerminated):goaway=True
+            if native_server and not goaway:
+                submit()
+                if completed==12:h.close_connection();goaway=True
+            elif not native_server and not goaway:
+                for stream in list(pending):
+                    while pending[stream]<100000:
+                        n=min(h.local_flow_control_window(stream),h.max_outbound_frame_size,100000-pending[stream])
+                        if n<=0:break
+                        pending[stream]+=n
+                        h.send_data(stream,b'x'*n,end_stream=pending[stream]==100000)
+                    if pending[stream]==100000:del pending[stream];completed+=1
+            if finished=='1':
+                assert completed==12,completed
+                print('python-h2 interop PASS: native '+('server' if native_server else 'client'))
+                break
+        else:raise AssertionError('HTTP/2 progress timeout')
+    finally:p.stdin.close();p.wait(timeout=5)
+run(True);run(False);run(True,False);run(False,False)
+
+def reject_response(reset):
+    p=subprocess.Popen([sys.argv[1],'client'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True)
+    h=H2Connection(config=H2Configuration(client_side=False))
+    h.initiate_connection()
+    try:
+        for _ in range(20):
+            p.stdin.write(h.data_to_send().hex()+'\n');p.stdin.flush()
+            wire,finished,failed=p.stdout.readline().strip().split('|')
+            if failed=='1':
+                print('python-h2 invalid response PASS:', 'RST_STREAM' if reset else 'Content-Length mismatch')
+                break
+            for e in h.receive_data(bytes.fromhex(wire)):
+                if isinstance(e,RequestReceived):
+                    if reset:h.reset_stream(e.stream_id,error_code=8)
+                    else:
+                        h.send_headers(e.stream_id,[(':status','200'),('content-length','100')])
+                        h.send_data(e.stream_id,b'x',end_stream=True)
+        else:raise AssertionError('Invalid response was accepted')
+    finally:p.stdin.close();p.wait(timeout=5)
+reject_response(False);reject_response(True)
