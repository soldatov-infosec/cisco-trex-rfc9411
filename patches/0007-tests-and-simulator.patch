+// Inspect the actual adapter's TCP wire, not just the TLS engine's BIO.
+class TlsFatalAlertWire : public CTxRxCallback {
+public:
+    unsigned mode,received=0;bool exhausted=false;
+    explicit TlsFatalAlertWire(unsigned m):mode(m) {}
+    int on_tx(int dir,rte_mbuf_t *m) override {
+        if(mode==1 && dir==0) {
+            auto ip=reinterpret_cast<IPHeader *>(rte_pktmbuf_mtod(m,uint8_t *)+14);
+            auto tcp=reinterpret_cast<TCPHeader *>(ip->getPointer()+ip->getHeaderLength());
+            tcp->setWindowSize(0);TlsWireFault::checksum(m);
+        }
+        return 0;
+    }
+    int on_rx(int dir,rte_mbuf_t *m) override {
+        auto ip=reinterpret_cast<IPHeader *>(rte_pktmbuf_mtod(m,uint8_t *)+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(ip->getPointer()+ip->getHeaderLength());
+        unsigned len=ip->getTotalLength()-ip->getHeaderLength()-tcp->getHeaderLength();
+        auto payload=tcp->getPointer()+tcp->getHeaderLength();
+        if(dir==0 && len==7 && payload[0]==21 && payload[5]==2 &&
+           payload[6]==SSL_AD_UNRECOGNIZED_NAME) ++received;
+        if(mode==2 && dir==1 && len && !exhausted) {
+            exhausted=true;CEmulApp::tls_test_allocations(0);
+        }
+        return 0;
+    }
+};
+TEST_F(gt_tcp, native_tls_fatal_alert_wire) {
+    struct Reset {~Reset(){CEmulApp::tls_test_allocations(-1);}} reset;
+    for(auto version:{"1.2","1.3"}) for(unsigned mode=0;mode<3;++mode) {
+        SCOPED_TRACE(::testing::Message()<<version<<" alert mode="<<mode);
+        CClientServerTcp sim;sim.Create("generated","tls_fatal_alert");
+        sim.m_mss=256;sim.m_check_counters=false;sim.set_rtt(100);
+        TlsFatalAlertWire wire(mode);sim.m_callbacks.push_back(&wire);
+        sim.m_sim.add_event(new CTcpSimEventStop(1.0));
+        sim.simple_tls(version,65536,512,CClientServerTcp::TLS_SNI_MISMATCH);
+        const auto &c=sim.m_c_ctx.get_tcpstat()->m_sts;
+        const auto &s=sim.m_s_ctx.get_tcpstat()->m_sts;
+        EXPECT_EQ_UINT32(1,s.tcps_tls_errors);
+        EXPECT_EQ_UINT32(0,c.tcps_tls_handshakes+s.tcps_tls_handshakes);
+        EXPECT_EQ_UINT32(0,c.tcps_tls_sndbyte+s.tcps_tls_sndbyte);
+        EXPECT_EQ_UINT32(0,c.tcps_tls_timeouts+s.tcps_tls_timeouts);
+        EXPECT_EQ_UINT32(1,s.tcps_closed);
+        EXPECT_EQ_UINT32(1,c.tcps_closed);
+        printf("fatal alert TLS %s mode=%u received=%u close_timeout=%llu no_mbuf=%llu\n",
+            version,mode,wire.received,(unsigned long long)s.tcps_tls_close_timeouts,
+            (unsigned long long)s.tcps_nombuf);
+        if(mode==0) {
+            EXPECT_EQ_UINT32(1,wire.received);
+            EXPECT_EQ_UINT32(1,c.tcps_tls_errors);
+            EXPECT_EQ_UINT32(1,c.tcps_tls_err_protocol);
+            EXPECT_EQ_UINT32(0,c.tcps_tls_err_verify);
+            EXPECT_EQ_UINT32(0,c.tcps_tls_err_transport+c.tcps_tls_err_truncated);
+            EXPECT_EQ_UINT32(0,s.tcps_tls_close_timeouts);
+        } else if(mode==1) {
+            EXPECT_EQ_UINT32(1,s.tcps_tls_close_timeouts);
+        } else {
+            EXPECT_TRUE(wire.exhausted);
+            EXPECT_EQ_UINT32(0,wire.received);
+            EXPECT_GT(s.tcps_nombuf,0u);
+            EXPECT_EQ_UINT32(0,s.tcps_tls_close_timeouts);
+        }
+        CEmulApp::tls_test_allocations(-1);
+        sim.m_callbacks.clear();sim.close_file();sim.Delete();
+    }
+}
