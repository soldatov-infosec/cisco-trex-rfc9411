+                EXPECT_EQ_UINT32(1,sim.m_s_ctx.get_appstat()->m_sts.user_counter_A);
+                EXPECT_EQ_UINT32(0,c.tcps_tls_errors);
+            } else if (scenario==CClientServerTcp::TLS_HANDSHAKE_TIMEOUT) {
