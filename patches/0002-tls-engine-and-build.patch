+++ b/linux_dpdk/astf_tls_build.py
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: Apache-2.0
+"""AWS-LC validation for simulator and DPDK Waf builds."""
+import os
+
+
+def configure(conf):
+    for name in ('INCLUDES', 'LIBPATH', 'RPATH', 'LIB', 'LINKFLAGS'):
+        conf.env[name + '_ASTF_TLS'] = []
+    backend = getattr(conf.options, 'tls_backend', 'aws-lc')
+    if backend != 'aws-lc':
+        conf.fatal('Native ASTF TLS supports only AWS-LC')
+    prefix = getattr(conf.options, 'aws_lc_prefix', None)
+    if not prefix:
+        conf.fatal('Native ASTF TLS needs --aws-lc-prefix')
+    settings = {}
+    if prefix:
+        prefix = os.path.realpath(os.path.abspath(os.path.expanduser(prefix)))
+        include = os.path.join(prefix, 'include')
+        if not os.path.isfile(os.path.join(include, 'openssl', 'ssl.h')):
+            conf.fatal('AWS-LC prefix has no include/openssl/ssl.h: ' + prefix)
+        # Require both libraries in the same directory; never silently mix a
+        # partial custom installation with a system libssl or libcrypto.
+        candidates = [os.path.join(prefix, name) for name in ('lib64', 'lib')]
+        libraries = next((path for path in candidates if all(
+            os.path.isfile(os.path.join(path, 'lib' + name + '.so'))
+            for name in ('ssl', 'crypto'))), None)
+        if libraries is None:
+            conf.fatal('AWS-LC prefix needs shared libssl.so and libcrypto.so in lib64 or lib')
+        settings = dict(includes=[include], libpath=[libraries], rpath=[libraries])
+        conf.msg('ASTF TLS prefix', prefix)
+    # uselib_store carries headers, libraries, search path and RUNPATH together.
+    # In particular, the program tasks must actually use ASTF_TLS afterwards.
+    fragment = '''
+#include <openssl/ssl.h>
+#include <openssl/crypto.h>
+#include <cstring>
+#include <openssl/service_indicator.h>
+#ifndef OPENSSL_IS_AWSLC
+#error AWS-LC headers required
+#endif
+int main() {
+    if (std::strcmp(awslc_version_string(), "AWS-LC " AWSLC_VERSION_NUMBER_STRING)) return 1;
+    SSL_CTX *ctx = SSL_CTX_new(TLS_method());
+    if (!ctx) return 2;
+    SSL_CTX_free(ctx);
+    return 0;
+}
+'''
+    conf.check_cxx(fragment=fragment, lib=['ssl', 'crypto'],
+                   uselib_store='ASTF_TLS', mandatory=True, execute=True,
+                   msg='Checking ' + backend + ' headers, linkage and runtime version', **settings)
+
+    conf.check_cxx(fragment='#include <nghttp2/nghttp2.h>\nint main(){nghttp2_option *o=0;nghttp2_option_new(&o);nghttp2_option_set_max_continuations(o,8);nghttp2_option_del(o);}',
+                   lib=['nghttp2'], uselib_store='ASTF_HTTP2', mandatory=True,
+                   msg='Checking libnghttp2 with HTTP/2 continuation limits')
