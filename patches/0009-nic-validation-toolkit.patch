+"""NIC validation: full TLS handshake, validated HTTP/1, native HTTP/2, UDP RTT."""
+import argparse
+from trex.astf.api import *
+
+CASES = ('tls12', 'tls13', 'h2', 'h2tls12', 'h2tls13', 'udp')
+
+class Profile:
+    def get_profile(self, tunables, **kwargs):
+        p = argparse.ArgumentParser(description=__doc__)
+        p.add_argument('--case', choices=CASES, required=True)
+        p.add_argument('--cert'); p.add_argument('--key'); p.add_argument('--ca')
+        p.add_argument('--sni', default='trex.local')
+        p.add_argument('--requests', type=int, default=10)
+        p.add_argument('--body-size', type=int, default=16384)
+        p.add_argument('--concurrency', type=int, default=4)
+        p.add_argument('--frame-size', type=int, choices=(64, 570, 1518), default=570)
+        a = p.parse_args(tunables)
+        if not 1 <= a.requests <= 1000 or not 0 <= a.body_size <= 1048576:
+            p.error('invalid requests/body-size')
+        if not 1 <= a.concurrency <= 128:
+            p.error('concurrency must be 1..128')
+        encrypted = a.case not in ('h2', 'udp')
+        if encrypted and not all((a.cert, a.key, a.ca)):
+            p.error('TLS requires --cert, --key and --ca')
+        ct = st = None
+        if encrypted:
+            version = '1.2' if a.case.endswith('12') else '1.3'
+            policy = dict(version=version, resumption=False, groups=['X25519','P-256'],
+                          signature_algorithms=['ecdsa_secp256r1_sha256'],
+                          cipher_suite='ECDHE-ECDSA-AES128-GCM-SHA256' if version=='1.2' else 'TLS_AES_128_GCM_SHA256',
+                          alpn='h2' if a.case.startswith('h2') else 'http/1.1')
+            ct = dict(policy, ca=a.ca, sni=a.sni, verify=True)
+            st = dict(policy, cert=a.cert, key=a.key)
+        if a.case == 'udp':
+            c = ASTFProgram(stream=False); s = ASTFProgram(stream=False)
+            # Frame size includes Ethernet FCS; no artificial server delay.
+            req = b'x' * (a.frame_size-46); resp = b'y' * (a.frame_size-46)
+            for _ in range(a.requests):
+                c.udp_request(req, timeout_ms=1000)
+                s.recv_msg(1); s.send_msg(resp)
+            port = 53
+        elif a.case.startswith('h2'):
+            c = ASTFProgram(tls=ct, http2=dict(authority=a.sni, requests=a.requests,
+                concurrency=a.concurrency, timeout_ms=30000))
+            s = ASTFProgram(side='s', tls=st, http2=dict(body_size=a.body_size,
+                concurrency=a.concurrency, timeout_ms=30000))
+            port = 443 if encrypted else 80
+        else:
+            c = ASTFProgram(tls=ct, http=dict(responses=a.requests, expected_status=200, transactions=True))
+            s = ASTFProgram(side='s', tls=st)
+            req = ('GET / HTTP/1.1\r\nHost: '+a.sni+'\r\n\r\n').encode('ascii')
+            resp = ('HTTP/1.1 200 OK\r\nContent-Length: %d\r\n\r\n' % a.body_size).encode('ascii')+b'x'*a.body_size
+            c.set_var('n', a.requests); c.set_label('request')
+            c.http_request_start(); c.send(req); c.recv(len(resp)); c.jmp_nz('n','request')
+            s.set_var('n', a.requests); s.set_label('response')
+            s.recv(len(req)); s.send(resp); s.jmp_nz('n','response'); s.wait_for_peer_close()
+            port = 443
+        ip = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset='1.0.0.0'),
+            dist_client=ASTFIPGenDist(ip_range=['16.0.0.1','16.0.255.199'] if a.case=='udp' else ['16.0.0.1','16.0.255.199'], distribution='rand'),
+            dist_server=ASTFIPGenDist(ip_range=['48.0.0.1','48.1.255.199'], distribution='rand'))
+        g = ASTFGlobalInfo()
+        if a.case != 'udp':
+            g.tcp.mss = 1440; g.tcp.rxbufsize = 1048576; g.tcp.txbufsize = 1048576
+        template = ASTFTemplate(client_template=ASTFTCPClientTemplate(program=c, ip_gen=ip, port=port, cps=1),
+            server_template=ASTFTCPServerTemplate(program=s, assoc=ASTFAssociationRule(port=port)), tg_name=a.case)
+        return ASTFProfile(default_ip_gen=ip, default_c_glob_info=g, default_s_glob_info=g, templates=template)
+
+def register():
+    return Profile()
