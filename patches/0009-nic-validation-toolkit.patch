+"""Read-only Linux diagnostics, standard library only. Never invokes perf.
+
+Raw /proc counters are cumulative: use timestamped deltas. Scheduler counters
+come separately from the TRex RPC collector. No keys, environment or packet
+payloads are read. Missing permissions/tools are recorded, not fatal.
+"""
+import datetime
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import subprocess
+import threading
+import time
+
+
+def read(path):
+    try:
+        return Path(path).read_text(errors='replace').replace('\0', ' ')
+    except OSError as exc:
+        return {'unavailable': str(exc)}
+
+
+def identity(proc):
+    try:
+        return (proc / 'stat').read_text().rsplit(')', 1)[1].split()[19]
+    except (OSError, IndexError):
+        return None
+
+
+class Capture:
+    def __init__(self, output, server, requested_pid=None, interval=5):
+        if server not in ('localhost', '127.0.0.1', '::1'):
+            raise ValueError('Run this script on the TRex server for local diagnostics; '
+                             'or use --no-server-diagnostics for RPC metrics only')
+        candidates = []
+        for proc in Path('/proc').glob('[0-9]*'):
+            try:
+                exe = Path(os.readlink(str(proc / 'exe'))).name
+                names = [exe]
+                if exe == 'rosetta' or exe.startswith('qemu-'):
+                    names += [Path(v).name for v in (proc / 'cmdline').read_text().split('\0')[:3]]
+                if any(re.fullmatch(r'_?t-rex-64(?:-debug)?(?:-o)?', n) for n in names):
+                    candidates.append(int(proc.name))
+            except OSError:
+                pass
+        if requested_pid is not None:
+            if requested_pid not in candidates:
+                raise ValueError('--trex-pid does not identify a local TRex executable')
+            candidates = [requested_pid]
+        if len(candidates) != 1:
+            raise ValueError('Expected one local TRex process, found %s; use --trex-pid' % candidates)
+        self.pid = candidates[0]
+        self.proc = Path('/proc') / str(self.pid)
+        self.identity = identity(self.proc)
+        if self.identity is None:
+            raise ValueError('TRex process disappeared')
+        self.out = Path(output) / 'server'
+        self.out.mkdir()
+        self.interval = interval
+        self.stop = threading.Event()
+        self.thread = None
+        self.origin = time.monotonic()
+        self.events = []
+        self.samples = 0
+        self.devices = []
+        self.interfaces = []
+        self.cpus = list(Path('/sys/devices/system/cpu').glob('cpu[0-9]*'))
+        self.save()
+
+    def save(self):
+        (self.out / 'capture.json').write_text(json.dumps(dict(
+            pid=self.pid, interval_s=self.interval, samples=self.samples,
+            events=self.events, clock_ticks=os.sysconf('SC_CLK_TCK'),
+            page_size=os.sysconf('SC_PAGE_SIZE')), indent=2) + '\n')
+
+    def command(self, name, argv, timeout=3):
+        event = dict(name=name, argv=argv)
+        self.events.append(event)
+        try:
+            with (self.out / (name + '.txt')).open('w') as log:
+                p = subprocess.Popen(argv, stdout=log, stderr=subprocess.STDOUT,
+                                     start_new_session=True, env=dict(os.environ, LC_ALL='C'))
+                try:
+                    p.wait(timeout=timeout)
+                except subprocess.TimeoutExpired:
+                    event['timeout'] = True
+                    try:
+                        os.killpg(p.pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                    p.wait()
+                event['returncode'] = p.returncode
+        except OSError as exc:
+            event['unavailable'] = str(exc)
+        self.save()
+
+    def prepare(self):
+        (self.out / 'executable.txt').write_text(os.readlink(str(self.proc / 'exe')) + '\n')
+        self.command('executable-sha256', ['sha256sum', str(self.proc / 'exe')], timeout=10)
+        for name in ('cmdline', 'status', 'limits', 'maps', 'numa_maps', 'cgroup'):
+            (self.out / (name + '.txt')).write_text(json.dumps(read(self.proc / name), ensure_ascii=False) + '\n')
+        raw = (self.proc / 'cmdline').read_bytes().decode(errors='replace').split('\0')
+        cfg = '/etc/trex_cfg.yaml'
+        for i, arg in enumerate(raw):
+            if arg == '--cfg' and i + 1 < len(raw):
+                cfg = raw[i + 1]
+            elif arg.startswith('--cfg='):
+                cfg = arg.split('=', 1)[1]
+        path = Path(cfg)
+        if not path.is_absolute():
+            path = self.proc / 'cwd' / path
+        config = read(path)
+        (self.out / 'trex_cfg.txt').write_text(config if isinstance(config, str) else json.dumps(config))
+        for name, argv in [('kernel', ['uname', '-a']), ('lscpu', ['lscpu']),
+                           ('topology', ['lscpu', '-e']), ('numa', ['numactl', '--hardware']),
+                           ('openssl', ['openssl', 'version', '-a']),
+                           ('pci', ['lspci', '-Dnnk'])]:
+            self.command(name, argv)
+        # Only devices named in this TRex configuration, not every host NIC.
+        if isinstance(config, str):
+            for match in re.findall(r'(?<![\w:])(?:[0-9a-fA-F]{4}:)?[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7](?![\w:])', config):
+                bdf = match.lower() if match.count(':') == 2 else '0000:' + match.lower()
+                if bdf not in self.devices:
+                    self.devices.append(bdf)
+        for bdf in self.devices:
+            dev = Path('/sys/bus/pci/devices') / bdf
+            info = {n: read(dev / n) for n in ('numa_node', 'local_cpulist', 'current_link_speed',
+                    'current_link_width', 'max_link_speed', 'max_link_width')}
+            info['driver'] = os.path.realpath(str(dev / 'driver'))
+            for irq in (dev / 'msi_irqs').glob('*'):
+                info['irq_' + irq.name] = read(Path('/proc/irq') / irq.name / 'smp_affinity_list')
+            (self.out / ('pci-' + bdf + '.json')).write_text(json.dumps(info, indent=2) + '\n')
+            self.interfaces.extend(p.name for p in (dev / 'net').glob('*'))
+        self.interfaces = sorted(set(self.interfaces))
+        for nic in self.interfaces:
+            for suffix, opts in [('driver', ['-i']), ('channels', ['-l']), ('rss', ['-x']),
+                                 ('offloads', ['-k']), ('rings', ['-g'])]:
+                self.command('nic-' + nic + '-' + suffix, ['ethtool'] + opts + [nic])
+        self.nic_snapshot('before')
+        self.snapshot('baseline')
+
+    def nic_snapshot(self, phase):
+        for nic in self.interfaces:
+            self.command('nic-' + nic + '-stats-' + phase, ['ethtool', '-S', nic])
+        if not self.interfaces:
+            self.events.append({'note': 'No kernel netdev for configured PCI devices; use TRex port metrics. VFIO-bound NICs may have no ethtool interface.'})
+
+    def snapshot(self, phase):
+        if identity(self.proc) != self.identity:
+            raise RuntimeError('TRex exited or PID was reused; refusing to sample another process')
+        begin = time.monotonic()
+        record = dict(phase=phase, utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                      monotonic_s=begin, elapsed_s=begin-self.origin,
+                      host={}, process={}, threads={}, cpus={}, numa={}, nic={})
+        for name in ('stat', 'meminfo', 'vmstat', 'loadavg', 'interrupts', 'softirqs',
+                     'net/softnet_stat', 'net/dev', 'pressure/cpu', 'pressure/memory', 'pressure/io'):
+            record['host'][name] = read(Path('/proc') / name)
+        # Page-table walks can disturb a poll-mode dataplane. Capture them
+        # only before traffic starts and after it has drained. Periodic polls
+        # retain cheap process/status RSS and fault/scheduler counters.
+        if phase != 'poll':
+            record['process']['numa_maps'] = read(self.proc / 'numa_maps')
+            record['process']['smaps_rollup'] = read(self.proc / 'smaps_rollup')
+        for name in ('stat', 'status', 'io', 'schedstat'):
+            record['process'][name] = read(self.proc / name)
+        for task in (self.proc / 'task').glob('[0-9]*'):
+            record['threads'][task.name] = {n: read(task / n) for n in ('comm', 'stat', 'status', 'schedstat')}
+        for cpu in self.cpus:
+            values = {n: read(cpu / 'cpufreq' / n) for n in ('scaling_cur_freq', 'scaling_governor')}
+            values['core_throttle_count'] = read(cpu / 'thermal_throttle/core_throttle_count')
+            record['cpus'][cpu.name] = values
+        for node in Path('/sys/devices/system/node').glob('node[0-9]*'):
+            record['numa'][node.name] = {n: read(node / n) for n in ('numastat', 'meminfo')}
+        for nic in self.interfaces:
+            record['nic'][nic] = {p.name: read(p) for p in (Path('/sys/class/net') / nic / 'statistics').glob('*')}
+        record['collection_s'] = time.monotonic()-begin
+        with (self.out / 'samples.jsonl').open('a') as f:
+            f.write(json.dumps(record, ensure_ascii=False) + '\n')
+        self.samples += 1
+
+    def start(self, origin):
+        self.origin = origin
+        self.thread = threading.Thread(target=self.worker, name='https-server-metrics', daemon=True)
+        self.thread.start()
+
+    def worker(self):
+        try:
+            while not self.stop.is_set():
+                begin = time.monotonic()
+                self.snapshot('poll')
+                self.stop.wait(max(0, self.interval-(time.monotonic()-begin)))
+        except Exception as exc:
+            self.events.append({'error': repr(exc)})
+
+    def finish(self):
+        self.stop.set()
+        if self.thread:
+            self.thread.join()
+        try:
+            self.snapshot('final')
+            if identity(self.proc) == self.identity:
+                (self.out / 'numa_maps-after.txt').write_text(str(read(self.proc / 'numa_maps')))
+                self.nic_snapshot('after')
+        except Exception as exc:
+            self.events.append({'error': repr(exc)})
+        self.save()
+        return 'collected; see server/capture.json for unavailable metrics/errors'
