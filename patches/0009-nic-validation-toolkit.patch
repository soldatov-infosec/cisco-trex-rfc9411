+#!/usr/bin/env python3
+"""Run an ASTF profile and record every get_stats leaf, including zero counters."""
+import argparse
+import csv
+import datetime
+import hashlib
+import json
+from pathlib import Path
+import sys
+import time
+import uuid
+import zipfile
+
+
+def ensure_trex_api():
+    """Locate source-tree or packaged-client API without depending on cwd."""
+    import importlib.util
+    import os
+    try:
+        if importlib.util.find_spec('trex.astf.api') is not None:
+            return
+    except (ModuleNotFoundError, ValueError):
+        pass
+    roots = []
+    for origin in (Path(__file__).absolute().parent, Path(__file__).resolve().parent, Path.cwd()):
+        for root in (origin,) + tuple(origin.parents):
+            if root not in roots:
+                roots.append(root)
+    candidates = []
+    if os.environ.get('TREX_API_PATH'):
+        candidates.append(Path(os.environ['TREX_API_PATH']))
+    for root in roots:
+        for relative in ('automation/trex_control_plane/interactive',
+                         'scripts/automation/trex_control_plane/interactive',
+                         'trex_client/interactive', 'interactive', ''):
+            candidate = root / relative
+            if candidate not in candidates:
+                candidates.append(candidate)
+    for candidate in candidates:
+        if (candidate / 'trex/astf/api.py').is_file():
+            sys.path.insert(0, str(candidate))
+            # Discard an unrelated top-level package if discovery imported one.
+            for name in list(sys.modules):
+                if name == 'trex' or name.startswith('trex.'):
+                    del sys.modules[name]
+            importlib.invalidate_caches()
+            return
+    raise RuntimeError('TRex ASTF Python API not found. Expected trex/astf/api.py under '
+                       'automation/trex_control_plane/interactive or trex_client/interactive. '
+                       'Use the Python client from the SAME patched TRex build; '
+                       'do not pip-install an unrelated package named trex. '
+                       'Set TREX_API_PATH to the directory containing trex/ if installed elsewhere. '
+                       'Searched: ' + ', '.join(str(p) for p in candidates))
+
+
+def leaves(value, path=''):
+    if isinstance(value, dict) and value:
+        for key, child in value.items():
+            key = str(key).replace('~', '~0').replace('/', '~1')
+            yield from leaves(child, path + '/' + key)
+    elif isinstance(value, (list, tuple)) and value:
+        for i, child in enumerate(value):
+            yield from leaves(child, path + '/' + str(i))
+    else:
+        yield path, value
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--server', default='localhost')
+    p.add_argument('--profile', default=str(Path(__file__).with_name('nic_profile.py')))
+    p.add_argument('--mult', type=float, default=10000)
+    p.add_argument('--duration', type=float, default=300)
+    p.add_argument('--interval', type=float, default=1)
+    p.add_argument('--sched-max-stretch-ms', type=float, default=None,
+                   help='Scheduler lateness tolerance in milliseconds; unchanged if omitted')
+    p.add_argument('--perf', action='store_true', help='Deprecated alias: text diagnostics only; perf is never executed')
+    p.add_argument('--no-server-diagnostics', action='store_true', help='RPC metrics only (for a remote TRex server)')
+    p.add_argument('--server-interval', type=float, default=5, help='Local Linux metrics sampling interval, seconds (minimum 1)')
+    p.add_argument('--trex-pid', type=int, help='Only needed if multiple local TRex processes exist')
+    p.add_argument('--perf-delay', type=float, default=30, help='Deprecated, ignored: perf is disabled')
+    p.add_argument('--perf-record-seconds', type=int, default=60, help='Deprecated, ignored: perf is disabled')
+    p.add_argument('--perf-stat-seconds', type=int, default=30, help='Deprecated, ignored: perf is disabled')
+    p.add_argument('--output', default='https-diagnostics-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S'), help='New directory; never overwrites existing logs')
+    p.add_argument('--tunables', nargs=argparse.REMAINDER, default=[])
+    a = p.parse_args()
+    import math
+    if any(not math.isfinite(v) or v <= 0 for v in (a.mult, a.duration, a.interval)):
+        p.error('mult, duration and interval must be finite and positive')
+    if a.sched_max_stretch_ms is not None and (not math.isfinite(a.sched_max_stretch_ms) or not 0.1 <= a.sched_max_stretch_ms <= 100):
+        p.error('sched-max-stretch-ms must be in 0.1..100')
+    if not math.isfinite(a.server_interval) or a.server_interval < 1:
+        p.error('server-interval must be finite and at least 1 second')
+    ensure_trex_api()
+    from trex.astf.api import ASTFClient
+    profile = Path(a.profile).resolve()
+    profile_bytes = profile.read_bytes()
+    out = Path(a.output)
+    archive = out.parent / (out.name + '.zip')
+    if archive.exists():
+        p.error('Archive already exists: ' + str(archive))
+    out.mkdir(parents=True, exist_ok=False)
+    pid = 'nic_csv_' + uuid.uuid4().hex[:12]
+    meta = dict(vars(a), profile_id=pid, profile_sha256=hashlib.sha256(profile_bytes).hexdigest(),
+                utc_created=datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                status='initializing', elapsed_origin='before start RPC; includes start RPC latency')
+    meta['collector_version'] = 'nic-validation-v1'
+    meta['collector_sha256'] = {name: hashlib.sha256(Path(__file__).with_name(name).read_bytes()).hexdigest()
+                                for name in ('collect.py', 'server_capture.py', 'nic_profile.py', 'run.py')
+                                if Path(__file__).with_name(name).is_file()}
+    (out / 'profile.py').write_bytes(profile_bytes)
+    def save_meta():
+        (out / 'metadata.json').write_text(json.dumps(meta, indent=2) + '\n')
+    save_meta()
+    client = ASTFClient(server=a.server)
+    connected = False
+    start_requested = False
+    completed = False
+    previous_stretch = None
+    restore_stretch = False
+    origin = time.monotonic()
+    sample_id = 0
+    capture = None
+    last_stats = {}
+    traffic_elapsed = None
+    last_xstats_time = float('-inf')
+    ports = []
+    try:
+        with (out / 'stats.csv').open('w', newline='') as cf, (out / 'stats.jsonl').open('w') as jf:
+            writer = csv.writer(cf)
+            writer.writerow(['sample', 'utc', 'elapsed_s', 'rpc_s', 'phase', 'profile_state', 'metric', 'value_json'])
+            def sample(phase):
+                nonlocal sample_id, last_stats, last_xstats_time
+                begin = time.monotonic()
+                utc = datetime.datetime.now(datetime.timezone.utc).isoformat()
+                stats = client.get_stats(sync_now=True, skip_zero=False, pid_input=pid)
+                try:
+                    stats['utilization'] = client.get_util_stats()
+                except Exception as exc:
+                    stats['utilization'] = {'unavailable': str(exc)}
+                if phase in ('baseline', 'final') or begin-last_xstats_time >= a.server_interval:
+                    stats['template_groups'] = {}
+                    try:
+                        for name in client.get_tg_names(pid_input=pid):
+                            stats['template_groups'][name] = client.get_traffic_tg_stats(name, skip_zero=False, pid_input=pid)
+                    except Exception as exc:
+                        stats['template_groups']['unavailable'] = str(exc)
+                    stats['xstats'] = {}
+                    for port in ports:
+                        try:
+                            stats['xstats'][str(port)] = client.get_xstats(port)
+                        except Exception as exc:
+                            stats['xstats'][str(port)] = {'unavailable': str(exc)}
+                    last_xstats_time = begin
+                last_stats = stats
+                end = time.monotonic()
+                state = client.get_profiles_state().get(pid, 'MISSING')
+                header = [sample_id, utc, begin-origin, end-begin, phase, state]
+                for key, value in leaves(stats):
+                    writer.writerow(header + [key, json.dumps(value, ensure_ascii=False)])
+                jf.write(json.dumps(dict(sample=sample_id, utc=utc, elapsed_s=begin-origin,
+                                         rpc_s=end-begin, phase=phase, profile_state=state,
+                                         stats=stats), ensure_ascii=False) + '\n')
+                cf.flush()
+                jf.flush()
+                sample_id += 1
+                return state
+            client.connect()
+            connected = True
+            client.acquire(force=False)
+            states = client.get_profiles_state()
+            if any(s not in ('STATE_IDLE', 'STATE_ASTF_LOADED') for s in states.values()):
+                raise RuntimeError('Another profile is active; stop it before this measurement')
+            ports = client.get_all_ports()
+            try:
+                (out / 'trex-system.json').write_text(json.dumps(dict(
+                    version=client.get_server_version(), system=client.get_server_system_info(), ports=client.get_port_info()), indent=2) + '\n')
+            except Exception as exc:
+                meta['system_info_error'] = str(exc)
+            if not a.no_server_diagnostics:
+                from server_capture import Capture
+                capture = Capture(out, a.server, a.trex_pid, a.server_interval)
+                capture.prepare()
+                cert = '/tmp/trex-cert.pem'
+                for i, option in enumerate(a.tunables):
+                    if option == '--cert' and i+1 < len(a.tunables):
+                        cert = a.tunables[i+1]
+                    elif option.startswith('--cert='):
+                        cert = option.split('=', 1)[1]
+                if '--cert' in a.tunables or any(x.startswith('--cert=') for x in a.tunables):
+                    capture.command('certificate', ['openssl','x509','-in',cert,'-noout','-text'])
+                meta['diagnostics_pid'] = capture.pid
+            meta['global_cfg_before'] = client.get_global_cfg()
+            if a.sched_max_stretch_ms is not None:
+                previous_stretch = meta['global_cfg_before']['sched_max_stretch']
+                restore_stretch = True
+                # RPC stores this double directly; scheduler compares seconds.
+                # The 'usec' label in the upstream Python docstring is wrong.
+                client.set_global_cfg({'sched_max_stretch': a.sched_max_stretch_ms / 1000.0})
+            meta['global_cfg_effective'] = client.get_global_cfg()
+            save_meta()
+            client.load_profile(str(profile), tunables={'tunables': a.tunables}, pid_input=pid)
+            # Do not reset global/port counters. Use baseline deltas for those.
+            origin = time.monotonic()
+            sample('baseline')
+            origin = time.monotonic()
+            if capture:
+                capture.start(origin)
+            meta['status'] = 'running'
+            start_requested = True
+            save_meta()
+            client.start(mult=a.mult, duration=a.duration, nc=False, pid_input=pid)
+            meta['start_rpc_s'] = time.monotonic()-origin
+            save_meta()
+            while True:
+                tick = time.monotonic()
+                state = sample('scheduled' if tick-origin < a.duration else 'after_duration')
+                if state == 'STATE_ASTF_LOADED':
+                    sample('final')
+                    completed = True
+                    break
+                if state not in ('STATE_TX', 'STATE_ASTF_CLEANUP', 'STATE_ASTF_BUILD', 'STATE_ASTF_PARSE'):
+                    raise RuntimeError('Unexpected profile state: ' + state)
+                time.sleep(max(0, a.interval-(time.monotonic()-tick)))
+            traffic_elapsed = time.monotonic()-origin
+            meta['status'] = 'completed'
+    except BaseException as exc:
+        meta['status'] = 'interrupted' if isinstance(exc, KeyboardInterrupt) else 'error'
+        meta['error'] = repr(exc)
+        raise
+    finally:
+        if capture:
+            try:
+                meta['diagnostics_status'] = capture.finish()
+            except Exception as exc:
+                meta['diagnostics_error'] = repr(exc)
+        if connected:
+            if start_requested and not completed:
+                try:
+                    client.stop(block=False, pid_input=pid)
+                except Exception as exc:
+                    meta['stop_error'] = repr(exc)
+            if restore_stretch:
+                try:
+                    client.set_global_cfg({'sched_max_stretch': previous_stretch})
+                    meta['global_cfg_restored'] = client.get_global_cfg()
+                except Exception as exc:
+                    meta['restore_error'] = repr(exc)
+            if completed:
+                try:
+                    client.clear_profile(block=True, pid_input=pid)
+                except Exception as exc:
+                    meta['clear_profile_error'] = repr(exc)
+            try:
+                client.disconnect()
+            except Exception as exc:
+                meta['disconnect_error'] = repr(exc)
+        meta['elapsed_s'] = traffic_elapsed if traffic_elapsed is not None else time.monotonic()-origin
+        meta['including_cleanup_s'] = time.monotonic()-origin
+        meta['collector_mode'] = 'text-only-no-perf'
+        meta['samples'] = sample_id
+        save_meta()
+        (out / 'summary.txt').write_text(
+            'ASTF NIC diagnostics (text only; no perf)\n'
+            'elapsed_s includes start RPC and polling, excludes successful post-run collection.\n'
+            'Raw CPU counters include busy polling; use TRex CPU and scheduler deltas too.\n'
+            'All samples: stats.csv, stats.jsonl and server/samples.jsonl (UTF-8 text).\n'
+            'No function-level cycles, call stacks or negotiated cipher timing are measured.\n\n'
+            + json.dumps(meta, indent=2, ensure_ascii=False) + '\n\nFinal TRex metrics:\n'
+            + json.dumps(last_stats, indent=2, ensure_ascii=False) + '\n')
+        try:
+            with zipfile.ZipFile(archive, 'x', zipfile.ZIP_DEFLATED) as z:
+                for f in sorted(out.rglob('*')):
+                    if f.is_file() and not f.is_symlink():
+                        z.write(f, str(Path(out.name) / f.relative_to(out)))
+            print('Text logs archive: ' + str(archive.resolve()))
+        except Exception as exc:
+            meta['archive_error'] = repr(exc)
+            save_meta()
+            print('Archive failed; raw logs retained: ' + str(exc))
+        print('Logs: ' + str(out.resolve()))
+
+
+if __name__ == '__main__':
+    main()
