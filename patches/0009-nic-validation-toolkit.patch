+#!/usr/bin/env python3
+"""Run NIC validation sequentially; collect text logs until natural completion."""
+import argparse
+import datetime
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import signal
+import statistics
+import subprocess
+import sys
+import zipfile
+
+HERE = Path(__file__).resolve().parent
+CASES = ('tls12', 'tls13', 'h2', 'h2tls12', 'h2tls13', 'udp')
+
+def certificates():
+    directory = HERE / 'certs'
+    directory.mkdir(mode=0o700, exist_ok=True)
+    cert, key = directory/'server.pem', directory/'server.key'
+    if cert.exists() or key.exists():
+        if not (cert.is_file() and key.is_file()):
+            raise RuntimeError('Incomplete certs directory; preserve/move it before retrying')
+        subprocess.run(['openssl','x509','-in',str(cert),'-noout','-checkend','3600'], check=True)
+    else:
+        old = os.umask(0o077)
+        try:
+            subprocess.run(['openssl','req','-x509','-newkey','ec','-pkeyopt','ec_paramgen_curve:P-256',
+                '-nodes','-keyout',str(key),'-out',str(cert),'-days','30','-subj','/CN=trex.local',
+                '-addext','subjectAltName=DNS:trex.local'], check=True)
+        finally:
+            os.umask(old)
+    return cert, key
+
+def summarize(path):
+    meta = json.loads((path/'metadata.json').read_text())
+    cpus, rpc, final = [], [], {}
+    with (path/'stats.jsonl').open() as f:
+        for line in f:
+            row = json.loads(line); final = row['stats']
+            rpc.append(row['rpc_s'])
+            if 0.1*meta['duration'] <= row['elapsed_s'] <= meta['duration']:
+                value = final.get('global',{}).get('cpu_util')
+                if isinstance(value,(float,int)): cpus.append(value)
+    result = dict(status=meta['status'], mult=meta['mult'], requested_duration_s=meta['duration'],
+        elapsed_s=meta['elapsed_s'], after_requested_duration_s=max(0,meta['elapsed_s']-meta['duration']),
+        cpu_mean=statistics.mean(cpus) if cpus else None, cpu_max=max(cpus) if cpus else None,
+        max_sample_rpc_s=max(rpc) if rpc else None, final_traffic=final.get('traffic',{}))
+    result['notes'] = []
+    result['nonzero_error_counters'] = {
+        side: {k:v for k,v in values.items() if isinstance(v,(int,float)) and v and
+               (k.endswith(('_errors','_timeouts','_aborted')) or k.startswith('tcps_tls_err_'))}
+        for side,values in result['final_traffic'].items() if isinstance(values,dict)}
+    if any(result['nonzero_error_counters'].values()):
+        result['notes'].append('Nonzero protocol/error counters; inspect final_traffic and time series.')
+    if result['cpu_max'] is not None and result['cpu_max']>=80:
+        result['notes'].append('CPU reached 80%; do not increase this workload before analysis.')
+    if result['after_requested_duration_s']>10:
+        result['notes'].append('Completion exceeded requested duration by >10s; inspect scheduling and flow cleanup.')
+    if result['max_sample_rpc_s'] is not None and result['max_sample_rpc_s']>meta['interval']:
+        result['notes'].append('Stats RPC exceeded sampling interval; timestamps record the actual cadence.')
+    (path/'result.json').write_text(json.dumps(result,indent=2)+'\n')
+    return result
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--cases', nargs='+', choices=CASES, default=list(CASES))
+    p.add_argument('--smoke', action='store_true', help='10s per case at 100 CPS / UDP 1000 flows/s')
+    p.add_argument('--duration', type=float, help='Override 300s, or 10s for --smoke')
+    p.add_argument('--mult', type=float, help='Override offered flows/s; valid for one selected case only')
+    p.add_argument('--frame-size', type=int, choices=(64,570,1518), default=570)
+    p.add_argument('--trex-pid', type=int)
+    p.add_argument('--output', default='nic-validation-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S'))
+    p.add_argument('--plan', action='store_true', help='Print plan only; no RPC, cert generation or files')
+    a=p.parse_args()
+    if len(set(a.cases))!=len(a.cases): p.error('duplicate cases')
+    if a.mult is not None and (len(a.cases)!=1 or not math.isfinite(a.mult) or a.mult<=0):
+        p.error('--mult requires one case and a finite positive value')
+    duration=a.duration if a.duration is not None else (10 if a.smoke else 300)
+    if not math.isfinite(duration) or duration<=0: p.error('duration must be positive and finite')
+    plan=[dict(case=c, mult=a.mult if a.mult is not None else ((1000 if a.smoke else 100000) if c=='udp' else (100 if a.smoke else 30000)), duration_s=duration, requests=10,
+               **({'frame_size_with_fcs':a.frame_size} if c=='udp' else {'body_size':16384,'concurrency':4 if c.startswith('h2') else 1})) for c in a.cases]
+    print(json.dumps(plan,indent=2),flush=True)
+    if a.plan:return
+    # API discovery fails before traffic or output creation; no pip dependency.
+    from collect import ensure_trex_api
+    ensure_trex_api()
+    out=Path(a.output).resolve(); archive=out.with_name(out.name+'.zip')
+    if out.exists() or archive.exists():p.error('output or ZIP already exists; choose a new --output')
+    cert=key=None
+    if any(c not in ('h2','udp') for c in a.cases):cert,key=certificates()
+    out.mkdir(parents=True)
+    (out/'plan.json').write_text(json.dumps(plan,indent=2)+'\n')
+    source=out/'collector_source';source.mkdir()
+    for name in ('run.py','collect.py','server_capture.py','nic_profile.py'):
+        (source/name).write_bytes((HERE/name).read_bytes())
+    results={}
+    try:
+        for case in plan:
+            name=case['case']; target=out/name
+            cmd=[sys.executable,str(HERE/'collect.py'),'--profile',str(HERE/'nic_profile.py'),
+                 '--mult',str(case['mult']),'--duration',str(duration),'--interval','1','--server-interval','5','--output',str(target)]
+            if a.trex_pid is not None:cmd+=['--trex-pid',str(a.trex_pid)]
+            cmd+=['--tunables','--case',name,'--frame-size',str(a.frame_size)]
+            if name not in ('h2','udp'):cmd+=['--cert',str(cert),'--key',str(key),'--ca',str(cert)]
+            print('Starting %s: mult=%s duration=%ss; log: %s' % (name,case['mult'],duration,out/(name+'-console.txt')),flush=True)
+            with (out/(name+'-console.txt')).open('w') as log:
+                child=subprocess.Popen(cmd,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
+                try: rc=child.wait()
+                except KeyboardInterrupt:
+                    if child.poll() is None: child.send_signal(signal.SIGINT)
+                    child.wait()
+                    raise
+            if (target/'metadata.json').exists():
+                try: results[name]=summarize(target)
+                except Exception as exc: results[name]={'summary_error':str(exc)}
+            if rc: raise RuntimeError('%s failed (exit %s); see %s' % (name,rc,out/(name+'-console.txt')))
+            if 'summary_error' in results.get(name,{}): raise RuntimeError(results[name]['summary_error'])
+            c=results[name]['final_traffic'].get('client',{})
+            checks={'no_protocol_errors':not any(results[name]['nonzero_error_counters'].values())}
+            if name=='udp':
+                checks.update(rtt_samples=c.get('udps_rtt_count',0)>0, tcp_latency_unused=c.get('tcps_ttfb_count',0)==0 and c.get('tcps_ttlb_count',0)==0)
+            else:
+                checks.update(latency_samples=c.get('tcps_ttfb_count',0)>0 and c.get('tcps_ttlb_count',0)>0)
+                if name!='h2': checks.update(full_handshakes=c.get('tcps_tls_handshakes',0)>0 and c.get('tcps_tls_resumed',0)==0)
+            results[name]['checks']=checks
+            (target/'result.json').write_text(json.dumps(results[name],indent=2)+'\n')
+            if a.smoke and not all(checks.values()):
+                raise RuntimeError('Smoke validation failed for '+name+': '+str(checks))
+            print('Finished %s: elapsed %.2fs; CPU mean=%s max=%s' %
+                  (name,results[name]['elapsed_s'],results[name]['cpu_mean'],results[name]['cpu_max']),flush=True)
+    finally:
+        (out/'results.json').write_text(json.dumps(results,indent=2)+'\n')
+        # Only generated text logs/source; certificates/private keys stay in HERE/certs.
+        with zipfile.ZipFile(archive,'x',zipfile.ZIP_DEFLATED) as z:
+            for file in sorted(out.rglob('*')):
+                if file.is_file() and not file.is_symlink() and file.suffix!='.zip':
+                    z.write(file,str(Path(out.name)/file.relative_to(out)))
+        print('Send this archive: '+str(archive),flush=True)
+
+if __name__=='__main__':
+    main()
