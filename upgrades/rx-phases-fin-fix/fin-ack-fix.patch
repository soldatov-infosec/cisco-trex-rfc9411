diff --git a/src/44bsd/netinet/tcp_output.c b/src/44bsd/netinet/tcp_output.c
--- a/src/44bsd/netinet/tcp_output.c
+++ b/src/44bsd/netinet/tcp_output.c
@@ -369,6 +369,17 @@
             flags &= ~TH_FIN;
     }
 
+    /* TLS may acknowledge close_notify before its peer's close_notify arrives.
+     * Once our FIN is in flight, acknowledging that later input must not resend
+     * the FIN just because the state still contains TH_FIN. A real retransmit
+     * rewinds snd_nxt below snd_max, and therefore retains the FIN here.
+     * Keep the legacy behavior for applications outside the TLS adapter.
+     */
+    if (!len && !sack_rxmit && (flags & TH_FIN) &&
+        (tp->t_flags & TF_SENTFIN) && tp->snd_nxt == tp->snd_max &&
+        so_is_tls(so))
+        flags &= ~TH_FIN;
+
     recwin = lmin(lmax(sbspace(&so->so_rcv), 0),
         (long)TCP_MAXWIN << tp->rcv_scale);
 
