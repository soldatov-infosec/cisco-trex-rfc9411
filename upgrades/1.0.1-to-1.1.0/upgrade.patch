diff --git a/tests/tls/http_message_test.cpp b/tests/tls/http_message_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tls/http_message_test.cpp
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "44bsd/http/astf_http.h"
+#include <cassert>
+#include <iostream>
+#include <string>
+using namespace astf_http;
+static bool feed(Response &parser,const std::string &s) {
+    return parser.feed(reinterpret_cast<const uint8_t *>(s.data()),s.size());
+}
+static void fragments(const std::string &s,Config cfg,bool valid) {
+    for(size_t split=0;split<=s.size();++split) {
+        Response parser(cfg);
+        bool ok=feed(parser,s.substr(0,split));
+        if(ok) ok=feed(parser,s.substr(split));
+        if(ok) ok=parser.eof();
+        assert(ok==valid);
+    }
+}
+int main() {
+    Config request; request.request=true;
+    const std::string get="GET /index.html HTTP/1.1\r\nHost: localhost\r\nX-Inspection: added\r\n\r\n";
+    const std::string post="POST /upload HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello";
+    const std::string chunks="POST /upload HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nhe\r\n3\r\nllo\r\n0\r\nX-End: yes\r\n\r\n";
+    fragments(get,request,true); fragments(post,request,true); fragments(chunks,request,true);
+    request.expected_body_bytes=5;
+    fragments(post,request,true); fragments(chunks,request,true); fragments(get,request,false);
+    request.expected_body_bytes=-1;
+    for(const auto &s : {"GET  HTTP/1.1\r\n\r\n", "GET / HTTP/2.0\r\n\r\n",
+        "CONNECT host:443 HTTP/1.1\r\n\r\n", "GET / HTTP/1.1\r\nUpgrade: websocket\r\n\r\n",
+        "POST / HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: 5\r\n\r\nhello",
+        "POST / HTTP/1.1\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n",
+        "POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhell"}) fragments(s,request,false);
+    request.responses=2;
+    // A single input buffer contains two requests: do not consume the next one.
+    Response parser(request); size_t used=999;
+    const auto both=get+post;
+    assert(parser.feed((const uint8_t*)both.data(),both.size(),used,true));
+    assert(used==get.size() && parser.completed()==1);
+    size_t rest=0;
+    assert(parser.feed((const uint8_t*)both.data()+used,both.size()-used,rest,true));
+    assert(rest==post.size() && parser.done() && parser.eof());
+    // Completion at a fragment boundary must not consume a suffix.
+    for(size_t split=0;split<get.size();++split) {
+        Response p(request); assert(feed(p,get.substr(0,split)));
+        size_t n=0; assert(p.feed((const uint8_t*)both.data()+split,both.size()-split,n,true));
+        assert(n==get.size()-split && p.completed()==1);
+    }
+    Config response; response.head_response=true;
+    fragments("HTTP/1.1 200 OK\r\nContent-Length: 123\r\n\r\n",response,true);
+    response.max_body_bytes=0; response.expected_body_bytes=0;
+    fragments("HTTP/1.1 200 OK\r\nContent-Length: 123\r\n\r\n",response,true);
+    response.head_response=false; response.expected_status=304;
+    fragments("HTTP/1.1 304 Not Modified\r\nContent-Length: 123\r\n\r\n",response,true);
+    fragments("HTTP/1.1 304 Not Modified\r\nTransfer-Encoding: chunked\r\n\r\n",response,true);
+    response.expected_status=204;
+    fragments("HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n",response,false);
+    response.expected_status=200; response.max_body_bytes=1073741824;
+    response.head_response=false; response.expected_body_bytes=5;
+    fragments("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello",response,true);
+    fragments("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n",response,true);
+    fragments("HTTP/1.0 200 OK\r\n\r\nhello",response,true);
+    fragments("HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nhell",response,false);
+    response.expected_body_bytes=-1; response.max_body_bytes=5;
+    fragments("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n3\r\nlo!\r\n0\r\n\r\n",response,false);
+    // Chunk extensions may contain BWS and quoted delimiters, but not malformed syntax.
+    response.max_body_bytes=100;
+    const std::string head="HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n";
+    for (const auto &extension : {";a", ";a=b", " ; a = \"b;\\\"c\" ; flag", ";a=\"\""})
+        fragments(head+"5"+extension+"\r\nhello\r\n0;done\r\n\r\n",response,true);
+    for (const auto &extension : {";", ";=x", ";a=", ";a=\"unterminated", ";a=\"x\"junk", " xyz", ";a=()"})
+        fragments(head+"5"+extension+"\r\nhello\r\n0\r\n\r\n",response,false);
+    // Close-delimited input consumes the complete buffer, but completes at EOF.
+    Response close(response); const std::string wire="HTTP/1.0 200 OK\r\n\r\nhello";
+    assert(close.feed((const uint8_t*)wire.data(),wire.size(),used,true));
+    assert(used==wire.size() && !close.done() && close.eof());
+    std::cout << "HTTP message boundaries, requests, HEAD, exact body size and split points: PASS\n";
+}
