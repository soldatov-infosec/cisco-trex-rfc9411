+++ b/scripts/astf/http_messages.py
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: Apache-2.0
+"""HTTP/1.1 message receives, over plaintext TCP or native TLS."""
+import argparse
+from pathlib import Path
+from trex.astf.api import (ASTFProgram, ASTFIPGen, ASTFIPGenDist, ASTFIPGenGlobal,
+                          ASTFTCPClientTemplate, ASTFTCPServerTemplate,
+                          ASTFAssociationRule, ASTFTemplate, ASTFProfile)
+
+
+class Profile:
+    def get_profile(self, tunables, **kwargs):
+        p = argparse.ArgumentParser(description=__doc__)
+        p.add_argument('--requests', type=int, default=10)
+        p.add_argument('--body-size', type=int, default=16384)
+        p.add_argument('--timeout-ms', type=int, default=30000)
+        p.add_argument('--chunked', action='store_true')
+        p.add_argument('--tls', action='store_true')
+        p.add_argument('--authority', default='localhost')
+        for name in ('cert', 'key', 'ca'):
+            p.add_argument('--' + name)
+        a = p.parse_args(tunables)
+        if not 1 <= a.requests <= 1000000 or not 1 <= a.body_size <= 1048576:
+            p.error('requests must be 1..1000000 and body-size 1..1048576')
+        if not 1 <= a.timeout_ms <= 600000:
+            p.error('timeout-ms must be 1..600000')
+        if not a.authority or len(a.authority) > 253 or any(
+                c not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-' for c in a.authority):
+            p.error('authority must be a DNS name or IPv4 address')
+        client_tls = server_tls = None
+        if a.tls:
+            for name in ('cert', 'key', 'ca'):
+                value = getattr(a, name)
+                if not value or not Path(value).expanduser().is_file():
+                    p.error('--tls requires existing --cert, --key and --ca files')
+                setattr(a, name, str(Path(value).expanduser().resolve()))
+            client_tls = dict(version='1.3', sni=a.authority, ca=a.ca, verify=True)
+            server_tls = dict(version='1.3', cert=a.cert, key=a.key)
+        elif any(getattr(a, name) for name in ('cert', 'key', 'ca')):
+            p.error('certificate options require --tls')
+
+        client = ASTFProgram(tls=client_tls, http=dict(responses=a.requests,
+            transactions=True, expected_status=200, expected_body_bytes=a.body_size,
+            max_body_bytes=a.body_size, body_contains='x'))
+        server = ASTFProgram(side='s', tls=server_tls, http=dict(requests=a.requests))
+        request = ('GET / HTTP/1.1\r\nHost: %s\r\nAccept: */*\r\n\r\n' % a.authority).encode('ascii')
+        body = b'x' * a.body_size
+        if a.chunked:
+            response = (b'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n' +
+                        ('%x;source=trex\r\n' % a.body_size).encode('ascii') + body +
+                        b'\r\n0\r\nX-Complete: yes\r\n\r\n')
+        else:
+            response = ('HTTP/1.1 200 OK\r\nContent-Length: %d\r\n\r\n' % a.body_size).encode('ascii') + body
+        for program in (client, server):
+            program.set_var('remaining', a.requests)
+            program.set_label('exchange')
+        client.http_request_start()
+        client.send(request)
+        client.recv_http_response(a.timeout_ms)
+        client.jmp_nz('remaining', 'exchange')
+        server.recv_http_request(a.timeout_ms)
+        server.send(response)
+        server.jmp_nz('remaining', 'exchange')
+        server.wait_for_peer_close()
+        ip = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset='1.0.0.0'),
+            dist_client=ASTFIPGenDist(ip_range=['16.0.0.1', '16.0.255.199'], distribution='seq'),
+            dist_server=ASTFIPGenDist(ip_range=['48.0.0.1', '48.0.255.199'], distribution='seq'))
+        port = 443 if a.tls else 80
+        template = ASTFTemplate(
+            client_template=ASTFTCPClientTemplate(program=client, ip_gen=ip, cps=1, port=port),
+            server_template=ASTFTCPServerTemplate(program=server, assoc=ASTFAssociationRule(port=port)))
+        return ASTFProfile(default_ip_gen=ip, templates=template)
+
+
+def register():
+    return Profile()
