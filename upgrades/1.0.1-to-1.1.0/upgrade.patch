+++ b/tests/tls/http_message_live.py
@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Live HTTP message receive lifecycle checks on a dedicated veth TRex instance."""
+import argparse
+import time
+import uuid
+from trex.astf.api import (ASTFClient, ASTFProgram, ASTFProfile, ASTFTemplate,
+    ASTFTCPClientTemplate, ASTFTCPServerTemplate, ASTFAssociationRule,
+    ASTFIPGen, ASTFIPGenGlobal, ASTFIPGenDist)
+from interactive_lifecycle import remove_profile
+
+
+def profile(args, version, stage, port):
+    c_tls = dict(version=version, ca=args.cert, sni='localhost', verify=True) if version else None
+    s_tls = dict(version=version, cert=args.cert, key=args.key) if version else None
+    count = 3 if stage in ('fixed', 'chunked') else 1
+    c = ASTFProgram(tls=c_tls, http=dict(responses=count, transactions=True,
+        expected_status=200, expected_body_bytes=2, body_contains='OK'))
+    s = ASTFProgram(side='s', tls=s_tls, http=dict(requests=count))
+    request = b'GET / HTTP/1.1\r\nHost: localhost\r\nX-Inspection: rewritten\r\n\r\n'
+    response = b'HTTP/1.1 200 OK\r\nX-Inspection: added\r\nContent-Length: 2\r\n\r\nOK'
+    if stage == 'chunked':
+        response = b'HTTP/1.1 103 Early Hints\r\n\r\nHTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1; x="y"\r\nO\r\n1\r\nK\r\n0\r\nX-End: yes\r\n\r\n'
+    if stage == 'blocked':
+        response = b'HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nNO'
+    if stage in ('request_wait', 'survivor'):
+        c.delay(1000000000 if stage == 'survivor' else 30000000)
+    for _ in range(count):
+        c.http_request_start(); c.send(request)
+        c.recv_http_response(100 if stage == 'timeout' else 60000)
+        s.recv_http_request(1200000)
+        if stage in ('response_wait', 'timeout'):
+            s.delay(30000000 if stage == 'response_wait' else 2000000)
+        s.send(response)
+    s.wait_for_peer_close()
+    ip = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset='1.0.0.0'),
+        dist_client=ASTFIPGenDist(ip_range=['16.0.0.1','16.0.0.254'],distribution='seq'),
+        dist_server=ASTFIPGenDist(ip_range=['48.0.0.1','48.0.0.254'],distribution='seq'))
+    return ASTFProfile(default_ip_gen=ip,templates=ASTFTemplate(
+        client_template=ASTFTCPClientTemplate(program=c,ip_gen=ip,port=port,cps=1),
+        server_template=ASTFTCPServerTemplate(program=s,assoc=ASTFAssociationRule(port=port))))
+
+
+def wait_active(client, pid, tls):
+    until=time.monotonic()+15
+    while time.monotonic()<until:
+        stats=client.get_traffic_stats(skip_zero=False,pid_input=pid)
+        if all(stats[side]['m_est_flows']>0 and
+               (not tls or stats[side]['tcps_tls_handshakes']>0) for side in ('client','server')):
+            return
+        time.sleep(.05)
+    raise AssertionError('No established test flow: '+pid)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--cert',required=True);p.add_argument('--key',required=True)
+    p.add_argument('--server',default='localhost');p.add_argument('--iterations',type=int,default=2)
+    args=p.parse_args()
+    if not 1<=args.iterations<=100:p.error('iterations must be 1..100')
+    client=ASTFClient(server=args.server,sync_timeout=15,async_timeout=15)
+    pid='http_message_'+uuid.uuid4().hex[:8];keep=pid+'_keep';owned=set()
+    client.connect()
+    try:
+        client.acquire()
+        client.load_profile(profile(args,'','survivor',444),pid_input=keep);owned.add(keep)
+        client.start(mult=1,pid_input=keep);wait_active(client,keep,False)
+        for version in ('','1.2','1.3'):
+            for iteration in range(args.iterations):
+                for stage in ('request_wait','response_wait'):
+                    client.load_profile(profile(args,version,stage,443),pid_input=pid);owned.add(pid)
+                    client.start(mult=1,pid_input=pid);wait_active(client,pid,bool(version))
+                    client.stop(pid_input=pid)
+                    stats=client.get_traffic_stats(skip_zero=False,pid_input=pid)
+                    assert all(stats[s]['m_active_flows']==0 for s in ('client','server')),stats
+                    remove_profile(client,pid);owned.remove(pid)
+                    survivor=client.get_traffic_stats(skip_zero=False,pid_input=keep)
+                    assert survivor['client']['m_active_flows']>0,survivor
+                    print(version or 'TCP',iteration,stage,'stop/remove; survivor active: PASS',flush=True)
+            for stage in ('fixed','chunked','blocked','timeout'):
+                client.load_profile(profile(args,version,stage,443),pid_input=pid);owned.add(pid)
+                client.start(mult=3,duration=1,pid_input=pid)
+                client.wait_on_traffic(timeout=30,profile_id=pid)
+                stats=client.get_traffic_stats(skip_zero=False,pid_input=pid);c=stats['client'];s=stats['server']
+                assert c['m_active_flows']==s['m_active_flows']==0,stats
+                if stage in ('fixed','chunked'):
+                    assert c['tcps_connects']>0,c
+                    assert c['tcps_http_responses']==c['tcps_connects']*3,c
+                    assert c['tcps_http_req_ttlb_count']==c['tcps_http_responses'],c
+                    assert c['tcps_http_errors']==s['tcps_http_errors']==0,stats
+                    assert c['tcps_http_timeouts']==s['tcps_http_timeouts']==0,stats
+                    assert c['tcps_http_aborted']==s['tcps_http_aborted']==0,stats
+                else:
+                    key='tcps_http_bad_content' if stage=='blocked' else 'tcps_http_timeouts'
+                    assert c[key]>0,c
+                    assert c['tcps_http_responses']==c['tcps_http_req_ttlb_count']==0,c
+                print(version or 'TCP',stage,'RPC counters and completion: PASS',flush=True)
+                remove_profile(client,pid);owned.remove(pid)
+    finally:
+        try:
+            for current in list(owned):
+                if current in client.get_profiles():
+                    client.stop(pid_input=current);remove_profile(client,current)
+        finally:client.disconnect()
+
+
+if __name__=='__main__':main()
