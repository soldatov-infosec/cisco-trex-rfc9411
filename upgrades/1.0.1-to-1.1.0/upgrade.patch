@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+// Parser-only microbenchmark; this does not measure TLS, TCP or NIC throughput.
+#include "44bsd/http/astf_http.h"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <algorithm>
+int main(int argc,char **argv) {
+    unsigned flows=argc>1?std::strtoul(argv[1],nullptr,10):100000;
+    const std::string response="HTTP/1.1 200 OK\r\nContent-Length: 16384\r\nContent-Type: text/html\r\n\r\n"+std::string(16384,'x');
+    for(unsigned count:{1u,10u}) {
+        astf_http::Config c;c.responses=count;c.body_contains="x";
+        auto begin=std::chrono::steady_clock::now();
+        size_t completed=0;
+        for(unsigned i=0;i<flows;++i) {
+            astf_http::Response parser(c);
+            for(unsigned j=0;j<count;++j) {
+                for(size_t off=0;off<response.size();off+=1460) {
+                    if(!parser.feed((const uint8_t*)response.data()+off,std::min<size_t>(1460,response.size()-off)))return 1;
+                }
+            }
+            if(!parser.eof())return 2;
+            completed+=parser.completed();
+        }
+        auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-begin).count();
+        std::printf("responses_per_flow=%u flows=%u completed=%zu ns_per_flow=%.1f parser_object_bytes=%zu\n",count,flows,completed,double(ns)/flows,sizeof(astf_http::Response));
+    }
+}
