+        printf("CLOSEDELAY TLS=%s dir=%d gap=%g wrap=%d delay_fin=%d injected=%d FIN=%u/%u dup=%llu/%llu bytes=%llu/%llu\n",version,dir,gap,wrap,fin,delay.injected,delay.fins[0],delay.fins[1],(unsigned long long)c.tcps_rcvduppack,(unsigned long long)s.tcps_rcvduppack,(unsigned long long)c.tcps_rcvdupbyte,(unsigned long long)s.tcps_rcvdupbyte);
