+bool CFlowTable::defer_tls_ack(CTcpCb *tp) {
+    if (!m_ack_batch_active) return false;
+    // Do not collapse a whole receive flight into one ACK. Large GRO/LRO
+    // deliveries bypass batching, and a second ACK opportunity with new data
+    // flushes the first. With the normal ACK-every-two-segments policy this
+    // limits aggregation to approximately four wire segments.
+#ifdef TREX_SIM
+    const bool bounded=tls_rx_test_mode!=1 && tls_rx_test_mode!=3;
+#else
+    const bool bounded=true;
+#endif
+    const uint32_t unacked = uint32_t(tp->rcv_nxt - tp->last_ack_sent);
+    if (bounded && (!tp->t_maxseg || unacked >= uint64_t(tp->t_maxseg) * 4)) {
+        cancel_tls_ack(tp);
+        return false;
+    }
+    if (tp->m_ack_batch_slot) {
+        if(!bounded)return true;
+        const unsigned slot = tp->m_ack_batch_slot - 1;
+        if (m_ack_batch_seq[slot] == tp->rcv_nxt) return true;
+        cancel_tls_ack(tp);
+        return false;
+    }
+    if (m_ack_batch_used == 64) return false;
+    m_ack_batch_seq[m_ack_batch_used] = tp->rcv_nxt;
+    m_ack_batch[m_ack_batch_used++] = tp;
+    tp->m_ack_batch_slot = m_ack_batch_used;
+    return true;
+}
+void CFlowTable::cancel_tls_ack(CTcpCb *tp) {
+    if(tp->m_ack_batch_slot) {
+        m_ack_batch[tp->m_ack_batch_slot-1]=nullptr;tp->m_ack_batch_slot=0;
+    }
+}
+void CFlowTable::end_rx_ack_batch(CTcpPerThreadCtx *ctx) {
+    m_ack_batch_active=false;
+    for(unsigned i=0;i<m_ack_batch_used;++i) {
+        auto tp=m_ack_batch[i];m_ack_batch[i]=nullptr;
+        if(!tp)continue;
+        tp->m_ack_batch_slot=0;
+        // Application data may already have piggybacked the cumulative ACK.
+        if(tp->t_state==TCPS_ESTABLISHED && (tp->t_flags&TF_ACKNOW))tcp_output(tp);
+    }
+    m_ack_batch_used=0;
+    // Submit the transport output before running expensive application work.
+    if(ctx && m_tls_batch_used)ctx->m_cb->on_flush_tx();
+    m_tls_batch_active=false;
+    for(unsigned i=0;i<m_tls_batch_used;++i) {
+        auto tp=m_tls_batch[i];m_tls_batch[i]=nullptr;
+        if(!tp)continue;
+        tp->m_tls_batch_slot=0;
+        // The callback may close and delete this flow; do not access tp afterwards.
+        tp->m_flow->m_app.tls_run_deferred();
+    }
+    m_tls_batch_used=0;
+}
+bool CFlowTable::defer_tls_work(CTcpCb *tp) {
+    if(!m_tls_batch_active)return false;
+    if(tp->m_tls_batch_slot)return true;
+    // Capacity exhaustion falls back to immediate service, never drops data.
+    if(m_tls_batch_used==64)return false;
+    m_tls_batch[m_tls_batch_used++]=tp;tp->m_tls_batch_slot=m_tls_batch_used;
+    return true;
+}
+void CFlowTable::cancel_tls_work(CTcpCb *tp) {
+    if(tp->m_tls_batch_slot) {
+        m_tls_batch[tp->m_tls_batch_slot-1]=nullptr;tp->m_tls_batch_slot=0;
+    }
+}
