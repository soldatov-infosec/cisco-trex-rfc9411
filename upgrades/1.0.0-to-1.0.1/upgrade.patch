+class TlsCloseServiceDelay : public CTxRxCallback {
+public:
+    CClientServerTcp &sim;
+    int side;
+    double delay;
+    bool injected = false, delay_fin;
+    unsigned fins[2] = {};
+    TlsCloseServiceDelay(CClientServerTcp &s, int dir, double gap, bool fin):sim(s),side(dir),delay(gap),delay_fin(fin) {}
+    int on_rx(int, rte_mbuf_t *) override {return 0;}
+    int on_tx(int dir, rte_mbuf_t *m) override {
+        auto bytes=rte_pktmbuf_mtod(m,uint8_t *);
+        auto ip=reinterpret_cast<IPHeader *>(bytes+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(bytes+14+ip->getHeaderLength());
+        unsigned len=ip->getTotalLength()-ip->getHeaderLength()-tcp->getHeaderLength();
+        if(tcp->getFinFlag()) ++fins[dir];
+        if(!injected && dir==side &&
+           (delay_fin ? tcp->getFinFlag() : (len>0 && len<100)) &&
+           sim.m_c_ctx.get_tcpstat()->m_sts.tcps_http_responses==10) {
+            sim.m_tx_diff+=delay;
+            injected=true;
+        }
+        return 0;
+    }
+};
