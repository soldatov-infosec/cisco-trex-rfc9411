+#ifdef TREX_TLS
+// Exercise the real flow destructor, not only explicit queue cancellation.
+TEST_F(gt_tcp, tls_rx_queues_free_flow) {
+    CFlowTable::tls_rx_test_mode = 2;
+    CClientServerTcp sim;
+    sim.Create("generated", "tls_rx_queues_free_flow");
+    auto &table = sim.m_c_ctx.m_ft;
+    auto pctx = DEFAULT_PROFILE_CTX(&sim.m_c_ctx);
+    const auto initial_count = pctx->m_flow_cnt;
+    for (unsigned burst = 0; burst < 3; ++burst) {
+        table.begin_rx_ack_batch();
+        for (unsigned i = 0; i < 64; ++i) {
+            tunnel_cfg_data_t tunnel_data = {};
+            auto flow = table.alloc_flow(pctx, 0x10000001, 0x30000001,
+                                        1025, 443, tunnel_data, false, nullptr);
+            ASSERT_TRUE(flow != nullptr);
+            auto &tp = flow->m_tcp;
+            tp.t_maxseg = 1440;
+            tp.rcv_nxt = tp.last_ack_sent = 0;
+            EXPECT_TRUE(table.defer_tls_ack(&tp));
+            EXPECT_TRUE(table.defer_tls_work(&tp));
+            // Allocator reuse must not leave a pointer to the destroyed flow
+            // in either queue. Draining such a TLS entry would dereference m_tls.
+            table.free_flow(flow);
+        }
+        table.end_rx_ack_batch();
+        EXPECT_EQ(initial_count, pctx->m_flow_cnt);
+    }
+    sim.close_file();
+    sim.Delete();
+}
