+class TlsLateEmptyAck : public TlsWireFault {
+public:
+    int direction;
+    TlsLateEmptyAck(CClientServerTcp &s,int d):TlsWireFault(s,OVERLAP),direction(d) {}
+    int on_tx(int dir,rte_mbuf_t *m) override {
+        if(injected || dir!=direction || !sim.m_c_ctx.get_tcpstat()->m_sts.tcps_tls_sndbyte)return 0;
+        auto bytes=rte_pktmbuf_mtod(m,uint8_t *);
+        auto ip=reinterpret_cast<IPHeader *>(bytes+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(bytes+14+ip->getHeaderLength());
+        unsigned len=ip->getTotalLength()-ip->getHeaderLength()-tcp->getHeaderLength();
+        if(len || tcp->getFlags()!=TCPHeader::Flag::ACK)return 0;
+        ++injected;
+        deliver(copy(m),dir,sim.m_sim.get_time()+0.00045);
+        return 0;
+    }
+};
+TEST_F(gt_tcp, tls_late_empty_ack) {
+    for(auto version:{"1.2","1.3"})for(int direction:{0,1}) {
+        CClientServerTcp sim;sim.Create("generated","tls_late_empty_ack");
+        sim.m_rx_ack_batch_test=true;sim.m_rx_burst_test=true;
+        sim.m_mss=1440;sim.m_initwnd_factor=10;sim.set_rtt(100);
+        for(auto ctx:{&sim.m_c_ctx,&sim.m_s_ctx}) {
+            ctx->set_offload_dev_flags(OFFLOAD_TX_CHKSUM|OFFLOAD_RX_CHKSUM);
+            auto &t=DEFAULT_PROFILE_CTX(ctx)->m_tunable_ctx;
+            t.tcp_rx_socket_bsize=1048576;t.tcp_tx_socket_bsize=1048576;
+        }
+        TlsLateEmptyAck late(sim,direction);sim.m_callbacks.push_back(&late);
+        sim.tls_http_transactions(version);
+        auto &c=sim.m_c_ctx.get_tcpstat()->m_sts;auto &s=sim.m_s_ctx.get_tcpstat()->m_sts;
+        EXPECT_EQ(1u,late.injected);EXPECT_EQ_UINT32(10,c.tcps_http_responses);
+        EXPECT_EQ_UINT32(0,c.tcps_tls_errors+s.tcps_tls_errors);
+        EXPECT_EQ_UINT32(0,c.tcps_rcvdupbyte+s.tcps_rcvdupbyte);
+        EXPECT_EQ_UINT32(0,c.tcps_sndrexmitpack+s.tcps_sndrexmitpack);
+        EXPECT_GT(c.tcps_rcvduppack+s.tcps_rcvduppack,0u);
+        EXPECT_EQ_UINT32(1,c.tcps_closed);EXPECT_EQ_UINT32(1,s.tcps_closed);
+        printf("LATE_ACK TLS=%s direction=%d duplicate_packets=%llu duplicate_bytes=%llu\n",version,direction,
+            (unsigned long long)(c.tcps_rcvduppack+s.tcps_rcvduppack),
+            (unsigned long long)(c.tcps_rcvdupbyte+s.tcps_rcvdupbyte));
+        sim.m_callbacks.clear();sim.close_file();sim.Delete();
+    }
