+class TlsFinLoss : public CTxRxCallback {
+public:
+    CClientServerTcp &sim;
+    int side;
+    unsigned fins[2] = {}, dropped = 0, resets = 0;
+    TlsFinLoss(CClientServerTcp &s,int dir):sim(s),side(dir) {}
+    int on_rx(int, rte_mbuf_t *) override {return 0;}
+    int on_tx(int dir,rte_mbuf_t *m) override {
+        auto bytes=rte_pktmbuf_mtod(m,uint8_t *);
+        auto ip=reinterpret_cast<IPHeader *>(bytes+14);
+        auto tcp=reinterpret_cast<TCPHeader *>(bytes+14+ip->getHeaderLength());
+        if(tcp->getResetFlag())++resets;
+        if(tcp->getFinFlag()) {
+            ++fins[dir];
+            if(dir==side && !dropped) {sim.m_drop_next_tx_test=true;++dropped;}
+        }
+        return 0;
+    }
+};
